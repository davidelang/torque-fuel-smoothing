# landlock.config — checked in with @@ tokens; smudge from project.config (manage-configs).
# Machine-specific values come from project.config (especially git_home= absolute path).
# Do NOT put secrets here. Local overrides: edit after checkout or adjust project.config + re-checkout.
#
# project.config (gitignored) on this machine must set e.g.:
#   git_home=/absolute/path/to/git   # NOT ~/git — agent $HOME differs
# Use ABSOLUTE paths.
# agent-landlock reads role grants from worktree + this file + project.config.

# Host clone root (absolute after smudge)
git_home=@@GIT_HOME@@

# Default sandbox dirname under worktree (also sandbox_path in project.config)
sandbox_path=@@SANDBOX_PATH@@

# --- always-on mutation (hardcoded in agent-landlock; listed for operators) ---
# /tmp /var/tmp $TMPDIR
# /dev/null /dev/zero /dev/full /dev/urandom /dev/random /dev/tty

# --- role summary (enforced in agent-landlock, not only comments) ---
# planner: sandbox + worktree TODO.md + ENGINEERING_LOG.md (files)
# coder|master: start worktree + sandbox + git common-dir + third_party libpin host .git + profiles
# orchestrator: start worktree + sandbox + profiles
# primary: git_home (+ profiles / common build homes)

# --- profile path lists (agent-landlock expands env: and worktree-relative) ---
[profile.android]
path=.android-shared
path=env:HOME/.android

[profile.gradle]
path=env:HOME/.gradle
path=.gradle

# host_git_suffix=/.git
# libpin libs discovered at launch from third_party/*/libpin.toml under start worktree
