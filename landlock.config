# landlock.config: extra directory grants (profile paths, *_paths= lists).
# git_home, orch_root and sandbox_dir come from project.config only. No secrets here.
# Use absolute paths or env:VAR/... ; a grant that is empty or holds @@ fails.
# Cursor: agent-landlock reads this. Grok: grok-launch-common.sh reads the same
# profile.* path= lines into the role sandbox (env:HOME is that role user's home).

# --- always-on mutation (hardcoded in agent-landlock; listed for operators) ---
# /tmp /var/tmp $TMPDIR
# /dev/null /dev/zero /dev/full /dev/urandom /dev/random /dev/tty

# --- role summary (enforced in agent-landlock, not only comments) ---
# planner: sandbox + work-history/ (TODO.md and ENGINEERING_LOG.md live there)
# coder|master: start worktree + sandbox + git common-dir + third_party libpin host .git + profiles
# orchestrator: start worktree + sandbox + profiles
# primary: git_home (+ profiles / common build homes)

# Live writes: worktree .gradle-home (GRADLE_USER_HOME), .gradle (project),
# .android-shared (ANDROID_USER_HOME). orch .android-shared is the canonical
# keystore to copy. orch .gradle-shared is leftover — not agent user home.

# --- profile path lists (agent-landlock expands env: and worktree-relative) ---
[profile.android]
path=.android-shared
path=env:HOME/.android

[profile.gradle]
path=env:HOME/.gradle
path=.gradle
path=.gradle-home

# host_git_suffix=/.git
# libpin libs discovered at launch from third_party/*/libpin.toml under start worktree
