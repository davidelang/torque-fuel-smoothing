#!/bin/bash
# post-checkout hook — install as .git/hooks/post-checkout (chmod 775)
# Re-apply perms after checkout/reset. project.config is gitignored and seeded
# by setup_agent; missing config during worktree populate is normal.

set -euo pipefail

# setup_agent sets this so we do not double-run heavy fix-perms --all (sudo thrash)
# and do not warn about project.config before seed_smudge_inputs.
if [ "${VE_SETUP_AGENT:-}" = "1" ]; then
  exit 0
fi

GIT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
cd "$GIT_ROOT" || exit 0

# Best-effort perms recovery (quiet). Prefer fix-perms; fall back to legacy scripts.
if [ -x ./fix-perms ]; then
  ./fix-perms --all 2>/dev/null || sudo -n ./fix-perms --all 2>/dev/null || true
elif [ -x ./set-worktree-perms ]; then
  ./set-worktree-perms --all 2>/dev/null || true
  [ -x ./set-sandbox-perms ] && ./set-sandbox-perms 2>/dev/null || true
fi

# project.config is intentionally gitignored (local machine secrets/paths).
# Only warn if stamped launchers still contain unsubstituted @@ tokens.
if [ ! -f "$GIT_ROOT/project.config" ]; then
  # Soft note once; not a failure. setup_agent / human copies project.config.example → project.config
  if [ -z "${VE_QUIET_HOOK:-}" ]; then
    : # silent — missing config is normal for fresh clones until configured
  fi
else
  for f in run-grok run-grok-master ve-env; do
    if [ -f "$GIT_ROOT/$f" ] && grep -q '@@' "$GIT_ROOT/$f" 2>/dev/null; then
      echo "WARNING: unsubstituted @@ tokens in $f (smudge/filter may need project.config + filter-apply-config)."
      break
    fi
  done
fi

exit 0
