# Build outputs belong to the builder (perm-model.tsv build-intermediates: coder_user). Paths
# under app/build or .gradle that this user cannot bring to the model (another owner, e.g. left
# by an old build or fix-perms run as someone else) would stop the post-build repair or the
# deliverable chmod after a long gradle run: refuse now, before the commit, naming them.
if [ "$SINGLE_USER" = false ]; then
  # The deliverable chain above app/build (the worktree and app/) is not the builder's: it must
  # already be o+rx (fix-perms' worktree area), since only its owner could change it.
  for _d in . app; do
    if [ -d "$_d" ]; then
      perm_preflight deliverable-dirs "$_d" --top-only || {
        echo "ERROR: $(cd "$_d" && pwd) must be searchable by everyone (o+rx) so $PRIMARY_USER can reach the APK/AAB," >&2
        echo "  and $(id -un) does not own it. Fix once: run ./fix-perms from the orchestration root (it must run as root); nothing was committed or built." >&2
        exit 1
      }
    fi
  done
  for _d in .gradle app/build; do
    if [ -d "$_d" ]; then
      perm_preflight build-intermediates "$_d" || {
        echo "ERROR: $(pwd)/$_d has paths $(id -un) cannot fix (CANNOT-FIX above); nothing was committed or built." >&2
        echo "  Fix once: run ./fix-perms from the orchestration root (it must run as root; it makes app/build and .gradle $(cfg coder_user)-owned)" >&2
        exit 1
      }
    fi
  done
fi

# GENERATED PATHS: everything build_app (and ve-resolve-orch) writes in the worktree. Never
# committed, independent of .gitignore. A path is generated when it lies under:
#   - a top-level .gradle-home/ (GRADLE_USER_HOME: caches, daemon registry daemon-run.<pid>),
#     .android-shared/ (ANDROID_USER_HOME, incl. the copied debug.keystore), .gradle-shared/,
#     or build/ (root project build dir);
#   - a .gradle/ or .cxx/ directory at any depth (Gradle project dir, CMake/ndk output);
#   - a build/ directory whose parent holds build.gradle or build.gradle.kts (a Gradle
#     module's output, e.g. app/build incl. app/build/outputs/build_app/*.json). A source
#     directory merely named build/ elsewhere is not matched.
# Not generated: play-bundle.aab (tracked link) and app/versionCode.txt (--play bump commit).
GENERATED_TOP_DIRS=(.gradle-home .android-shared .gradle-shared build)
GENERATED_ANY_DEPTH_DIRS=(.gradle .cxx)
GENERATED_MODULE_DIR=build
GENERATED_PREFILTER='(^|/)(\.gradle-home|\.android-shared|\.gradle-shared|\.gradle|\.cxx|build)/'

generated_root() {  # generated_root PATH: print the generated dir (with /) PATH lies under, or return 1
  local path="$1" pre="" seg rest t
  rest="$path"
  while [[ "$rest" == */* ]]; do
    seg="${rest%%/*}"; rest="${rest#*/}"
    if [ -z "$pre" ]; then
      for t in "${GENERATED_TOP_DIRS[@]}"; do
        if [ "$seg" = "$t" ]; then printf '%s/\n' "$seg"; return 0; fi
      done
    fi
    for t in "${GENERATED_ANY_DEPTH_DIRS[@]}"; do
      if [ "$seg" = "$t" ]; then printf '%s%s/\n' "$pre" "$seg"; return 0; fi
    done
    if [ "$seg" = "$GENERATED_MODULE_DIR" ] && { [ -f "${pre}build.gradle" ] || [ -f "${pre}build.gradle.kts" ]; }; then
      printf '%s%s/\n' "$pre" "$seg"; return 0
    fi
    pre="$pre$seg/"
  done
  return 1
}

# generated_counts: read NUL-separated paths on stdin, print '<count> <root>' per generated root.
generated_counts() {
  local f r
  declare -A n=()
  while IFS= read -r -d '' f; do
    if r=$(generated_root "$f"); then n["$r"]=$(( ${n["$r"]:-0} + 1 )); fi
  done
  for r in "${!n[@]}"; do printf '%s %s\n' "${n[$r]}" "$r"; done | sort -k2
}

# list_prefiltered CMD...: run a NUL-output git command, keep paths with a generated-looking segment.
list_prefiltered() {
  local out rc
  out=$(set -o pipefail; "$@" | tr '\0' '\n') || { echo "ERROR: '$*' failed." >&2; exit 1; }
  # grep: 0 = matches, 1 = none (fine), anything else is an error.
  printf '%s\n' "$out" | grep -E "$GENERATED_PREFILTER" | tr '\n' '\0'
  rc=${PIPESTATUS[1]}
  if [ "$rc" -gt 1 ]; then echo "ERROR: grep failed ($rc) filtering '$*'." >&2; exit 1; fi
}

# Already-tracked generated files (an old accident): report and give the untrack command.
warn_tracked_generated() {
  local counts c r roots=""
  counts=$(set -o pipefail; list_prefiltered git ls-files -z | generated_counts) || exit 1
  [ -n "$counts" ] || return 0
  echo "WARNING: generated files are tracked in git (build_app never commits these; untrack them once):" >&2
  while read -r c r; do
    echo "  $c tracked file(s) under $r" >&2
    roots="$roots '$r'"
  done <<<"$counts"
  echo "  Untrack (keeps the files on disk), then commit the removal:  git rm --cached -r --$roots" >&2
}

# Unstage every staged generated path (new, modified or deleted). Index only; working files kept.
unstage_generated() {
  local counts c r
  counts=$(set -o pipefail; list_prefiltered git diff --cached --name-only -z --no-renames | generated_counts) || exit 1
  [ -n "$counts" ] || return 0
  while read -r c r; do
    git reset -q -- ":(literal)$r" || { echo "ERROR: could not unstage $r" >&2; exit 1; }
    echo "build_app: not committing $c generated file(s) under $r" >&2
  done <<<"$counts"
}

warn_tracked_generated

if [ "$#" -ge 1 ]; then
    MSG_ARG="$1"
    shift

    if [ "$MSG_ARG" = "--" ]; then
        set -- -- "$@"
        COMMIT_MSG=""
        ADDED_COUNT=0
    else
        # 1. Parse Message Content
        if [[ "$MSG_ARG" == @* ]]; then
            MSG_FILE="${MSG_ARG#@}"
            if [ -f "$MSG_FILE" ]; then
                COMMIT_MSG=$(cat "$MSG_FILE")
            else
                echo "Error: Message file '$MSG_FILE' not found."
                exit 1
            fi
        else
            COMMIT_MSG="$MSG_ARG"
        fi

        # 2. Add Specified Files Explicitly (no implicit adds or wildcards).
        # A tracked file that was deleted is staged as a deletion.
        ADDED_COUNT=0
        for file in "$@"; do
            if [ "$file" = "--" ]; then
                break
            fi
            if [ -e "$file" ]; then
                git add "$file"
                ADDED_COUNT=$((ADDED_COUNT + 1))
            elif git ls-files --error-unmatch "$file" >/dev/null 2>&1; then
                git add -u -- "$file"
                ADDED_COUNT=$((ADDED_COUNT + 1))
            else
                echo "Warning: File '$file' not found. Skipping."
            fi
        done
    fi

    # 3. Commit Phase (staged changes from args above or pre-staged), generated paths left out
    unstage_generated
    STAGED_CHANGES=$(git diff --cached --name-only) || { echo "ERROR: git diff --cached failed." >&2; exit 1; }
    if [ -n "$STAGED_CHANGES" ]; then
        if [ -n "$COMMIT_MSG" ]; then
            git commit -m "$COMMIT_MSG"
            if [ $? -ne 0 ]; then
                echo "Error: Git commit failed."
                exit 1
            fi
        else
            echo "Error: Staged changes exist but no commit message provided."
            exit 1
        fi
    else
        if [ "$ADDED_COUNT" -gt 0 ]; then
            echo "Error: Files provided but nothing to commit (already matches repo?)."
            exit 1
        fi
        echo "Info: No new changes to commit. Proceeding to integrity check."
    fi
else
    echo "Info: No arguments provided. Skipping commit phase."
fi

# 4. Integrity Barrier: everything MUST be in git for accurate 'git describe' versioning.
# Generated paths are left out (an already-tracked one was reported above; it stays uncommitted).
DIRTY_FILES=$(git status --porcelain -uno) || { echo "ERROR: git status failed." >&2; exit 1; }
if [ -n "$DIRTY_FILES" ]; then
    _dirty_kept=""
    while IFS= read -r _line; do
        _p="${_line:3}"; _p="${_p##* -> }"
        generated_root "$_p" >/dev/null || _dirty_kept="$_dirty_kept$_line"$'\n'
    done <<<"$DIRTY_FILES"
    DIRTY_FILES="${_dirty_kept%$'\n'}"
fi
if [ -n "$DIRTY_FILES" ]; then
    echo "CRITICAL ERROR: Uncommitted tracked files detected:"
    echo "$DIRTY_FILES"
    echo "------------------------------------------------------------------"
    echo "Every modified file MUST be explicitly added to the build command."
    echo "Compile aborted to ensure accurate 'git describe' versioning."
    exit 1
fi

# 5. Build Phase
if [ ! -x ./gradlew ]; then
    echo "ERROR: ./gradlew not found or not executable (this tree is an Android app; compile is required)." >&2
    exit 1
fi

GRADLE_ARGS=()
SEEN_DASHDASH=false
for arg in "$@"; do
  if [ "$SEEN_DASHDASH" = true ]; then
    GRADLE_ARGS+=("$arg")
  elif [ "$arg" = "--" ]; then
    SEEN_DASHDASH=true
  fi
done
# --standard only. Args after -- stay Gradle args; this property is added as well.
# 1 -> -Pfuelsmoothing.official=true. Absent or empty adds nothing. Any other value
# is passed through, so Gradle's existing check fires. No error of our own. Not --play.
STANDARD_OFFICIAL=()
if [ "$BUILD_STANDARD" = true ]; then
  _fs_off=$(cfg fuelsmoothing_official)
  if [ -n "$_fs_off" ]; then
    if [ "$_fs_off" = 1 ]; then
      STANDARD_OFFICIAL+=(-Pfuelsmoothing.official=true)
    else
      STANDARD_OFFICIAL+=(-Pfuelsmoothing.official="$_fs_off")
    fi
  fi
fi
if [ ${#GRADLE_ARGS[@]} -gt 0 ]; then
  echo "Passing gradle flags: ${GRADLE_ARGS[*]}"
fi

# On a failed run after the --play bump: say that the bump commit stays.
# A release tag this run created is deleted on any failed exit. The commit stays.
PLAY_BUMPED=false
drop_release_tag() {
  local rc=$1
  if [ "$RELEASE_TAG_CREATED" = true ] && [ "$rc" -ne 0 ]; then
    if git tag -d "$RELEASE_TAG"; then
      echo "NOTE: release tag $RELEASE_TAG removed because the build failed. The commit stays." >&2
    else
      echo "ERROR: the build failed and release tag $RELEASE_TAG could not be deleted." >&2
    fi
    RELEASE_TAG_CREATED=false
  fi
}
play_bump_note() {
  local rc=${1:-$?}
  drop_release_tag "$rc"
  if [ "$PLAY_BUMPED" = true ] && [ "$rc" -ne 0 ]; then
    echo "NOTE: the build failed after versionCode $NEW_VERSION_CODE was committed ($(git rev-parse --short "$BUILT_COMMIT")). That commit stays; the next --play bumps to $((NEW_VERSION_CODE + 1)) (gaps are fine for Play)." >&2
  fi
}
# Refuse a name that git describe would not use as versionName. Nothing is committed.
validate_release_tag() {
  [ -n "$RELEASE_TAG" ] || return 0
  local branch
  branch=$(git rev-parse --abbrev-ref HEAD) || exit 1
  if [ "$branch" = HEAD ]; then
    echo "ERROR: --release-tag needs a branch; this checkout is detached." >&2
    exit 1
  fi
  if ! git check-ref-format "refs/tags/$RELEASE_TAG"; then
    echo "ERROR: --release-tag '$RELEASE_TAG' is not a valid tag name." >&2
    exit 1
  fi
  case "$RELEASE_TAG" in
    *+*)
      echo "ERROR: --release-tag '$RELEASE_TAG' contains '+'; git describe excludes those tags, so it would not be the versionName." >&2
      exit 1
      ;;
    builds|*/builds)
      echo "ERROR: --release-tag '$RELEASE_TAG' is a moving builds tag, not a release name." >&2
      exit 1
      ;;
    *-start)
      echo "ERROR: --release-tag '$RELEASE_TAG' is a branch-start tag, not a release name." >&2
      exit 1
      ;;
  esac
  if git rev-parse -q --verify "refs/tags/${RELEASE_TAG}" >/dev/null; then
    echo "ERROR: tag '$RELEASE_TAG' already exists." >&2
    exit 1
  fi
  if git rev-parse -q --verify "refs/tags/${branch}-start" >/dev/null; then
    echo "ERROR: branch '$branch' has tag ${branch}-start, so versionName is that testing describe, not '$RELEASE_TAG'." >&2
    echo "  Release tags are for a branch without a -start tag (e.g. master)." >&2
    exit 1
  fi
  # Without --play the tag goes on HEAD itself; another annotated tag there would tie with it
  # in git describe (same commit, often the same second), so versionName could be the old name.
  if [ "$BUILD_PLAY" != true ]; then
    local others
    others=$(git for-each-ref --points-at HEAD --format='%(objecttype) %(refname:short)' refs/tags | awk '$1 == "tag" && $2 !~ /\+/ {print $2}') || exit 1
    if [ -n "$others" ]; then
      echo "ERROR: HEAD already has annotated tag(s): $(printf '%s ' $others)so git describe may not return '$RELEASE_TAG' as versionName." >&2
      echo "  Commit something first, or use --play (the tag then goes on the new versionCode commit)." >&2
      exit 1
    fi
  fi
}
create_release_tag() {
  [ -n "$RELEASE_TAG" ] || return 0
  git tag -a "$RELEASE_TAG" -m "$RELEASE_TAG" || {
    echo "ERROR: could not create annotated tag '$RELEASE_TAG'." >&2
    exit 1
  }
  RELEASE_TAG_CREATED=true
  trap play_bump_note EXIT
  local desc
  desc=$(git describe --always --exclude '*+*') || exit 1
  if [ "$desc" != "$RELEASE_TAG" ]; then
    echo "ERROR: after tagging, git describe gives '$desc', not '$RELEASE_TAG'; versionName would be wrong." >&2
    exit 1
  fi
  echo "Release tag $RELEASE_TAG on $(git rev-parse --short HEAD) (annotated)"
}

# Before the Play bump, so a refused name commits nothing and asks for no passwords.
validate_release_tag

# Play preflight on the committed HEAD: testing-version check and passwords, all before any
# gradle work, so an unattended run never stops part-way waiting for input.
if [ "$BUILD_PLAY" = true ]; then
  # Runs as coder_user like every build. The upload keystore must be readable by coder_user
  # (how is the machine owner's choice; see keystore_access_report); what protects it is the password, which only the person at this terminal types.
  # Same version string the gradle files compute for versionName: the BRANCH-start describe
  # when that tag exists, otherwise 'git describe --always --exclude '*+*''. A Play
  # versionCode is not versionName. A --release-tag, when given, is an annotated tag on
  # the bump commit and is what that describe returns. Only the BRANCH-start case is a
  # testing version.
  BRANCH=$(git rev-parse --abbrev-ref HEAD) || exit 1
  if [ ! -f app/versionCode.txt ]; then
    echo "ERROR: --play needs app/versionCode.txt (one integer; gradle reads versionCode from it)." >&2
    exit 1
  fi
  OLD_VERSION_CODE=$(tr -d '[:space:]' < app/versionCode.txt)
  if ! [[ "$OLD_VERSION_CODE" =~ ^[0-9]+$ ]]; then
    echo "ERROR: app/versionCode.txt is '$OLD_VERSION_CODE', not an integer." >&2
    exit 1
  fi
  if ! git ls-files --error-unmatch app/versionCode.txt >/dev/null; then
    echo "ERROR: app/versionCode.txt is not tracked; --play commits each bump." >&2
    exit 1
  fi
  if git rev-parse -q --verify "refs/tags/${BRANCH}-start" >/dev/null; then
    echo "==================================================================" >&2
    echo "WARNING: branch '$BRANCH' has tag ${BRANCH}-start, so its versionName is" >&2
    echo "  '${BRANCH}-start-<n>-g<hash>': a TESTING version, not a release." >&2
    echo "  Release builds come from a branch without a -start tag (e.g. master)." >&2
    echo "==================================================================" >&2
    read -r -p "Build a release bundle from this testing version anyway? [y/N] " ANSWER
    case "$ANSWER" in
      y|Y|yes|YES) ;;
      *) echo "Aborted: testing version (nothing built or committed)." >&2; exit 1 ;;
    esac
  fi

  # Passwords live only in this process's environment and gradle's; never on a command line or disk.
  read -r -s -p "Upload keystore password ($RELEASE_KEYSTORE): " BA_STORE_PASSWORD
  echo
  read -r -s -p "Key password for alias '$RELEASE_KEY_ALIAS' (Enter = same as keystore password): " BA_KEY_PASSWORD
  echo
  if [ -z "$BA_STORE_PASSWORD" ]; then
    echo "ERROR: empty keystore password." >&2
    exit 1
  fi
  if [ -z "$BA_KEY_PASSWORD" ]; then
    BA_KEY_PASSWORD="$BA_STORE_PASSWORD"
  fi

  # Check the store password and alias now, and record the upload cert to compare with the AAB.
  if ! KS_LIST=$(BA_STORE_PASSWORD="$BA_STORE_PASSWORD" keytool -list -v -keystore "$RELEASE_KEYSTORE" -alias "$RELEASE_KEY_ALIAS" -storepass:env BA_STORE_PASSWORD 2>&1); then
    echo "ERROR: keytool could not open alias '$RELEASE_KEY_ALIAS' in $RELEASE_KEYSTORE:" >&2
    echo "$KS_LIST" >&2
    exit 1
  fi
  UPLOAD_SHA256=$(printf '%s\n' "$KS_LIST" | sed -n 's/^[[:space:]]*SHA256:[[:space:]]*//p' | head -1)
  if [ -z "$UPLOAD_SHA256" ]; then
    echo "ERROR: no SHA256 fingerprint in keytool output for $RELEASE_KEYSTORE." >&2
    exit 1
  fi
  echo "Upload key: $RELEASE_KEYSTORE alias $RELEASE_KEY_ALIAS (SHA256 $UPLOAD_SHA256)"

  # versionCode bump before any gradle work (header, step 5): every build comes from it.
  NEW_VERSION_CODE=$((OLD_VERSION_CODE + 1))
  printf '%s\n' "$NEW_VERSION_CODE" > app/versionCode.txt
  git commit -q --only -m "versionCode $NEW_VERSION_CODE (play build)" -- app/versionCode.txt || {
    echo "ERROR: could not commit app/versionCode.txt ($NEW_VERSION_CODE)." >&2
    exit 1
  }
  BUILT_COMMIT=$(git rev-parse HEAD) || exit 1
  PLAY_BUMPED=true
  trap play_bump_note EXIT
fi

# After the bump when there is one, so the tag is on the commit Gradle is about to build.
create_release_tag

if [ "$BUILD_PLAY" = true ]; then
  if git rev-parse -q --verify "refs/tags/${BRANCH}-start" >/dev/null; then
    VERSION_DESC=$(git describe --tags --match "${BRANCH}-start") || exit 1
  else
    VERSION_DESC=$(git describe --always --exclude '*+*') || exit 1
  fi
  echo "versionCode $OLD_VERSION_CODE -> $NEW_VERSION_CODE, committed $(git rev-parse --short HEAD); every build comes from it (versionName $VERSION_DESC)"
fi

# Homes under this worktree. orch_root is read/seed only (keystore copy).
_BA_HERE="$(cd "$(dirname "$0")" && pwd)"
if [ ! -f "$_BA_HERE/ve-resolve-orch" ]; then
  echo "ERROR: missing $_BA_HERE/ve-resolve-orch (run ./update-rules.sh from orchestration root)." >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$_BA_HERE/ve-resolve-orch"
if [ "$SINGLE_USER" = true ]; then
  ORCH_ROOT="$_BA_HERE"
  mkdir -p "$_BA_HERE/.gradle-home" || exit 1
  export GRADLE_USER_HOME="$_BA_HERE/.gradle-home"
else
  ve_resolve_orch "$_BA_HERE" || exit 1
  ve_setup_worktree_build_homes "$_BA_HERE" || exit 1
fi
_AAPT2=$(ve_aapt2_from_sdk "$_BA_HERE") || exit 1
# Extracted Maven aapt2 copies lose +x (see ve_aapt2_from_sdk); restore it where missing.
# A copy this user cannot chmod stops the build with chmod's own error.
if [ -n "${GRADLE_USER_HOME:-}" ] && [ -d "$GRADLE_USER_HOME" ]; then
  find "$GRADLE_USER_HOME" -type f -name aapt2 ! -perm -u+rx,g+rx -exec chmod u+rx,g+rx {} + || exit 1
fi
ve_reset_gradle_daemon_dir || exit 1
unset GRADLE_OPTS
if [ "$SINGLE_USER" = false ]; then
  ve_wipe_foreign_app_build_outputs || exit 1
  PLANNING_USER=$(cfg planning_user)
  if [ -z "$PLANNING_USER" ]; then
    echo "ERROR: planning_user unset in project.config (the user that must never build)." >&2
    echo "  Example: planning_user=ai-planner" >&2
    exit 1
  fi
  if [ "$(id -un)" = "$PLANNING_USER" ]; then
    echo "ERROR: Planning agents must not run Gradle builds. Policy violation."
    exit 1
  fi
fi

# One daemon per build_app run, shared by its standard/test/play gradle calls (warm JVM and
# in-memory caches after the first). Its registry is private to this run:
# $GRADLE_USER_HOME/daemon-run.<pid>. 'gradlew --stop' with the same registry stops only this
# run's daemon, not another build_app in this worktree, and not other worktrees (their
# GRADLE_USER_HOME differs). The EXIT trap (also on INT/TERM) stops it, success or failure. The
# idle timeout (10 min) is the backstop only for a build_app killed with SIGKILL.
# org.gradle.daemon=false in gradle.properties is overridden by --daemon.
DAEMON_REGISTRY="$GRADLE_USER_HOME/daemon-run.$$"
if [ -e "$DAEMON_REGISTRY" ]; then
  echo "ERROR: $DAEMON_REGISTRY already exists (a stale run with this pid); remove it." >&2
  exit 1
fi
mkdir "$DAEMON_REGISTRY" || exit 1
DAEMON_PROPS=( -Dorg.gradle.daemon.registry.base="$DAEMON_REGISTRY" -Dorg.gradle.daemon.idletimeout=600000 )
stop_gradle_daemon() {
  local rc=$? out
  trap - EXIT INT TERM
  play_bump_note "$rc"
  if [ -n "$(find "$DAEMON_REGISTRY" -name registry.bin)" ]; then
    if ! out=$( (umask "$BUILD_UMASK"; ./gradlew "${DAEMON_PROPS[@]}" --stop) 2>&1); then
      echo "ERROR: could not stop this run's Gradle daemon (registry $DAEMON_REGISTRY):" >&2
      printf '%s\n' "$out" >&2
      if [ "$rc" -eq 0 ]; then
        exit 1
      fi
      echo "ERROR: (the build had already failed, exit $rc)" >&2
      exit "$rc"
    fi
    echo "Gradle daemon stopped (this run's only)."
  fi
  if ! rm -rf "$DAEMON_REGISTRY"; then
    echo "ERROR: cannot remove $DAEMON_REGISTRY" >&2
    if [ "$rc" -eq 0 ]; then exit 1; fi
  fi
  exit "$rc"
}
trap stop_gradle_daemon EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

GRADLE_BASE=( ./gradlew --daemon "${DAEMON_PROPS[@]}" --no-configuration-cache
  -Pandroid.aapt2FromMavenOverride="$_AAPT2"
  -Pkotlin.compiler.execution.strategy=in-process
  -Dkotlin.compiler.execution.strategy=in-process )

# Post-build permission repair for this worktree only (not orch caches). Runs after every
# gradle invocation, successful or not, on what the build produces and nothing else:
# app/build and .gradle get the build-intermediates area (group ai-code, group rw, setgid dirs;
# 'other' bits are left as the umask made them). The source tree (app/src) is never walked: it
# holds everyone's files (sources, an editor's swap file) and the build writes nothing there
# (generated sources go to app/build). A path in app/build or .gradle owned by someone else whose
# mode differs makes chmod fail, and the build stops naming the path, its owner and the fix.
repair_build_perms() {
  local d
  [ "$SINGLE_USER" = true ] && return 0
  for d in .gradle app/build; do
    if [ -d "$d" ]; then
      perm_apply build-intermediates "$d" || exit 1
    fi
  done
}

# Deliverables (the files someone uploads or sideloads, possibly from a desktop session that
# predates a group change): each named file gets the deliverables area (644), every directory
# from the worktree down to it the deliverable-dirs area (o+rx), and then the result is checked
# from the primary user's point of view with no supplementary groups. Not readable = exit 1.
publish_deliverables() {
  local f d files=()
  [ "$SINGLE_USER" = true ] && return 0
  for f in "$@"; do
    case "$f" in
      /*) echo "ERROR: deliverable path must be relative to the worktree: $f" >&2; exit 1 ;;
    esac
    if [ ! -f "$f" ]; then
      echo "ERROR: deliverable missing: $f" >&2
      exit 1
    fi
    files+=("$f")
    if [ -f "$(dirname "$f")/output-metadata.json" ]; then
      files+=("$(dirname "$f")/output-metadata.json")
    fi
  done
  for f in "${files[@]}"; do
    perm_apply deliverables "$f" --top-only || exit 1
    d=$(dirname "$f")
    while [ "$d" != "." ]; do
      perm_apply deliverable-dirs "$d" --top-only || exit 1
      d=$(dirname "$d")
    done
  done
  for f in "${files[@]}"; do
    perm_verify deliverables "$f" --top-only || exit 1
  done
  perm_readable_nogroups "$PRIMARY_USER" "${files[@]/#/$(pwd)/}" || {
    echo "ERROR: deliverables are not readable by $PRIMARY_USER without group membership (see NOT-READABLE above)." >&2
    exit 1
  }
  echo "Deliverables readable by $PRIMARY_USER without group membership: ${files[*]}"
}

# APK build: $1 = standard|test; remaining args = gradle tasks. Previous outputs of that build's
# variants are removed first, so the recorded APKs (android-build-info stamp, from Gradle's
# output-metadata.json) are this run's; the stamp ties them to this commit for ./deploy.
build_apks() {
  local label="$1"
  shift
  local tasks=( "$@" ) ret apks=() stamped extra=()
  if [ "$label" = standard ]; then
    extra=("${STANDARD_OFFICIAL[@]}")
  fi
  if [ ${#extra[@]} -gt 0 ]; then
    echo "=== $label build: ${extra[*]} ${tasks[*]} ==="
  else
    echo "=== $label build: ${tasks[*]} ==="
  fi
  rm -f "app/build/outputs/build_app/$label.json" || exit 1
  "$_BA_INFO" clean "$label" || exit 1
  # This run's daemon (GRADLE_BASE); stopped by the EXIT trap.
  (umask "$BUILD_UMASK"; "${GRADLE_BASE[@]}" "${GRADLE_ARGS[@]}" "${extra[@]}" "${tasks[@]}")
  ret=$?
  ve_reset_gradle_daemon_dir || exit 1
  repair_build_perms
  if [ "$ret" -ne 0 ]; then
    echo "Build failed ($label)."
    exit 1
  fi
  stamped=$("$_BA_INFO" stamp "$label") || exit 1
  printf '%s\n' "$stamped"
  mapfile -t apks < <(printf '%s\n' "$stamped" | awk '{print $3}')
  if [ "${#apks[@]}" -eq 0 ]; then
    echo "ERROR: the $label build recorded no APKs." >&2
    exit 1
  fi
  publish_deliverables "${apks[@]}"
  echo "=== $label build OK ==="
}

build_play() {
  local ret cert aab_sha256 version_code
  echo "=== play build: $RELEASE_BUNDLE_TASK ${RELEASE_GRADLE_ARGS[*]} ==="
  rm -f app/build/outputs/build_app/play.json || exit 1
  # Signing via AGP's injected-signing properties (android.injected.signing.*), which override
  # the build's own release signingConfig with no per-app gradle code. They are passed as
  # ORG_GRADLE_PROJECT_* environment variables rather than -P so the passwords never appear in
  # ps. Bash cannot export names containing '.', so python3 renames them and execs gradlew.
  # gradlew is '#!/usr/bin/env sh' and dash silently drops such variables, so it runs under bash.
  (umask "$BUILD_UMASK"
   export BA_STORE_FILE="$RELEASE_KEYSTORE" BA_KEY_ALIAS="$RELEASE_KEY_ALIAS" BA_STORE_PASSWORD BA_KEY_PASSWORD
   exec python3 -c '
import os, sys
e = os.environ
for src, name in (("BA_STORE_FILE", "store.file"), ("BA_STORE_PASSWORD", "store.password"),
                  ("BA_KEY_ALIAS", "key.alias"), ("BA_KEY_PASSWORD", "key.password")):
    e["ORG_GRADLE_PROJECT_android.injected.signing." + name] = e.pop(src)
os.execvp(sys.argv[1], sys.argv[1:])
' bash "${GRADLE_BASE[@]}" "${GRADLE_ARGS[@]}" "${RELEASE_GRADLE_ARGS[@]}" "$RELEASE_BUNDLE_TASK")
  ret=$?
  unset BA_STORE_PASSWORD BA_KEY_PASSWORD
  ve_reset_gradle_daemon_dir || exit 1
  repair_build_perms
  if [ "$ret" -ne 0 ]; then
    echo "Build failed (play)."
    exit 1
  fi
  if [ ! -f "$AAB" ]; then
    echo "ERROR: Gradle succeeded but expected bundle missing: $AAB" >&2
    exit 1
  fi
  cert=$(keytool -printcert -jarfile "$AAB" 2>&1) || { echo "ERROR: keytool -printcert failed on $AAB:" >&2; echo "$cert" >&2; exit 1; }
  if printf '%s\n' "$cert" | grep -q "Not a signed jar file"; then
    echo "ERROR: $AAB is NOT signed. Play will reject it." >&2
    exit 1
  fi
  aab_sha256=$(printf '%s\n' "$cert" | sed -n 's/^[[:space:]]*SHA256:[[:space:]]*//p' | head -1)
  if [ "$aab_sha256" != "$UPLOAD_SHA256" ]; then
    echo "ERROR: $AAB is signed with SHA256 '$aab_sha256', not the upload key ($UPLOAD_SHA256)." >&2
    exit 1
  fi
  publish_deliverables "$AAB"
  check_play_link "$AAB" built
  # Record the bundle for deploy --play (app/build/outputs/build_app/play.json).
  (umask "$BUILD_UMASK"; "$_BA_INFO" stamp-play "$AAB" "$NEW_VERSION_CODE") || exit 1
  version_code="$NEW_VERSION_CODE"
  PLAY_SUMMARY="Play bundle ready for upload:
  Path:        $(pwd)/$AAB
  Link:        $(pwd)/$PLAY_LINK
  File SHA256: $(sha256sum "$AAB" | cut -d' ' -f1)
  Signed by:   SHA256 $aab_sha256 (upload key)
  versionName: $VERSION_DESC
  versionCode: $version_code
  Commit:      $BUILT_COMMIT"
  echo "=== play build OK ==="
}

# Builds in a fixed sequence; any failure exits before the tag moves.
PLAY_SUMMARY=""
if [ "$BUILD_STANDARD" = true ]; then
  build_apks standard "${STD_TASKS[@]}"
fi
if [ "$BUILD_TEST" = true ]; then
  build_apks test "${TEST_TASKS[@]}"
fi
if [ "$BUILD_PLAY" = true ]; then
  build_play
fi

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$CURRENT_BRANCH" == "master" ]; then
    TAG_NAME="builds"
else
    TAG_NAME="${CURRENT_BRANCH}/builds"
fi
echo "All selected builds succeeded:$SELECTED. Updating '$TAG_NAME' tag."
git tag -f "$TAG_NAME"
# Same version string as the gradle versionName: BRANCH-start tag when it exists, else 'git describe --always --exclude '*+*''.
if git rev-parse -q --verify "refs/tags/${CURRENT_BRANCH}-start" >/dev/null; then
  git describe --tags --match "${CURRENT_BRANCH}-start"
else
  git describe --always --exclude '*+*'
fi
if [ -n "$PLAY_SUMMARY" ]; then
  echo "=================================================================="
  echo "$PLAY_SUMMARY"
  echo "=================================================================="
fi
exit 0
