#!/bin/bash

# THE ONLY WAY TO BUILD OR COMPILE.
# Authoritative copy: orchestration-example/build-examples/android-gradle/build_app
#
# Usage:
#   ./build_app [-s|--standard] [-t|--test] [-p|--play|--bundle] [-T|--release-tag NAME]
#               [-c|--signing-config FILE] [-K|--release-keystore V] [-A|--release-key-alias V]
#               [-B|--release-bundle-task V] [-P|--release-bundle-path V] [-G|--release-gradle-args V]
#               ["Commit Message" | "@msg_file.txt"] [file1 file2 ...] [-- gradle-flag ...]
#
#   Build selection (flags first, any order, combinable). No flag = standard, test (unless the
#   app declares none) and, with a project.config, play. -T/--release-tag does not change that.
#     -s, --standard    the app's standard build   ('- **Standard build:**' in project-facts.md)
#     -t, --test        the app's test build       ('- **Test build:**': a build type such as qa,
#                       a side-by-side app, and/or instrumentation:<variant> = that variant's app
#                       plus its androidTest APK)
#     -p, --play, --bundle
#                       signed Play AAB   (release_* keys); needs a terminal for the passwords
#     -T, --release-tag NAME
#                       annotated tag on the commit these builds use, created before Gradle so
#                       versionName is exactly NAME. No prompt. Absent: no release tag. With
#                       --play the tag is on the versionCode bump; without it, on the commit
#                       the builds use. A failed run deletes that tag. A bump commit stays.
#   Single-user Play signing (no project.config; refused when one exists), passed explicitly:
#     -c, --signing-config FILE   key=value lines: release_keystore, release_key_alias,
#                             release_bundle_task, release_bundle_path, release_gradle_args
#     -K, --release-keystore V  -A, --release-key-alias V  -B, --release-bundle-task V
#     -P, --release-bundle-path V  -G, --release-gradle-args V
#                       (each key once: file and flag together for one key is an error)
#
#   What to build is declared in the committed project-facts.md, section '## Build and commit',
#   one line each (strict: missing, duplicate or malformed lines stop the build):
#     - **Standard build:** debug
#     - **Test build:** qa | instrumentation:x86_64Debug | none | a comma-separated list
#   Which APKs came out is read from Gradle's output-metadata.json and recorded, with the commit
#   and sha256, in app/build/outputs/build_app/<standard|test>.json for ./deploy
#   (android-build-info, next to this script, does the parsing and recording).
#
#   project.config is optional. Without one (or with unsmudged @@TOKEN@@ values) build_app runs in
#   single-user mode: no sudo re-exec, no group checks, no permission model, orch_root = this
#   worktree, Gradle cache in ./.gradle-home. It says so when it starts.
#
#   Order of work:
#     1. Check the config for every selected build. If the Play build is selected (also by
#        default) and stdin is not a terminal, stop: pass --standard/--test explicitly.
#     2. Commit phase: commit the named files (or nothing when no message is given).
#        build_app never commits files it generates (GENERATED PATHS below), whatever the
#        project's .gitignore says: named or pre-staged ones are unstaged (working files kept)
#        with a stderr line per path, and already-tracked ones are reported with the
#        'git rm --cached' command to untrack them (never run by build_app).
#     3. Integrity check: the tree must be clean (generated paths aside); every build comes
#        from that one commit.
#     4. Play only: testing-version y/N check (only on a branch with a BRANCH-start tag) and
#        password prompts, before any gradle work, so an unattended build never stalls part-way.
#     5. Play only, before any gradle work: app/versionCode.txt goes N -> N+1, committed alone
#        as "versionCode N+1 (play build)". Every selected build (standard, test, play) then
#        comes from that bump commit, so all records share one commit. Without --play nothing
#        is bumped. If a build fails, the bump commit stays (history is never rewritten); the
#        next --play bumps again (gaps are fine for Play).
#     6. --release-tag only: an annotated tag of that name is created on the commit the builds
#        will use (the bump commit when --play is selected). Refused when the name is missing,
#        already exists, is 'builds' or '*/builds', ends in '-start', contains '+', or this
#        branch has a <branch>-start tag (that describe would hide the release name), or, without
#        --play, when HEAD already has another annotated tag (describe could pick it). A failed
#        run deletes the tag this run created. There is no prompt.
#     7. Builds in sequence: standard, test, play. The first failure stops everything.
#     8. The builds tag moves only after every selected build succeeded.
#
# Multi-user mode (a smudged project.config): every build, in every mode (--standard, --test,
# --play, the default), runs as coder_user, so app/build, .gradle and the deliverables always have
# one owner (the builder) and build_app only ever changes modes on paths it owns. Anyone else (root, primary_user, ...) is re-executed as coder_user through
# 'sudo -n -u <coder_user> /usr/bin/env ...', carrying the invoker's git identity for commits.
#
# NEVER run gradlew, gradlew.bat, or direct gradle commands (forbidden; this is the enforced gateway).
# It handles: git commit, tag update, forensic checks, local .gradle repair, umask (perm-model.tsv),
# and makes the APKs/AAB readable by primary_user even without group membership (644).
# Pass gradle options after -- (e.g. build_app "msg" file.kt -- --info --stacktrace).
#
# project.config keys (see project.config.example):
#   coder_user          user every build runs as (required)
#   java_home           JDK home for Gradle and keytool: absolute, with release file and bin/java, javac, keytool
#                       (optional: unset = the OS default java on PATH, printed at start)
#   planning_user       planning agent user, which must never build (required in multi-user mode)
#   release_keystore    Play build: absolute path of the app's upload keystore (required)
#   release_key_alias   Play build: key alias in that keystore (required)
#   release_bundle_task Play build: gradle task, e.g. bundlePlayRelease (required)
#   release_bundle_path Play build: AAB that task produces, relative to the worktree (required)
#   The release_* keys have no default: a Play build whose keys are unset stops before the commit
#   phase, naming each missing key (also in single-user mode: signing stays local to this machine).
#   release_gradle_args Play build: extra space-separated gradle args (e.g. -Pfuelsmoothing.official=true)
#   fuelsmoothing_official  --standard only: 1 appends -Pfuelsmoothing.official=true;
#                       absent or empty appends nothing; any other value is
#                       -Pfuelsmoothing.official=<value>. Not applied to --play.

# play-bundle.aab: a TRACKED relative symlink at the worktree top pointing at release_bundle_path,
# so a file picker (Play Console filters *.aab) reaches the bundle without walking app/build/...
# It is committed on the app branch (part of merges and new worktrees); build_app never creates
# or rewrites it (that would dirty the tree). Required in both modes: a missing or wrong link is an
# error with the fix, checked before the commit phase and again after the bundle is built.
PLAY_LINK=play-bundle.aab
play_link_fix() {
  echo "  Fix (once, on the app branch): ln -sfn '$1' $PLAY_LINK && git add $PLAY_LINK && git commit -m 'Link $PLAY_LINK to the Play bundle' -- $PLAY_LINK" >&2
}
check_play_link() {  # check_play_link TARGET [built]
  local target="$1" entry mode
  case "$target" in
    /*|../*) echo "ERROR: release_bundle_path must be relative and inside the worktree: $target" >&2; exit 1 ;;
  esac
  entry=$(git ls-files -s -- "$PLAY_LINK") || exit 1
  mode="${entry%% *}"
  if [ -z "$entry" ]; then
    echo "ERROR: $PLAY_LINK is not tracked in this branch (the committed link to the Play bundle)." >&2
    play_link_fix "$target"; exit 1
  fi
  if [ "$mode" != 120000 ]; then
    echo "ERROR: tracked $PLAY_LINK is not a symlink (git mode $mode)." >&2
    play_link_fix "$target"; exit 1
  fi
  if [ "$(git cat-file blob "HEAD:$PLAY_LINK")" != "$target" ]; then
    echo "ERROR: committed $PLAY_LINK points at '$(git cat-file blob "HEAD:$PLAY_LINK")', not release_bundle_path '$target'." >&2
    play_link_fix "$target"; exit 1
  fi
  if [ "${2:-}" = built ]; then
    if [ "$(readlink -f -- "$PLAY_LINK")" != "$(readlink -f -- "$target")" ] || [ ! -r "$PLAY_LINK" ]; then
      echo "ERROR: $(pwd)/$PLAY_LINK does not resolve to the readable bundle $target just built." >&2
      exit 1
    fi
  fi
}

# Help before re-exec, JDK lookup, or any build. A failure here is left for the parser below.
USAGE_LINE='usage: ./build_app [-h] [-s] [-t] [-p] [-T NAME] [signing options] ["MESSAGE" | @MSGFILE] [FILE ...] [-- GRADLE-FLAG ...]'
_ba_usage() {
  cat <<EOF
$USAGE_LINE

The only way to build: commit the named FILEs with MESSAGE, check the tree is clean,
then build from that one commit and move the builds tag. No build flag selects
standard, test (unless none) and, with a project.config, play.

options:
  -h, --help                   show this help message and exit
  -s, --standard               the app's standard build
  -t, --test                   the app's test build
  -p, --play, --bundle         signed Play AAB (needs a terminal for the passwords)
  -T, --release-tag NAME       annotated tag on the commit these builds use
  -c, --signing-config FILE    single-user Play signing: key=value file
  -K, --release-keystore V     single-user Play signing: release_keystore
  -A, --release-key-alias V    single-user Play signing: release_key_alias
  -B, --release-bundle-task V  single-user Play signing: release_bundle_task
  -P, --release-bundle-path V  single-user Play signing: release_bundle_path
  -G, --release-gradle-args V  single-user Play signing: release_gradle_args

Flags come first: a non-option ends them (./build_app msg file --standard
treats --standard as a file). Details: the comment at the top of ./build_app.
EOF
}
_ba_bad_option() {
  echo "$USAGE_LINE" >&2
  echo "build_app: error: unrecognized option: $1" >&2
  exit 2
}
# Help, and an unknown option, before re-exec, JDK lookup, or any build. A missing option
# value is left for the parser below (it names the option).
_ba_help_if_asked() {
  local parsed err bad a pre=()
  for a in "$@"; do
    [ "$a" = "--" ] && break
    pre+=("$a")
  done
  if ! err=$(getopt -o +hstpT:c:K:A:B:P:G: -l help,standard,test,play,bundle,release-tag:,signing-config:,release-keystore:,release-key-alias:,release-bundle-task:,release-bundle-path:,release-gradle-args: -- ${pre[@]+"${pre[@]}"} 2>&1 >/dev/null); then
    if printf '%s\n' "$err" | grep -q 'requires an argument'; then
      return 0
    fi
    bad=$(printf '%s\n' "$err" | sed -n "s/.*'\\([^']*\\)'.*/\\1/p" | head -1)
    _ba_bad_option "${bad:-?}"
  fi
  parsed="$(getopt -o +hstpT:c:K:A:B:P:G: -l help,standard,test,play,bundle,release-tag:,signing-config:,release-keystore:,release-key-alias:,release-bundle-task:,release-bundle-path:,release-gradle-args: -- ${pre[@]+"${pre[@]}"})"
  eval set -- "$parsed"
  while true; do
    case "$1" in
      -h|--help) _ba_usage; exit 0 ;;
      --) break ;;
      *) shift ;;
    esac
  done
}
_ba_help_if_asked "$@"

# Mode: multi-user when project.config exists and is smudged; single-user otherwise.
SINGLE_USER=false
SINGLE_USER_WHY=""
if [ ! -f project.config ]; then
  SINGLE_USER=true
  SINGLE_USER_WHY="no project.config in $(pwd)"
elif grep -Eq '^[A-Za-z_][A-Za-z0-9_]*=.*@@[A-Za-z_][A-Za-z0-9_]*@@' project.config; then
  SINGLE_USER=true
  SINGLE_USER_WHY="project.config has unsmudged @@TOKEN@@ values (not set up by setup-project)"
fi

# project.config value for key $1 (empty when unset or when there is no project.config).
cfg() {
  if [ ! -f project.config ]; then
    return 0
  fi
  sed -n "s/^$1=//p" project.config | tr -d '\r' | head -1
}

if [ "$SINGLE_USER" = true ]; then
  echo "NOTICE: single-user mode: $SINGLE_USER_WHY."
  echo "  Building as $(id -un) in this worktree: no sudo re-exec, no group checks, no permission"
  echo "  model; orch_root is this worktree and the Gradle cache is ./.gradle-home."
  PRIMARY_USER=$(id -un)
else
PRIMARY_USER=$(cfg primary_user)
if [ -z "$PRIMARY_USER" ]; then
  echo "ERROR: primary_user unset in project.config" >&2
  echo "  Stamp project.config from project.config.example (or source ./env after setup)." >&2
  exit 1
fi

# All builds run as coder_user: one owner for app/build and .gradle-home, one gradle/user
# environment. sudoers grants primary_user NOPASSWD (coder_user) /usr/bin/env; root needs nothing.
# sudo resets the environment, so the invoker's git identity is passed explicitly for the commit.
CODER_USER=$(cfg coder_user)
if [ -z "$CODER_USER" ]; then
  echo "ERROR: coder_user unset in project.config" >&2
  exit 1
fi
if [ "$(id -un)" != "$CODER_USER" ]; then
  INVOKER_NAME=$(git config user.name)
  INVOKER_EMAIL=$(git config user.email)
  if [ -z "$INVOKER_NAME" ] || [ -z "$INVOKER_EMAIL" ]; then
    echo "ERROR: git user.name/user.email unset for $(id -un); commits made as $CODER_USER would lose your identity." >&2
    echo "  Fix: git config --global user.name '...'; git config --global user.email '...'" >&2
    exit 1
  fi
  echo "Re-executing as $CODER_USER (invoked by $(id -un); commits as $INVOKER_NAME <$INVOKER_EMAIL>)..."
  exec sudo -n -u "$CODER_USER" /usr/bin/env \
    GIT_AUTHOR_NAME="$INVOKER_NAME" GIT_AUTHOR_EMAIL="$INVOKER_EMAIL" \
    GIT_COMMITTER_NAME="$INVOKER_NAME" GIT_COMMITTER_EMAIL="$INVOKER_EMAIL" \
    BUILD_APP_INVOKER="$(id -un)" \
    "$0" "$@"
fi
fi

# Owners, groups, modes and umasks come from perm-model.tsv through perm-lib.sh (next to this
# script). One Gradle daemon serves every gradle call of this run (see GRADLE_BASE). It is
# started by the first call, inside the build umask, and keeps that umask; every call uses the
# same umask, so the outputs get it too. The daemon is stopped when build_app exits.
_BA_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ "$SINGLE_USER" = true ]; then
  BUILD_UMASK=$(umask)
else
if [ ! -f "$_BA_DIR/perm-lib.sh" ]; then
  echo "ERROR: missing $_BA_DIR/perm-lib.sh (ships with the orchestration rules)." >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$_BA_DIR/perm-lib.sh"
perm_init "$_BA_DIR/project.config" || exit 1
WORKTREE_UMASK=$(perm_umask worktree) || exit 1
BUILD_UMASK=$(perm_umask build-intermediates) || exit 1
umask "$WORKTREE_UMASK"
fi
_BA_INFO="$_BA_DIR/android-build-info"
if [ ! -x "$_BA_INFO" ]; then
  echo "ERROR: missing $_BA_INFO (ships with the android-gradle build type)." >&2
  exit 1
fi

# The JDK running Gradle and keytool: java_home= from project.config when set (strict), else the
# OS default java on PATH (resolved through its symlinks; printed).
JAVA_HOME_CFG=$(cfg java_home)
if [ -z "$JAVA_HOME_CFG" ]; then
  if ! _ba_java=$(command -v java); then
    echo "ERROR: java_home is not set in project.config and there is no java on PATH." >&2
    echo "  Install a JDK, or set java_home=/absolute/jdk/home in project.config." >&2
    exit 1
  fi
  _ba_java=$(readlink -f "$_ba_java") || exit 1
  JAVA_HOME_CFG=$(dirname "$(dirname "$_ba_java")")
  echo "java_home not set: using the OS default java $_ba_java (JAVA_HOME=$JAVA_HOME_CFG)"
fi
if [[ "$JAVA_HOME_CFG" != /* ]]; then
  echo "ERROR: java_home must be an absolute path: $JAVA_HOME_CFG" >&2
  exit 1
fi
for _jdk_tool in java javac keytool; do
  if [ ! -x "$JAVA_HOME_CFG/bin/$_jdk_tool" ]; then
    echo "ERROR: $JAVA_HOME_CFG is not a JDK (no executable bin/$_jdk_tool)." >&2
    exit 1
  fi
done
# Every JDK home has a 'release' file; /usr (alternatives symlinks) does not, so it is rejected.
if [ ! -f "$JAVA_HOME_CFG/release" ]; then
  echo "ERROR: $JAVA_HOME_CFG is not a JDK home (no 'release' file)." >&2
  exit 1
fi
JDK_VERSION=$(sed -n 's/^JAVA_VERSION="\(.*\)"$/\1/p' "$JAVA_HOME_CFG/release")
if [ -z "$JDK_VERSION" ]; then
  echo "ERROR: no JAVA_VERSION in $JAVA_HOME_CFG/release" >&2
  exit 1
fi
export JAVA_HOME="$JAVA_HOME_CFG"
export PATH="$JAVA_HOME/bin:$PATH"
echo "Gradle JDK: $JAVA_HOME ($JDK_VERSION)"

# Build-selection flags come first, before the commit message. No flag selects all three.
BUILD_STANDARD=false
BUILD_TEST=false
BUILD_PLAY=false
FLAG_SEEN=false
RELEASE_TAG=""
RELEASE_TAG_CREATED=false
# Single-user Play signing, given explicitly (no implicit lookup): --signing-config FILE and/or
# --release-keystore/--release-key-alias/--release-bundle-task/--release-bundle-path/
# --release-gradle-args VALUE. Stored as SIGN_<key>; a key given twice is an error.
declare -A SIGN=()
SIGN_KEYS="release_keystore release_key_alias release_bundle_task release_bundle_path release_gradle_args"
SIGN_SOURCE=""
sign_set() {  # sign_set KEY VALUE ORIGIN
  if [ -n "${SIGN[$1]+x}" ]; then
    echo "ERROR: $1 given twice (${SIGN_FROM[$1]} and $3)." >&2
    exit 1
  fi
  if [ -z "$2" ]; then
    echo "ERROR: $1 is empty ($3)." >&2
    exit 1
  fi
  SIGN[$1]="$2"
  SIGN_FROM[$1]="$3"
}
declare -A SIGN_FROM=()
read_signing_config() {  # strict key=value file: comments and blank lines allowed, nothing else
  local f="$1" line n=0 k v
  if [ ! -f "$f" ] || [ ! -r "$f" ]; then
    echo "ERROR: --signing-config $f: not a readable file." >&2
    exit 1
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line="${line%$'\r'}"
    [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
    if ! [[ "$line" =~ ^([a-z_]+)=(.*)$ ]]; then
      echo "ERROR: $f line $n is not key=value: $line" >&2
      exit 1
    fi
    k="${BASH_REMATCH[1]}"; v="${BASH_REMATCH[2]}"
    if [[ " $SIGN_KEYS " != *" $k "* ]]; then
      echo "ERROR: $f line $n: unknown key '$k' (signing keys: $SIGN_KEYS)." >&2
      exit 1
    fi
    sign_set "$k" "$v" "$f line $n"
  done < "$f"
}
# Leading + stops at the first non-option. Split on the user's -- first so gradle
# flags after it stay gradle flags (getopt would otherwise drop that --).
_ba_opt=()
_ba_gradle=()
_ba_dd=0
for _ba_a in "$@"; do
  if [ "$_ba_dd" -eq 1 ]; then
    _ba_gradle+=("$_ba_a")
  elif [ "$_ba_a" = "--" ]; then
    _ba_dd=1
  else
    _ba_opt+=("$_ba_a")
  fi
done
# getopt errors go to a variable, not a temp file (stdout is discarded only here; the parse below keeps it).
if ! _ba_err=$(getopt -o +hstpT:c:K:A:B:P:G: -l help,standard,test,play,bundle,release-tag:,signing-config:,release-keystore:,release-key-alias:,release-bundle-task:,release-bundle-path:,release-gradle-args: -- ${_ba_opt[@]+"${_ba_opt[@]}"} 2>&1 >/dev/null); then
  if printf '%s\n' "$_ba_err" | grep -q 'requires an argument'; then
    _ba_optname=$(printf '%s\n' "$_ba_err" | sed -n "s/.*'\\(--[^']*\\)'.*/\\1/p; s/.*option requires an argument -- '\\([^']*\\)'.*/-\\1/p" | head -1)
    echo "ERROR: ${_ba_optname:-option} needs a value." >&2
  else
    _ba_bad=$(printf '%s\n' "$_ba_err" | sed -n "s/.*'\\([^']*\\)'.*/\\1/p" | head -1)
    _ba_bad_option "${_ba_bad:-?}"
  fi
  exit 1
fi
parsed=$(getopt -o +hstpT:c:K:A:B:P:G: -l help,standard,test,play,bundle,release-tag:,signing-config:,release-keystore:,release-key-alias:,release-bundle-task:,release-bundle-path:,release-gradle-args: -- ${_ba_opt[@]+"${_ba_opt[@]}"})
eval set -- "$parsed"
_ba_need() {
  if [ -z "${2:-}" ]; then
    echo "ERROR: $1 needs a value." >&2
    exit 1
  fi
}
while true; do
  case "$1" in
    -h|--help) _ba_usage; exit 0 ;;
    -c|--signing-config)
      _ba_need "$1" "${2:-}"; SIGN_SOURCE="$SIGN_SOURCE $1"; read_signing_config "$2"; shift 2 ;;
    -K|--release-keystore)
      _ba_need "$1" "${2:-}"; SIGN_SOURCE="$SIGN_SOURCE $1"; sign_set release_keystore "$2" "$1"; shift 2 ;;
    -A|--release-key-alias)
      _ba_need "$1" "${2:-}"; SIGN_SOURCE="$SIGN_SOURCE $1"; sign_set release_key_alias "$2" "$1"; shift 2 ;;
    -B|--release-bundle-task)
      _ba_need "$1" "${2:-}"; SIGN_SOURCE="$SIGN_SOURCE $1"; sign_set release_bundle_task "$2" "$1"; shift 2 ;;
    -P|--release-bundle-path)
      _ba_need "$1" "${2:-}"; SIGN_SOURCE="$SIGN_SOURCE $1"; sign_set release_bundle_path "$2" "$1"; shift 2 ;;
    -G|--release-gradle-args)
      _ba_need "$1" "${2:-}"; SIGN_SOURCE="$SIGN_SOURCE $1"; sign_set release_gradle_args "$2" "$1"; shift 2 ;;
    -s|--standard) BUILD_STANDARD=true; FLAG_SEEN=true; shift ;;
    -t|--test) BUILD_TEST=true; FLAG_SEEN=true; shift ;;
    -p|--play|--bundle) BUILD_PLAY=true; FLAG_SEEN=true; shift ;;
    -T|--release-tag)
      _ba_need "$1" "${2:-}"
      if [ -n "$RELEASE_TAG" ]; then
        echo "ERROR: --release-tag given twice." >&2
        exit 1
      fi
      RELEASE_TAG=$2
      shift 2 ;;
    --) shift; break ;;
    *) _ba_bad_option "$1" ;;
  esac
done
if [ "$_ba_dd" -eq 1 ]; then
  set -- "$@" -- ${_ba_gradle[@]+"${_ba_gradle[@]}"}
fi
if [ -n "$SIGN_SOURCE" ]; then
  if [ "$SINGLE_USER" = false ]; then
    echo "ERROR:$SIGN_SOURCE given, but this worktree has a project.config: the Play keys come from it." >&2
    echo "  Explicit signing options are for single-user mode (no project.config) only." >&2
    exit 1
  fi
  if [ "$BUILD_PLAY" != true ]; then
    echo "ERROR:$SIGN_SOURCE given without --play." >&2
    exit 1
  fi
fi
# Play key $1: project.config in multi-user mode; in single-user mode only what was passed explicitly.
play_key() {
  if [ "$SINGLE_USER" = true ]; then
    printf '%s' "${SIGN[$1]:-}"
  else
    cfg "$1"
  fi
}

# The declaration (strict) is read before anything else happens.
_BA_DECL=$("$_BA_INFO" decl) || exit 1
TEST_DECL=$(printf '%s\n' "$_BA_DECL" | sed -n 's/^test=//p')
if [ "$FLAG_SEEN" = false ]; then
  BUILD_STANDARD=true
  [ "$TEST_DECL" != none ] && BUILD_TEST=true
  [ "$SINGLE_USER" = false ] && BUILD_PLAY=true
fi
if [ "$BUILD_TEST" = true ] && [ "$TEST_DECL" = none ]; then
  echo "ERROR: --test, but this app declares '- **Test build:** none' in project-facts.md." >&2
  exit 1
fi
SELECTED=""
[ "$BUILD_STANDARD" = true ] && SELECTED="$SELECTED standard"
[ "$BUILD_TEST" = true ] && SELECTED="$SELECTED test"
[ "$BUILD_PLAY" = true ] && SELECTED="$SELECTED play"
echo "Selected builds:$SELECTED"

in_own_group() {  # in_own_group GROUP: is the current user a member of GROUP
  local g
  for g in $(id -nG); do [ "$g" = "$1" ] && return 0; done
  return 1
}

# keystore_access_report KEYSTORE: show every step of the path with its real owner, group and
# mode, mark the first one the current user can't pass (directories need x, the keystore needs
# r), then list the ways to grant access, narrowest first. It reports facts and options only;
# which one fits is the machine owner's choice, so it never names a group or changes anything.
keystore_access_report() {
  local ks="$1" me cur="" comp path need line i last g b add_note=false
  local -a comps paths=(/) blocked=()
  me=$(id -un)
  IFS=/ read -r -a comps <<< "${ks#/}"
  for comp in "${comps[@]}"; do [ -n "$comp" ] && { cur="$cur/$comp"; paths+=("$cur"); }; done
  last=$(( ${#paths[@]} - 1 ))
  echo "  Each step of the path, as $me (groups: $(id -nG)):" >&2
  for i in "${!paths[@]}"; do
    path=${paths[$i]}
    if [ ! -e "$path" ]; then
      echo "    $path  does not exist" >&2
      return 0
    fi
    line=$(stat -L -c '%A %U:%G' -- "$path") || exit 1
    if (( i < last )); then need=x; else need=r; fi
    if { [ "$need" = x ] && [ -x "$path" ]; } || { [ "$need" = r ] && [ -r "$path" ]; }; then
      echo "    $line  $path" >&2
    else
      echo "    $line  $path  <- $me lacks $need" >&2
      blocked+=("$need:$path")
      [ "$need" = x ] && break
    fi
  done
  (( ${#blocked[@]} )) || return 0
  echo "  Ways to give $me access, narrowest first (choose what fits this machine):" >&2
  echo "    ACL for $me only:" >&2
  for b in "${blocked[@]}"; do echo "      setfacl -m u:$me:${b%%:*} '${b#*:}'" >&2; done
  echo "    Through the owner or group each path already has:" >&2
  for b in "${blocked[@]}"; do
    path=${b#*:}; need=${b%%:*}
    g=$(stat -L -c %G -- "$path") || exit 1
    if [ "$(stat -L -c %U -- "$path")" = "$me" ]; then
      echo "      chmod u+$need '$path'   ($me owns it)" >&2
    elif in_own_group "$g"; then
      echo "      chmod g+$need '$path'   ($me is already in group $g)" >&2
    else
      echo "      add $me to group $g, then chmod g+$need '$path' if the group lacks it" >&2
      add_note=true
    fi
  done
  for b in "${blocked[@]}"; do
    if [ "${b%%:*}" = x ]; then
      echo "    For everyone (directory traversal only; the keystore itself must not be world-readable):" >&2
      echo "      chmod o+x '${b#*:}'" >&2
    fi
  done
  if [ "$add_note" = true ]; then
    echo "  A new group membership takes effect for $me at its next login." >&2
  fi
}

# Resolve every selected build's config before the commit, so a bad config commits nothing.
if [ "$BUILD_STANDARD" = true ]; then
  read -r -a STD_TASKS <<< "$("$_BA_INFO" tasks standard)" || exit 1
fi
if [ "$BUILD_TEST" = true ]; then
  read -r -a TEST_TASKS <<< "$("$_BA_INFO" tasks test)" || exit 1
fi
if [ "$BUILD_PLAY" = true ]; then
  if [ ! -t 0 ]; then
    if [ "$FLAG_SEEN" = false ]; then
      echo "ERROR: no build flags given, so all three builds are selected, including Play; stdin is not a terminal," >&2
    else
      echo "ERROR: the Play build is selected but stdin is not a terminal," >&2
    fi
    echo "  and it must prompt for the upload keystore passwords." >&2
    echo "  Unattended or agent runs: select builds explicitly, e.g. ./build_app --standard --test ..." >&2
    exit 1
  fi
  RELEASE_KEYSTORE=$(play_key release_keystore)
  RELEASE_KEY_ALIAS=$(play_key release_key_alias)
  RELEASE_BUNDLE_TASK=$(play_key release_bundle_task)
  AAB=$(play_key release_bundle_path)
  _ba_missing=""
  [ -z "$RELEASE_KEYSTORE" ] && _ba_missing="$_ba_missing release_keystore"
  [ -z "$RELEASE_KEY_ALIAS" ] && _ba_missing="$_ba_missing release_key_alias"
  [ -z "$RELEASE_BUNDLE_TASK" ] && _ba_missing="$_ba_missing release_bundle_task"
  [ -z "$AAB" ] && _ba_missing="$_ba_missing release_bundle_path"
  if [ -n "$_ba_missing" ]; then
    if [ "$SINGLE_USER" = false ]; then
      echo "ERROR: the Play build is selected but these keys are unset in $(pwd)/project.config:$_ba_missing" >&2
    else
      echo "ERROR: the Play build is selected in single-user mode; these signing keys were not given:$_ba_missing" >&2
      echo "  Pass them with --signing-config FILE (key=value lines) or --release-keystore, --release-key-alias," >&2
      echo "  --release-bundle-task, --release-bundle-path (no project.config is read for them)." >&2
    fi
    echo "  Example: release_keystore=/home/$PRIMARY_USER/keys/<app>-upload.jks" >&2
    echo "           release_key_alias=upload" >&2
    echo "           release_bundle_task=bundlePlayRelease" >&2
    echo "           release_bundle_path=app/build/outputs/bundle/playRelease/app-play-release.aab" >&2
    echo "  The keystore and passwords stay on this machine. Or select builds explicitly (e.g. --standard --test)." >&2
    exit 1
  fi
  if [[ "$RELEASE_KEYSTORE" != /* ]]; then
    echo "ERROR: release_keystore must be an absolute path: $RELEASE_KEYSTORE" >&2
    exit 1
  fi
  if [ ! -r "$RELEASE_KEYSTORE" ]; then
    echo "ERROR: $(id -un) cannot read release_keystore $RELEASE_KEYSTORE." >&2
    keystore_access_report "$RELEASE_KEYSTORE"
    exit 1
  fi
  if [ ! -f "$RELEASE_KEYSTORE" ]; then
    echo "ERROR: release_keystore is not a regular file: $RELEASE_KEYSTORE" >&2
    exit 1
  fi
  KS_MODE=$(stat -L -c %a "$RELEASE_KEYSTORE") || exit 1
  if [ "${KS_MODE: -1}" != "0" ]; then
    echo "WARNING: $RELEASE_KEYSTORE is mode $KS_MODE (world-accessible). Fix: chmod o= '$RELEASE_KEYSTORE'" >&2
  fi
  read -r -a RELEASE_GRADLE_ARGS <<< "$(play_key release_gradle_args)"
  check_play_link "$AAB"
fi

# ai-shared + ai-code required (agent caches are ai-coder:ai-code). Do not sg one group.
if [ "$SINGLE_USER" = false ]; then
MISSING=""
for grp in ai-shared ai-code; do
  if ! id -nG | grep -qw "$grp"; then MISSING="$MISSING $grp"; fi
done
if [ -n "$MISSING" ]; then
  echo "ERROR: this shell is missing project group(s):$MISSING" >&2
  echo "  Fix:  source ./env   (refreshes this shell's groups)" >&2
