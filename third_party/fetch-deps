#!/usr/bin/env bash
# third_party/fetch-deps — consumer-side pin / rw / upgrade materialize
# Design: @@SANDBOX_PATH@@/research/third-party-fetch-deps-design-20260802.md
#
# Defaults simple:
#   fetch-deps [name…]           # ro pin @ libpin.toml git_sha (patches, then chmod a-w)
#   fetch-deps rw [name…]        # writable branch = VE branch, base = pin sha
#   fetch-deps ro [name…]        # back to pin
#   fetch-deps status [-v|-vv]
#   fetch-deps refresh [name…]   # advance pin to library master tip (explicit)
#   fetch-deps upgrade NAME --ref REF
#   fetch-deps build [name…]     # run build[] then get-artifacts
#
# Pin file: third_party/<name>/libpin.toml
# Transport (git pins): prefer linked worktree of $GIT_HOME/<lib> when host has pin
#   commit; else HTTPS clone (git_https). SSH only with --allow-ssh.
# Transport (non-git pins): [[source]] rows — HTTPS/HTTP download or local seed/file
#   with required sha256. Never git@ / scp / SSH for source rows (even with --allow-ssh).
# Sandbox: third_party/<lib>/… plus only $GIT_HOME/<lib>/.git (never whole GIT_HOME).
#
# git_home=@@GIT_HOME@@ smudged from project.config; runtime export GIT_HOME.
# Override: --git-home DIR. Unsubstituted token / missing host → network clone.
#
# Sandbox (optional; Linux):
#   bubblewrap and/or Landlock via libpin-sandbox
#   materialize (ro/rw)  → write under third_party/<lib>/ (+ host .git if linked)
#   patches + build      → write under third_party/<lib>/src/
#   get-artifacts        → write under third_party/<lib>/artifact/
# Disable: LIBPIN_NO_BWRAP=1 LIBPIN_NO_LANDLOCK=1 or --no-bwrap / --no-landlock
#
# Commands in detail:
#   upgrade NAME --ref REF  try ref, build, collect artifacts, update libpin.toml
#     (git_sha, git_describe and every changed [[artifact]] sha256; a pin with
#     reproducible = true is built a second time and must give the same bytes)
#   build   runs build[] from libpin.toml, then get-artifacts (artifacts must match sha256)
#   --record: write the new [[artifact]] sha256 values into libpin.toml instead of
#     failing on them (old -> new printed per row)
#
# libpin.toml = pin contract only (no checkout mode). Mode is status.local (gitignored).
#
# Non-git pins ([[source]] tables):
#   url      https://… | http://… | file:relative | file:///abs  (no git@ / ssh)
#   seed     path under third_party/<lib>/ (copy; same as file: seed)
#   path     destination under third_party/<lib>/src/
#   sha256   required content hash (hex)
#
# Sandbox write surfaces (missing tools → unsandboxed, still correct):
#   materialize + status.local  write → third_party/<lib>/  (mode=lib)
#   patches                     write → third_party/<lib>/src/ only
#   build steps                 write → third_party/<lib>/src/ only
#   get-artifacts               write → third_party/<lib>/artifact/ only
#   Landlock: mutation rights only (read/exec unrestricted). Stacks under bwrap.
#   bubblewrap: single-level only (no nest). libpin-sandbox = bwrap outer + landlock inner.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VE_ROOT="$(cd "$ROOT/.." && pwd)"
CMD=""
ALLOW_SSH=0
NO_BWRAP=0
NO_LANDLOCK=0
DEPTH=""
BASE_REF=""
BRANCH_OVERRIDE=""
REF_UPGRADE=""
RECORD=0
VERBOSE=0
NAMES=()
FAILURES=0
# Smudged LHS must be lowercase git_home= so filter-clean-config restores @@GIT_HOME@@.
# (project.config key is git_home=; do not use GIT_HOME= for the stamped line.)
git_home=@@GIT_HOME@@
WORKTREE_SEARCH="${WORKTREE_SEARCH:-}"

USAGE_LINE="usage: fetch-deps [-h] [COMMAND] [options] [NAME...]"
usage() {
  cat <<EOF
$USAGE_LINE

Materialize, switch and upgrade the third_party pins listed in each
third_party/<name>/libpin.toml.

commands:
  (none), ro     read-only checkout at the pinned commit or files
  rw             writable branch at the pin (default: this checkout's branch)
  status         show mode, HEAD, pin and dirty state (-v / -vv for more)
  refresh        advance the pin to the library's master tip, then ro (git pins)
  upgrade NAME   try --ref REF, build, collect artifacts, update libpin.toml
  build          run build[] from libpin.toml, then collect artifacts

options:
  -h, --help            show this help message and exit
  --allow-ssh           permit git@ for git transport only
  --git-home DIR        override the smudged git_home
  --branch NAME         rw branch name
  --base REF            rw base (default: the pinned git_sha)
  --ref REF             upgrade source ref
  --depth N             shallow clone depth (default: full)
  --record              build: write new artifact sha256 values to libpin.toml
  --worktree-search P   extra local roots (colon-separated)
  --no-bwrap            do not use bubblewrap (or LIBPIN_NO_BWRAP=1)
  --no-landlock         do not use Landlock (or LIBPIN_NO_LANDLOCK=1)
  -v, -vv               status verbosity

Transport, non-git pins and sandbox write surfaces: the comment at the top of
fetch-deps.
EOF
}

bad_option() {
  echo "$USAGE_LINE" >&2
  echo "fetch-deps: error: unrecognized option: $1" >&2
  exit 2
}

# --- parse ---
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    ro|rw|status|refresh|upgrade|build)
      if [[ -z "$CMD" ]]; then CMD="$1"; shift; else NAMES+=("$1"); shift; fi ;;
    --allow-ssh) ALLOW_SSH=1; shift ;;
    --no-bwrap) NO_BWRAP=1; shift ;;
    --no-landlock) NO_LANDLOCK=1; shift ;;
    --git-home) git_home="$2"; shift 2 ;;
    --branch) BRANCH_OVERRIDE="$2"; shift 2 ;;
    --base) BASE_REF="$2"; shift 2 ;;
    --ref) REF_UPGRADE="$2"; shift 2 ;;
    --depth) DEPTH="$2"; shift 2 ;;
    --record) RECORD=1; shift ;;
    --worktree-search) WORKTREE_SEARCH="$2"; shift 2 ;;
    -vv) VERBOSE=2; shift ;;
    -v) VERBOSE=1; shift ;;
    --) shift; break ;;
    -*) bad_option "$1" ;;
    *) NAMES+=("$1"); shift ;;
  esac
done
while [[ $# -gt 0 ]]; do NAMES+=("$1"); shift; done

CMD="${CMD:-ro}"

# Runtime export name (children / messages). Sourced from smudged git_home=.
GIT_HOME="${git_home:-}"

# Unsubstituted smudge token → no host (network clone only).
if [[ -z "${GIT_HOME}" || "$GIT_HOME" == @@* || "$GIT_HOME" == *"@@"* ]]; then
  if [[ -n "${GIT_HOME}" && "$GIT_HOME" == *"@@"* ]]; then
    echo "fetch-deps: note: git_home still has smudge token ($GIT_HOME) — host clone disabled; using network" >&2
  fi
  GIT_HOME=""
  git_home=""
fi

if [[ "$NO_BWRAP" -eq 1 ]]; then
  export LIBPIN_NO_BWRAP=1
fi
if [[ "$NO_LANDLOCK" -eq 1 ]]; then
  export LIBPIN_NO_LANDLOCK=1
fi
export GIT_HOME

# Optional Landlock + bwrap via libpin-sandbox (falls back to bare if neither works).
# Host .git for this lib is auto-narrowed inside libpin-sandbox when GIT_HOME is set.
sandbox_run() {
  local mode="$1" name="$2"
  shift 2
  if [[ -x "$ROOT/libpin-sandbox" ]]; then
    "$ROOT/libpin-sandbox" --mode "$mode" --lib "$name" -- "$@"
  else
    "$@"
  fi
}

# Absolute env for sandbox re-entry. The sandbox wrappers exec by PATH lookup, and an empty
# PATH entry (cwd) would find a project's own ./env script instead of env(1).
ENV_BIN=/usr/bin/env
[[ -x "$ENV_BIN" ]] || { echo "fetch-deps: $ENV_BIN not found (needed for sandbox re-entry)" >&2; exit 1; }

# Preserve GIT_HOME across single-level sandbox re-entry of this script.
reenter_args() {
  REENTER_GH=()
  [[ -n "${GIT_HOME:-}" ]] && REENTER_GH=(--git-home "$GIT_HOME")
}
bwrap_lib() {
  local name="$1"; shift
  sandbox_run lib "$name" "$@"
}
bwrap_src() {
  local name="$1"; shift
  sandbox_run src "$name" "$@"
}
bwrap_artifact() {
  local name="$1"; shift
  sandbox_run artifact "$name" "$@"
}

if [[ "$CMD" != "status" && "$CMD" != "upgrade" && ${#NAMES[@]} -eq 0 ]]; then
  for d in "$ROOT"/*/; do
    [[ -f "${d}libpin.toml" ]] || continue
    base="$(basename "$d")"
    [[ "$base" == "rclone" || "$base" == "paddle" || "$base" == "example" ]] && continue
    NAMES+=("$base")
  done
fi
if [[ "$CMD" == "upgrade" ]]; then
  [[ ${#NAMES[@]} -eq 1 ]] || { echo "upgrade needs exactly one NAME" >&2; exit 2; }
  [[ -n "$REF_UPGRADE" ]] || { echo "upgrade needs --ref" >&2; exit 2; }
fi
if [[ ${#NAMES[@]} -eq 0 && "$CMD" != "status" ]]; then
  echo "fetch-deps: no libraries with libpin.toml" >&2
  exit 2
fi
if [[ "$CMD" == "status" && ${#NAMES[@]} -eq 0 ]]; then
  for d in "$ROOT"/*/; do
    [[ -f "${d}libpin.toml" ]] && NAMES+=("$(basename "$d")")
  done
fi

ve_branch() {
  git -C "$VE_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown"
}

# Read a top-level scalar from libpin.toml (or status.local key: value).
pin_get() {
  local file="$1" key="$2"
  [[ -r "$file" ]] || return 1
  if [[ "$file" == *.toml ]]; then
    python3 - "$file" "$key" <<'PY'
import sys
try:
    import tomllib
except ImportError:
    import tomli as tomllib  # type: ignore
from pathlib import Path
data = tomllib.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
key = sys.argv[2]
v = data.get(key)
if v is None:
    sys.exit(3)  # key absent (pin_get_opt tells this apart from an error)
if isinstance(v, bool):
    print("true" if v else "false")
elif isinstance(v, list):
    # join for simple consumers; use pin_get_list for arrays
    print("\n".join(str(x) for x in v))
else:
    print(v)
PY
  else
    # status.local still uses simple key: value
    sed -n "s/^${key}:[[:space:]]*//p" "$file" | head -1 | sed 's/^["'\'']//;s/["'\'']$//'
  fi
}

# Optional TOML key: prints the value, or nothing when the key is absent (exit 3 of
# pin_get). An unreadable or unparsable pin is an error, never "absent".
pin_get_opt() {
  local file="$1" key="$2" out rc=0
  [[ "$file" == *.toml ]] || { echo "fetch-deps: pin_get_opt needs a .toml pin, got $file" >&2; return 2; }
  [[ -r "$file" ]] || { echo "fetch-deps: cannot read $file" >&2; return 2; }
  # rc from the assignment itself: after 'if …; fi' $? is 0, which hid every failure.
  out="$(pin_get "$file" "$key")" || rc=$?
  if [[ "$rc" -eq 0 ]]; then
    printf '%s\n' "$out"
    return 0
  fi
  [[ "$rc" -eq 3 ]] && return 0
  echo "fetch-deps: reading $key from $file failed (exit $rc)" >&2
  return "$rc"
}

# Print build steps one per line (TOML build = ["...", ...]).
# Missing key → default ./build. Explicit build = [] → no steps (file pins).
pin_build_steps() {
  local file="$1"
  python3 - "$file" <<'PY'
import sys
try:
    import tomllib
except ImportError:
    import tomli as tomllib  # type: ignore
from pathlib import Path
data = tomllib.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
if "build" not in data:
    steps = ["./build"]
else:
    steps = data.get("build")
    if steps is None:
        steps = []
    elif isinstance(steps, str):
        steps = [steps]
for s in steps or []:
    if s:
        print(s)
PY
}

is_real_sha() {
  local s="${1:-}"
  [[ -n "$s" && "$s" != "TBD" && "$s" != "null" && "$s" =~ ^[0-9a-fA-F]{7,40}$ ]]
}

# True if path is a usable git work tree / repo (has .git file or dir).
is_git_repo() {
  local p="${1:-}"
  [[ -n "$p" && ( -d "$p/.git" || -f "$p/.git" ) ]] && git -C "$p" rev-parse --git-dir >/dev/null 2>&1
}

# Resolve host repo for lib name under GIT_HOME (or WORKTREE_SEARCH). Empty GIT_HOME → fail.
local_repo_for() {
  local name="$1" p
  if [[ -n "${GIT_HOME}" ]]; then
    p="$GIT_HOME/$name"
    if is_git_repo "$p"; then
      echo "$p"; return 0
    fi
    if [[ -e "$p" ]]; then
      echo "    note: GIT_HOME host $p is not a valid git repo — ignoring" >&2
    fi
  fi
  if [[ -n "$WORKTREE_SEARCH" ]]; then
    local IFS=':'
    for p in $WORKTREE_SEARCH; do
      [[ -z "$p" ]] && continue
      if is_git_repo "$p/$name"; then
        echo "$p/$name"; return 0
      fi
    done
  fi
  return 1
}

# Host usable for this pin SHA? Prints host path on success; reports and fails otherwise.
local_repo_with_commit() {
  local name="$1" sha="$2" host
  if ! host="$(local_repo_for "$name")"; then
    return 1
  fi
  if [[ -n "$sha" ]] && ! repo_has_commit "$host" "$sha"; then
    echo "    note: host $host lacks commit $sha — will try network clone" >&2
    return 1
  fi
  echo "$host"
  return 0
}

pin_path() { echo "$ROOT/$1/libpin.toml"; }
# legacy alias during transition
lock_path() { pin_path "$1"; }
src_path() { echo "$ROOT/$1/src"; }
status_path() { echo "$ROOT/$1/status.local"; }
# alias used by older call sites
yaml_get() { pin_get "$@"; }

write_status() {
  local name="$1" mode="$2" branch="${3:-}" head="${4:-}" extra="${5:-}"
  local sp
  sp="$(status_path "$name")"
  cat >"$sp" <<EOF
# gitignored — written by fetch-deps; not the pin contract
name: $name
mode: $mode
branch: $branch
head: $head
ve_branch: $(ve_branch)
git_home: $GIT_HOME
updated: $(date -Is)
$extra
EOF
  set_mode_group "$sp"
}

# 664, group ai-code; changes only what differs and fails loudly (a file of another
# user that is already right is left alone).
set_mode_group() {
  local f="$1" cur
  cur="$(stat -c '%a %G %U' -- "$f")" || exit 1
  if [[ "${cur%% *}" != 664 ]]; then
    chmod 664 -- "$f" || { echo "fetch-deps: chmod 664 $f failed (now ${cur}; you are $(id -un))" >&2; exit 1; }
  fi
  cur="$(stat -c '%G' -- "$f")" || exit 1
  if [[ "$cur" != ai-code ]]; then
    chgrp ai-code -- "$f" || { echo "fetch-deps: chgrp ai-code $f failed (group $cur; you are $(id -un))" >&2; exit 1; }
  fi
}

repo_has_commit() {
  git -C "$1" cat-file -e "${2}^{commit}" 2>/dev/null
}

# Detach at pin sha and discard local mods so patches re-apply cleanly.
# Keeps untracked build products (bin/, build/, android/.gradle*) for iterate.
checkout_pin_clean() {
  local src="$1" sha="$2"
  git -C "$src" checkout --detach "$sha" 2>/dev/null || return 1
  git -C "$src" reset --hard "$sha" 2>/dev/null || return 1
  return 0
}

# Linked worktree: .git is a file pointing at host gitdir (outside third_party/).
is_linked_worktree() {
  [[ -f "${1:-}/.git" ]]
}

# Prefer git_https origin; never leave git@ as fetch URL unless --allow-ssh only path.
set_origin_https() {
  local src="$1" url="$2"
  [[ -n "$url" && -d "$src" ]] || return 0
  set_origin "$src" "$url"
}

# Point origin of a standalone src clone at url. A linked worktree shares the
# library host's config, so its origin is the host's business: left alone.
set_origin() {
  local src="$1" url="$2" cur
  if is_linked_worktree "$src"; then
    return 0
  fi
  if cur="$(git -C "$src" config --get remote.origin.url)"; then
    [[ "$cur" == "$url" ]] && return 0
    git -C "$src" remote set-url origin "$url" || { echo "fetch-deps: git remote set-url origin $url in $src failed" >&2; exit 1; }
  else
    git -C "$src" remote add origin "$url" || { echo "fetch-deps: git remote add origin $url in $src failed" >&2; exit 1; }
  fi
}

# Drop a linked worktree checkout and clear host registration when possible.
remove_linked_worktree_src() {
  local name="$1" src="$2" host
  ensure_writable_tree "$src"
  if host="$(local_repo_for "$name" 2>/dev/null)"; then
    # Under the sandbox without LIBPIN_ALLOW_GIT_HOME the host's .git is read-only, so
    # this can fail; rm -rf below still frees the pin path, and the message says what
    # is left behind.
    if ! git -C "$host" worktree remove --force "$src"; then
      echo "fetch-deps: $host still lists worktree $src (git worktree remove failed above);" >&2
      echo "  it is removed from disk next. Clear the entry later with: git -C $host worktree prune" >&2
    fi
  fi
  rm -rf "$src"
}

ensure_writable_tree() {
  local src="$1"
  [[ -d "$src" ]] || return 0
  chmod -R u+w -- "$src" || { echo "fetch-deps: chmod -R u+w $src failed (you are $(id -un))" >&2; exit 1; }
}

make_readonly_tree() {
  local src="$1"
  [[ -d "$src" ]] || return 0
  # keep .git metadata writable for future fetch-deps
  local rc=0
  if [[ -d "$src/.git" ]]; then
    find "$src" -path "$src/.git" -prune -o -type f -exec chmod a-w {} + || rc=1
    find "$src" -path "$src/.git" -prune -o -type d -exec chmod u+rwx,go+rx {} + || rc=1
  elif [[ -f "$src/.git" ]]; then
    find "$src" -type f ! -name .git -exec chmod a-w {} + || rc=1
  else
    # Non-git file pins: whole tree RO
    find "$src" -type f -exec chmod a-w {} + || rc=1
    find "$src" -type d -exec chmod u+rwx,go+rx {} + || rc=1
  fi
  [[ "$rc" -eq 0 ]] || { echo "fetch-deps: making $src read-only failed (messages above; you are $(id -un))" >&2; exit 1; }
}

# True if libpin.toml has one or more [[source]] tables.
pin_has_sources() {
  local file="$1"
  python3 - "$file" <<'PY'
import sys
try:
    import tomllib
except ImportError:
    import tomli as tomllib  # type: ignore
from pathlib import Path
data = tomllib.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
sys.exit(0 if data.get("source") else 1)
PY
}

# True if pin is git-backed (usable git_sha or git remotes, or seed-src).
pin_is_git() {
  local file="$1" sha https ssh kind
  kind="$(pin_get_opt "$file" source_kind)" || exit 1
  if [[ "$kind" == "files" || "$kind" == "file" || "$kind" == "http" ]]; then
    return 1
  fi
  sha="$(pin_get_opt "$file" git_sha)" || exit 1
  if is_real_sha "$sha"; then
    return 0
  fi
  https="$(pin_get_opt "$file" git_https)" || exit 1
  ssh="$(pin_get_opt "$file" git_ssh)" || exit 1
  [[ -n "$https" && "$https" != "null" ]] && return 0
  [[ -n "$ssh" && "$ssh" != "null" && "$ssh" != "" ]] && return 0
  return 1
}

# Print [[source]] rows as: path|sha256|url|seed
# Use | (not TAB): bash IFS tab is "whitespace" and collapses empty fields.
pin_source_rows() {
  local file="$1"
  python3 - "$file" <<'PY'
import sys
try:
    import tomllib
except ImportError:
    import tomli as tomllib  # type: ignore
from pathlib import Path
data = tomllib.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
for s in data.get("source") or []:
    if not isinstance(s, dict):
        continue
    path = (s.get("path") or "").strip()
    sha = (s.get("sha256") or "").strip().lower()
    url = (s.get("url") or "").strip()
    seed = (s.get("seed") or "").strip()
    if not path:
        print("fetch-deps: [[source]] missing path", file=sys.stderr)
        sys.exit(2)
    if not sha:
        print(f"fetch-deps: [[source]] {path} missing sha256", file=sys.stderr)
        sys.exit(2)
    if "|" in path or "|" in url or "|" in seed:
        print(f"fetch-deps: [[source]] fields must not contain |: {path}", file=sys.stderr)
        sys.exit(2)
    print(f"{path}|{sha}|{url}|{seed}")
PY
}

# Reject SSH / scp / git@ URLs for non-git source rows (never allowed).
source_url_is_forbidden() {
  local u="$1"
  [[ -z "$u" ]] && return 1
  case "$u" in
    git@*|ssh://*|scp://*|*@*:*) return 0 ;;
    *) return 1 ;;
  esac
}

file_sha256() {
  sha256sum "$1" | awk '{print $1}'
}

# Download or copy one source row into dest path; verify sha256.
# Args: name path sha256 url seed
fetch_one_source() {
  local name="$1" relpath="$2" expect_sha="$3" url="$4" seed="$5"
  local pin_dir="$ROOT/$name"
  local dest src_tmp resolved=""
  dest="$(src_path "$name")/$relpath"
  mkdir -p "$(dirname "$dest")"
  ensure_writable_tree "$(dirname "$dest")"

  expect_sha="$(echo "$expect_sha" | tr 'A-F' 'a-f')"

  # Already present and hash-ok → skip. Stale cache: one re-fetch then hard fail
  # (pin is content-addressed — we never loop forever waiting for a moving URL).
  local had_stale=0
  if [[ -f "$dest" ]]; then
    local have
    have="$(file_sha256 "$dest")"
    if [[ "$have" == "$expect_sha" ]]; then
      echo "    source ok (cached) $relpath"
      return 0
    fi
    echo "    note: $relpath cache hash mismatch (have $have want $expect_sha) — one re-fetch" >&2
    rm -f "$dest"
    had_stale=1
  fi

  if source_url_is_forbidden "$url"; then
    echo "    FAIL: [[source]] refuses SSH/git@ URL for $relpath: $url" >&2
    return 1
  fi

  # Prefer seed (pin-local), then file: URL, then http(s). Single attempt only.
  if [[ -n "$seed" ]]; then
    if [[ "$seed" = /* ]]; then
      resolved="$seed"
    else
      resolved="$pin_dir/$seed"
    fi
    if [[ ! -f "$resolved" ]]; then
      echo "    FAIL: seed not found: $resolved" >&2
      return 1
    fi
    echo "    source seed $seed → $relpath"
    cp -a "$resolved" "$dest"
  elif [[ -n "$url" ]]; then
    case "$url" in
      file:/*)
        # file:///abs/path
        resolved="${url#file://}"
        # file://localhost/path or file:///path
        [[ "$resolved" == localhost/* ]] && resolved="/${resolved#localhost/}"
        if [[ ! -f "$resolved" ]]; then
          echo "    FAIL: file URL not found: $resolved" >&2
          return 1
        fi
        echo "    source file $resolved → $relpath"
        cp -a "$resolved" "$dest"
        ;;
      file:*)
        # file:relative under pin dir
        resolved="$pin_dir/${url#file:}"
        if [[ ! -f "$resolved" ]]; then
          echo "    FAIL: file: relative not found: $resolved" >&2
          return 1
        fi
        echo "    source file:$resolved → $relpath"
        cp -a "$resolved" "$dest"
        ;;
      https://*|http://*)
        # Download beside the destination (same dir, so mv is a rename); never /tmp.
        src_tmp="$(mktemp "$(dirname "$dest")/.$(basename "$dest").download.XXXXXX")" || { echo "    FAIL: cannot create a temp file beside $dest" >&2; return 1; }
        echo "    source fetch $url → $relpath"
        if command -v curl >/dev/null 2>&1; then
          if ! curl -fsSL --proto '=https,http' --proto-redir '=https,http' -o "$src_tmp" "$url"; then
            rm -f "$src_tmp"
            echo "    FAIL: curl download $url" >&2
            return 1
          fi
        elif command -v wget >/dev/null 2>&1; then
          if ! wget -q -O "$src_tmp" "$url"; then
            rm -f "$src_tmp"
            echo "    FAIL: wget download $url" >&2
            return 1
          fi
        else
          rm -f "$src_tmp"
          echo "    FAIL: need curl or wget for $url" >&2
          return 1
        fi
        mv "$src_tmp" "$dest"
        ;;
      *)
        echo "    FAIL: unsupported [[source]] url scheme for $relpath: $url" >&2
        echo "    (allowed: https://, http://, file:, or seed=)" >&2
        return 1
        ;;
    esac
  else
    echo "    FAIL: [[source]] $relpath needs url= or seed=" >&2
    return 1
  fi

  local got
  got="$(file_sha256 "$dest")"
  if [[ "$got" != "$expect_sha" ]]; then
    echo "    FAIL: sha256 permanent mismatch for $relpath (pin is content-addressed)" >&2
    echo "      want (libpin.toml) $expect_sha" >&2
    echo "      got  (fetched)     $got" >&2
    if [[ -n "$seed" ]]; then
      echo "      cause: seed/file content does not match pin; fix seed or update sha256" >&2
    elif [[ -n "$url" ]]; then
      echo "      cause: URL body changed or wrong sha in pin; pin a new sha256 (do not wait for URL to revert)" >&2
    fi
    [[ "$had_stale" -eq 1 ]] && echo "      (cache was stale; one re-fetch still mismatched — not retrying again)" >&2
    rm -f "$dest"
    return 1
  fi
  echo "    source verified $relpath ($got)"
  return 0
}

# Materialize all [[source]] rows into third_party/<name>/src/
materialize_sources() {
  local name="$1" lock relpath sha url seed n=0
  lock="$(lock_path "$name")"
  pin_has_sources "$lock" || return 0
  echo "    materialize [[source]] for $name"
  while IFS='|' read -r relpath sha url seed; do
    [[ -z "$relpath" ]] && continue
    fetch_one_source "$name" "$relpath" "$sha" "$url" "$seed" || return 1
    n=$((n + 1))
  done < <(pin_source_rows "$lock")
  [[ "$n" -gt 0 ]] || {
    echo "    FAIL: [[source]] present but no rows parsed" >&2
    return 1
  }
  echo "    sources: $n file(s) under $(src_path "$name")"
  return 0
}

apply_patches() {
  local name="$1" src="$2" pin="$3"
  local pdir="$ROOT/$name/patches"
  [[ -d "$pdir" ]] || return 0
  local f
  shopt -s nullglob
  for f in "$pdir"/*.patch "$pdir"/*.diff; do
    [[ -f "$f" ]] || continue
    echo "    apply patch $(basename "$f")  [sandbox=src]"
    # Files this patch creates may be left untracked by an earlier apply (reset --hard keeps untracked
    # files); remove them so the patch applies again instead of failing with "already exists".
    local created
    while IFS= read -r created; do
      [[ -n "$created" ]] || continue
      if [[ -e "$src/$created" ]] && ! git -C "$src" ls-files --error-unmatch -- "$created" >/dev/null 2>&1; then
        echo "    remove stale untracked $created (created by $(basename "$f"))"
        rm -f -- "$src/$created"
      fi
    done < <({ git -C "$src" apply --summary "$f" 2>/dev/null | sed -n 's/^ create mode [0-9]* //p'
               # diff -ruN style new files have no "new file mode", only a first hunk at -0,0.
               awk '/^\+\+\+ /{p=$2; sub(/^b\//,"",p); next} /^@@ -0,0 /{if(p!=""){print p; p=""}} /^@@/{p=""}' "$f"; } | sort -u)
    if ! bwrap_src "$name" bash -c "cd $(printf %q "$src") && git apply --whitespace=nowarn $(printf %q "$f")"; then
      echo "    FAIL: patch $f" >&2
      return 1
    fi
  done
  shopt -u nullglob
  return 0
}

list_patch_files() {
  local name="$1"
  local pdir="$ROOT/$name/patches"
  [[ -d "$pdir" ]] || return 0
  shopt -s nullglob
  local f
  for f in "$pdir"/*.patch "$pdir"/*.diff; do
    [[ -f "$f" ]] && echo "$f"
  done
  shopt -u nullglob
}

materialize_at_sha() {
  local name="$1" sha="$2" src url_https url_ssh host
  src="$(src_path "$name")"
  url_https="$(yaml_get "$(lock_path "$name")" git_https || true)"
  url_ssh="$(yaml_get "$(lock_path "$name")" git_ssh || true)"
  [[ "$url_https" == "null" ]] && url_https=""
  [[ "$url_ssh" == "null" ]] && url_ssh=""

  # Local toy pins (seed-src, no remote) — always re-seed for a clean base before patches
  if [[ -x "$ROOT/$name/seed-src" && -z "$url_https" && -z "$url_ssh" ]]; then
    echo "    seed-src (no remote)"
    ensure_writable_tree "$src"
    rm -rf "$src"
    ( cd "$ROOT/$name" && ./seed-src ) || return 1
    return 0
  fi

  ensure_writable_tree "$src"

  # --- Prefer linked worktree of host repo (one object store) ---
  if host="$(local_repo_with_commit "$name" "$sha")"; then
    if is_linked_worktree "$src"; then
      if repo_has_commit "$src" "$sha" && checkout_pin_clean "$src" "$sha"; then
        echo "    linked worktree checkout @ $sha (host $host)"
        return 0
      fi
      echo "    note: linked worktree cannot reach $sha — recreate" >&2
      remove_linked_worktree_src "$name" "$src"
    elif [[ -d "$src/.git" ]]; then
      # Existing standalone: try local checkout first (no forced convert)
      set_origin_https "$src" "$url_https"
      if repo_has_commit "$src" "$sha" && checkout_pin_clean "$src" "$sha"; then
        echo "    checkout existing standalone src @ $sha"
        set_origin_https "$src" "$url_https"
        return 0
      fi
      echo "    note: replacing standalone src with linked worktree from $host"
      rm -rf "$src"
    elif [[ -e "$src" ]]; then
      rm -rf "$src"
    fi
    mkdir -p "$(dirname "$src")"
    # A removed consumer tree can leave the host's registration for this exact path behind
    # ("prunable"); git then refuses the add. Pruning it is the defined repair.
    if git -C "$host" worktree list --porcelain | awk -v p="$src" '
        /^worktree /{w=substr($0,10)} /^prunable/{if (w==p) f=1} END{exit !f}'; then
      echo "    prune: $host has a dead worktree entry for $src (git worktree prune -v)"
      git -C "$host" worktree prune -v || { echo "    FAIL: git -C $host worktree prune" >&2; return 1; }
    fi
    echo "    worktree add --detach $src @ $sha (from $host)"
    local err
    if err=$(git -C "$host" worktree add --detach "$src" "$sha" 2>&1); then
      echo "    linked worktree OK @ $sha"
      return 0
    fi
    echo "    FAIL: worktree add from host $host: $err" >&2
    return 1
  fi

  # --- Existing standalone .git (no usable host) ---
  if [[ -d "$src/.git" ]]; then
    set_origin_https "$src" "$url_https"
    if repo_has_commit "$src" "$sha" && checkout_pin_clean "$src" "$sha"; then
      echo "    checkout existing src @ $sha (no network)"
      set_origin_https "$src" "$url_https"
      return 0
    fi
    # Network: HTTPS first (default). SSH only with --allow-ssh.
    local u tries=()
    [[ -n "$url_https" ]] && tries+=("$url_https")
    [[ "$ALLOW_SSH" -eq 1 && -n "$url_ssh" ]] && tries+=("$url_ssh")
    for u in "${tries[@]}"; do
      echo "    fetch $u"
      if [[ "$u" == https://* || "$u" == http://* ]]; then
        set_origin_https "$src" "$u"
      else
        set_origin "$src" "$u"
      fi
      # Fetch the pinned sha; a server that refuses fetch-by-sha gets a full fetch.
      # Both are shown; if neither brings the commit, the next URL is tried.
      if ! git -C "$src" fetch origin "$sha"; then
        echo "    fetch of $sha by id failed (above); fetching all refs from $u"
        git -C "$src" fetch origin || echo "    fetch from $u failed (above)" >&2
      fi
      if repo_has_commit "$src" "$sha" && checkout_pin_clean "$src" "$sha"; then
        set_origin_https "$src" "$url_https"
        return 0
      fi
    done
    echo "    FAIL: cannot obtain $sha" >&2
    return 1
  fi

  # --- Fresh clone (no local host repo with the pin commit) ---
  rm -rf "$src"
  mkdir -p "$(dirname "$src")"
  if [[ -n "${GIT_HOME}" ]] && ! local_repo_for "$name" >/dev/null; then
    echo "    note: no valid host repo at \$GIT_HOME/$name — full clone from network" >&2
  fi
  local u
  for u in $url_https; do
    [[ -n "$u" ]] || continue
    echo "    clone $u"
    local depth_args=()
    [[ -n "$DEPTH" ]] && depth_args=(--depth "$DEPTH")
    if git clone "${depth_args[@]}" "$u" "$src" 2>/dev/null; then
      if checkout_pin_clean "$src" "$sha" \
        || { git -C "$src" fetch origin "$sha" 2>/dev/null && checkout_pin_clean "$src" "$sha"; }; then
        set_origin_https "$src" "$url_https"
        return 0
      fi
    fi
    rm -rf "$src"
  done
  if [[ "$ALLOW_SSH" -eq 1 && -n "$url_ssh" ]]; then
    echo "    clone $url_ssh"
    if git clone "$url_ssh" "$src" 2>/dev/null; then
      if checkout_pin_clean "$src" "$sha"; then
        set_origin_https "$src" "$url_https"
        return 0
      fi
    fi
    rm -rf "$src"
  fi
  # Local-only toy pins (e.g. third_party/example) with no remote
  if [[ -x "$ROOT/$name/seed-src" ]]; then
    echo "    seed-src (no remote)"
    rm -rf "$src"
    ( cd "$ROOT/$name" && ./seed-src ) || return 1
    return 0
  fi
  echo "    FAIL: materialize $name" >&2
  return 1
}

resolve_pin_sha() {
  local name="$1" lock sha
  lock="$(lock_path "$name")"
  sha="$(yaml_get "$lock" git_sha || true)"
  if is_real_sha "$sha"; then
    RESOLVED_SHA="$sha"
    RESOLVED_DESCRIBE="$(yaml_get "$lock" git_describe || echo "$sha")"
    return 0
  fi
  local host
  if host="$(local_repo_for "$name")"; then
    if [[ -d "$host/master/.git" || -f "$host/master/.git" ]]; then
      RESOLVED_SHA="$(git -C "$host/master" rev-parse HEAD)"
    else
      RESOLVED_SHA="$(git -C "$host" rev-parse master 2>/dev/null || git -C "$host" rev-parse HEAD)"
    fi
    RESOLVED_DESCRIBE="$(git -C "$host" describe --tags --long --always "$RESOLVED_SHA" 2>/dev/null || echo "$RESOLVED_SHA")"
    return 0
  fi
  return 1
}

write_pin_sha() {
  local pin="$1" sha="$2" describe="$3"
  python3 - "$pin" "$sha" "$describe" <<'PY'
import sys
from pathlib import Path
path, sha, desc = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
text = path.read_text(encoding="utf-8")
import re
text2, n1 = re.subn(r'(?m)^git_sha\s*=\s*".*"', f'git_sha = "{sha}"', text, count=1)
text2, n2 = re.subn(r'(?m)^git_describe\s*=\s*".*"', f'git_describe = "{desc}"', text2, count=1)
if n1 == 0:
    text2 = f'git_sha = "{sha}"\n' + text2
if n2 == 0:
    text2 = text2.replace(f'git_sha = "{sha}"', f'git_sha = "{sha}"\ngit_describe = "{desc}"', 1)
path.write_text(text2)
PY
  set_mode_group "$pin"
}
write_lock_sha() { write_pin_sha "$@"; }

offer_mainish_retarget() {
  local name="$1" sha="$2" src host
  src="$(src_path "$name")"
  [[ -d "$src/.git" || -f "$src/.git" ]] || return 0
  # list branches containing sha (local remotes)
  local lines br
  lines="$(git -C "$src" branch -a --contains "$sha" 2>/dev/null | sed 's/^[* ]*//' || true)"
  [[ -n "$lines" ]] || return 0
  local mainish=()
  while IFS= read -r br; do
    [[ -z "$br" ]] && continue
    local low
    low="$(echo "$br" | tr '[:upper:]' '[:lower:]')"
    if [[ "$low" == *main* || "$low" == *master* ]]; then
      mainish+=("$br")
    fi
  done <<< "$lines"
  if [[ ${#mainish[@]} -gt 0 ]]; then
    echo "    note: pin $sha is reachable from main-ish branch(es): ${mainish[*]}"
    echo "    offer: if this was a feature branch pin that merged, update libpin.toml track_branch to a main-ish name (not automatic)."
  fi
}

cmd_ro() {
  local name="$1"
  # Single-level: re-enter self under lib sandbox (writes third_party/<lib>/ + host .git)
  if [[ "${LIBPIN_NO_BWRAP:-0}" != "1" && -z "${LIBPIN_SANDBOX:-}" && -x "$ROOT/libpin-bwrap" ]]; then
    echo "    [sandbox=lib $name]"
    reenter_args
    bwrap_lib "$name" "$ENV_BIN" LIBPIN_NO_BWRAP=1 LIBPIN_SANDBOX=lib ${GIT_HOME:+GIT_HOME="$GIT_HOME"} \
      "$ROOT/fetch-deps" --no-bwrap "${REENTER_GH[@]}" ro "$name"
    return $?
  fi
  local lock src sha kind="git"
  lock="$(lock_path "$name")"
  src="$(src_path "$name")"
  [[ -f "$lock" ]] || { echo "FAIL $name: no libpin.toml" >&2; return 1; }
  [[ -r "$lock" ]] || { echo "FAIL $name: cannot read libpin.toml" >&2; return 1; }
  echo "==> $name  mode=ro  GIT_HOME=$GIT_HOME"

  # --- Non-git file pins ([[source]] only, or source_kind=files) ---
  if ! pin_is_git "$lock"; then
    if ! pin_has_sources "$lock" && [[ ! -x "$ROOT/$name/seed-src" ]]; then
      echo "    FAIL: non-git pin needs [[source]] rows or seed-src" >&2
      return 1
    fi
    kind="files"
    echo "    pin=files (non-git [[source]])"
    ensure_writable_tree "$src"
    # Fresh-ish tree for pure file pins (keep if already hash-ok via fetch_one_source cache)
    mkdir -p "$src"
    if pin_has_sources "$lock"; then
      if ! materialize_sources "$name"; then return 1; fi
    elif [[ -x "$ROOT/$name/seed-src" ]]; then
      echo "    seed-src (no remote)"
      rm -rf "$src"
      ( cd "$ROOT/$name" && ./seed-src ) || return 1
    fi
    sha="files"
  else
    # --- Git pins (optional extra [[source]] layered into src after checkout) ---
    if ! resolve_pin_sha "$name"; then
      if [[ -x "$ROOT/$name/seed-src" ]]; then
        RESOLVED_SHA="seed"
      else
        echo "    FAIL: no git_sha in libpin.toml and no local host" >&2
        return 1
      fi
    fi
    sha="$RESOLVED_SHA"
    echo "    pin=$sha"
    if ! materialize_at_sha "$name" "$sha"; then return 1; fi
    ensure_writable_tree "$src"
    if ! apply_patches "$name" "$src" "$lock"; then return 1; fi
    if pin_has_sources "$lock"; then
      if ! materialize_sources "$name"; then return 1; fi
    fi
  fi

  local need_rw
  need_rw="$(pin_get "$lock" requires_writable_src 2>/dev/null || echo false)"
  if [[ "$need_rw" == "true" || "$need_rw" == "yes" || "$need_rw" == "1" ]]; then
    write_status "$name" "ro" "" "$sha" "kind: $kind"$'\n'"readonly: false  # requires_writable_src"
    echo "    WRITABLE SRC (requires_writable_src)"
  else
    make_readonly_tree "$src"
    write_status "$name" "ro" "" "$sha" "kind: $kind"$'\n'"readonly: true"
    echo "    READ-ONLY PIN: build scripts may chmod only build/bin dirs under src"
  fi
  if [[ "$kind" == "git" ]]; then
    offer_mainish_retarget "$name" "$sha"
    echo "    OK $name @ $(git -C "$src" rev-parse --short HEAD 2>/dev/null)"
  else
    echo "    OK $name (files pin, $(find "$src" -type f 2>/dev/null | wc -l) files)"
  fi
}

cmd_rw() {
  local name="$1"
  # lib sandbox + host .git for worktree add
  if [[ "${LIBPIN_NO_BWRAP:-0}" != "1" && -z "${LIBPIN_SANDBOX:-}" && -x "$ROOT/libpin-bwrap" ]]; then
    echo "    [sandbox=lib $name + host .git]"
    reenter_args
    bwrap_lib "$name" "$ENV_BIN" LIBPIN_NO_BWRAP=1 LIBPIN_SANDBOX=lib ${GIT_HOME:+GIT_HOME="$GIT_HOME"} \
      "$ROOT/fetch-deps" --no-bwrap "${REENTER_GH[@]}" rw "$name"
    return $?
  fi
  local lock src sha branch base host
  lock="$(lock_path "$name")"
  src="$(src_path "$name")"
  branch="${BRANCH_OVERRIDE:-$(ve_branch)}"
  [[ "$branch" != "HEAD" && -n "$branch" ]] || branch="work"
  echo "==> $name  mode=rw  branch=$branch  GIT_HOME=$GIT_HOME"

  # File pins: materialize sources writable (no git branch)
  if ! pin_is_git "$lock"; then
    if pin_has_sources "$lock"; then
      mkdir -p "$src"
      ensure_writable_tree "$src"
      materialize_sources "$name" || return 1
      ensure_writable_tree "$src"
      write_status "$name" "rw" "" "files" "kind: files"$'\n'"readonly: false"
      echo "    RW files pin (no git branch)"
      echo "    OK $name (files)"
      return 0
    fi
    echo "    FAIL: non-git pin needs [[source]] for rw" >&2
    return 1
  fi

  if ! resolve_pin_sha "$name"; then
    echo "    FAIL: need pin sha or local host for base" >&2
    return 1
  fi
  base="${BASE_REF:-$RESOLVED_SHA}"
  # Prefer worktree from library host
  if host="$(local_repo_for "$name")"; then
    ensure_writable_tree "$src"
    if [[ -d "$src" ]]; then
      if git -C "$host" worktree list 2>/dev/null | grep -q "$src"; then
        git -C "$host" worktree remove --force "$src" 2>/dev/null || rm -rf "$src"
      else
        rm -rf "$src"
      fi
    fi
    if git -C "$host" show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
      # branch exists — try worktree add
      if git -C "$host" worktree add "$src" "$branch" 2>/dev/null; then
        echo "    worktree existing branch $branch"
      else
        echo "    FAIL: cannot worktree add $branch (already checked out elsewhere?). Use --branch other-name" >&2
        return 1
      fi
    else
      if git -C "$host" worktree add -b "$branch" "$src" "$base" 2>/dev/null; then
        echo "    worktree new branch $branch @ $base"
      else
        echo "    worktree failed — clone fallback"
        host=""
      fi
    fi
  else
    host=""
  fi
  if [[ -z "$host" || ! -d "$src" ]]; then
    if ! materialize_at_sha "$name" "$base"; then return 1; fi
    ensure_writable_tree "$src"
    git -C "$src" checkout -B "$branch" "$base"
    echo "    clone/branch $branch @ $base"
  fi
  ensure_writable_tree "$src"
  # A failed patch must stop here: building a half-patched tree gives wrong artifacts.
  if ! apply_patches "$name" "$src" "$lock"; then
    echo "    FAIL $name: patch did not apply; tree left as is, nothing built" >&2
    return 1
  fi
  write_status "$name" "rw" "$branch" "$(git -C "$src" rev-parse HEAD)" "readonly: false"
  echo "    RW: commits OK on branch $branch — open library PR before VE pin promote"
  echo "    OK $name @ $(git -C "$src" rev-parse --short HEAD) branch=$branch"
}

cmd_status() {
  local name="$1"
  local lock src sp mode head locksha kind
  lock="$(lock_path "$name")"
  src="$(src_path "$name")"
  sp="$(status_path "$name")"
  locksha="$(yaml_get "$lock" git_sha 2>/dev/null || echo "?")"
  mode="?"; head="?"
  [[ -f "$sp" ]] && mode="$(yaml_get "$sp" mode || echo "?")"
  if pin_is_git "$lock"; then
    kind="git"
    if [[ -d "$src/.git" || -f "$src/.git" ]]; then
      head="$(git -C "$src" rev-parse --short HEAD 2>/dev/null || echo "?")"
    else
      head="(no src)"
    fi
  else
    kind="files"
    locksha="files"
    if [[ -d "$src" ]]; then
      head="files:$(find "$src" -type f 2>/dev/null | wc -l)"
    else
      head="(no src)"
    fi
  fi
  local dirty="n"
  if [[ "$kind" == "git" ]] && { [[ -d "$src/.git" ]] || [[ -f "$src/.git" ]]; }; then
    if [[ -n "$(git -C "$src" status --porcelain 2>/dev/null)" ]]; then dirty="Y"; fi
  elif [[ "$kind" == "files" && -d "$src" ]] && pin_has_sources "$lock"; then
    # dirty if any [[source]] path missing or hash mismatch
    local relpath sha url seed got
    while IFS='|' read -r relpath sha url seed; do
      [[ -z "$relpath" ]] && continue
      if [[ ! -f "$src/$relpath" ]]; then dirty="Y"; break; fi
      got="$(file_sha256 "$src/$relpath")"
      [[ "$got" != "$sha" ]] && { dirty="Y"; break; }
    done < <(pin_source_rows "$lock")
  fi
  echo "$name: mode=$mode kind=$kind head=$head pin=${locksha:0:12}… dirty=$dirty"
  if [[ "$VERBOSE" -ge 1 ]]; then
    [[ -f "$sp" ]] && sed 's/^/  /' "$sp"
    if [[ "$dirty" == "Y" && "$kind" == "git" ]]; then
      echo "  dirty files:"
      git -C "$src" status --short 2>/dev/null | sed 's/^/    /' || true
    fi
    if [[ "$kind" == "git" && "$head" != "(no src)" && -n "$locksha" && "$locksha" != "?" ]]; then
      if ! git -C "$src" rev-parse --verify "${locksha}^{commit}" >/dev/null 2>&1; then
        echo "  issue: lock sha not in src"
      elif [[ "$(git -C "$src" rev-parse HEAD)" != "$(git -C "$src" rev-parse "$locksha")" ]]; then
        echo "  issue: HEAD != lock sha (ok if mode=rw)"
      fi
    fi
    if [[ "$kind" == "files" ]] && pin_has_sources "$lock"; then
      while IFS='|' read -r relpath sha url seed; do
        [[ -z "$relpath" ]] && continue
        if [[ -f "$src/$relpath" ]]; then
          got="$(file_sha256 "$src/$relpath")"
          if [[ "$got" == "$sha" ]]; then
            echo "  source OK $relpath"
          else
            echo "  source BAD $relpath (want $sha got $got)"
          fi
        else
          echo "  source MISSING $relpath"
        fi
      done < <(pin_source_rows "$lock")
    fi
  fi
  if [[ "$VERBOSE" -ge 2 && "$kind" == "git" ]] && { [[ -d "$src/.git" ]] || [[ -f "$src/.git" ]]; }; then
    git -C "$src" status 2>/dev/null | sed 's/^/  /' || true
  fi
}

cmd_refresh() {
  local name="$1" host sha desc
  echo "==> $name  refresh pin from library master tip"
  if ! pin_is_git "$(lock_path "$name")"; then
    echo "    FAIL: refresh is git-only; file pins bump sha256 in libpin.toml by hand" >&2
    return 1
  fi
  if ! host="$(local_repo_for "$name")"; then
    echo "    FAIL: no local host $GIT_HOME/$name" >&2
    return 1
  fi
  if [[ -d "$host/master/.git" || -f "$host/master/.git" ]]; then
    sha="$(git -C "$host/master" rev-parse HEAD)"
  else
    sha="$(git -C "$host" rev-parse master)"
  fi
  desc="$(git -C "$host" describe --tags --long --always "$sha" 2>/dev/null || echo "$sha")"
  write_lock_sha "$(lock_path "$name")" "$sha" "$desc"
  echo "    lock → $sha"
  cmd_ro "$name"
}

# Write ARTIFACT-SHA256<TAB>index<TAB>old<TAB>new lines (from get-artifacts --record) into the
# pin: row <index> of [[artifact]] must have exactly sha256 = "<old>". Atomic (tmp + rename).
record_artifact_shas() {
  local pin="$1" records="$2"
  python3 - "$pin" "$records" <<'PY'
import os, re, sys
pin, records = sys.argv[1], sys.argv[2]
recs = []
for line in records.splitlines():
    f = line.split("\t")
    if f[0] == "ARTIFACT-SHA256" and len(f) == 4:
        recs.append((int(f[1]), f[2], f[3]))
lines = open(pin, encoding="utf-8").read().split("\n")
starts = [i for i, l in enumerate(lines) if l.strip() == "[[artifact]]"]
for idx, old, new in recs:
    if idx >= len(starts):
        sys.exit(f"fetch-deps: {pin}: no [[artifact]] row {idx} (rows are [[artifact]] tables)")
    end = next((j for j in range(starts[idx] + 1, len(lines)) if re.match(r"^\s*\[", lines[j])), len(lines))
    hits = [j for j in range(starts[idx] + 1, end) if re.fullmatch(r'\s*sha256\s*=\s*"' + re.escape(old) + r'"\s*', lines[j])]
    if len(hits) != 1:
        sys.exit(f"fetch-deps: {pin}: [[artifact]] row {idx} has no single sha256 = \"{old}\" line")
    lines[hits[0]] = f'sha256 = "{new}"'
    print(f"    pin row {idx}: sha256 {old[:12]}… -> {new[:12]}…")
tmp = pin + ".tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    fh.write("\n".join(lines))
os.replace(tmp, pin)
PY
}

cmd_build() {
  local name="$1"
  local ga_mode="${2:-verify}"
  local dir="$ROOT/$name"
  local lock src
  lock="$(lock_path "$name")"
  src="$(src_path "$name")"
  echo "==> $name  build"
  if [[ ! -d "$src" ]]; then
    echo "    FAIL: no src — run fetch-deps first" >&2
    return 1
  fi
  # Prefer RO sources: only unlock whole tree if pin requires it.
  local need_rw
  need_rw="$(pin_get "$lock" requires_writable_src 2>/dev/null || echo false)"
  if [[ "$need_rw" == "true" || "$need_rw" == "yes" || "$need_rw" == "1" ]]; then
    ensure_writable_tree "$src"
  fi
  # Build steps: write only third_party/<lib>/src (single-level bwrap)
  run_build_cmd() {
    local bcmd="$1"
    echo "    run $bcmd  [sandbox=src]"
    bwrap_src "$name" bash -c "cd $(printf %q "$dir") && eval $(printf %q "$bcmd")"
  }
  local ran=0 bcmd
  # pin_build_steps: missing build key defaults to ./build; explicit build=[] → none
  while IFS= read -r bcmd; do
    [[ -z "$bcmd" ]] && continue
    run_build_cmd "$bcmd" || { echo "    FAIL build: $bcmd" >&2; return 1; }
    ran=1
  done < <(pin_build_steps "$lock")
  if [[ "$ran" -eq 0 ]]; then
    echo "    no build steps — skip exec"
  fi
  # Collect when [[artifact]] present (get-artifacts no-ops gracefully if none)
  if [[ -x "$ROOT/get-artifacts" ]]; then
    if grep -q '\[\[artifact\]\]' "$lock" 2>/dev/null; then
      echo "    get-artifacts --$ga_mode  [sandbox=artifact]"
      local ga_out ga_flag=() caps
      if [[ "$ga_mode" == record ]]; then
        # get-artifacts is per tree (not shared); an old copy has no --record.
        if ! caps=$("$ROOT/get-artifacts" --capabilities) || [[ "$caps" != record ]]; then
          echo "    FAIL: $ROOT/get-artifacts has no --record (older copy); update it from orchestration-example third_party/get-artifacts" >&2
          return 1
        fi
        ga_flag=(--record)
      fi
      # verify is get-artifacts' default, so no flag is passed (older copies accept that too)
      ga_out=$(bwrap_artifact "$name" "$ROOT/get-artifacts" --no-bwrap "${ga_flag[@]}" "$name") \
        || { printf '%s\n' "$ga_out" | grep -v '^ARTIFACT-SHA256'; echo "    FAIL get-artifacts" >&2; return 1; }
      printf '%s\n' "$ga_out" | grep -v '^ARTIFACT-SHA256' || [[ $? -eq 1 ]]
      if [[ "$ga_mode" == record ]]; then
        record_artifact_shas "$lock" "$ga_out" || { echo "    FAIL: could not record new sha256 values in $lock" >&2; return 1; }
      fi
    else
      echo "    no [[artifact]] — skip get-artifacts"
    fi
  fi
  # re-apply ro if status says ro (build dirs under src may stay rw — best-effort)
  local mode
  mode="$(yaml_get "$(status_path "$name")" mode 2>/dev/null || echo ro)"
  if [[ "$mode" == "ro" && "$need_rw" != "true" ]]; then
    make_readonly_tree "$src"
    # Build scratch stays writable for iterate: build/, bin/, and for Android library
    # pins (remotetable/extractmail) android/.gradle, android/*/build and the
    # machine-local android/local.properties. Only those that exist.
    local scratch
    for scratch in "$src/build" "$src/bin" "$src/android/.gradle" "$src/android"/*/build "$src/android/local.properties"; do
      [[ -e "$scratch" ]] || continue
      chmod -R u+w -- "$scratch" || { echo "    FAIL: chmod -R u+w $scratch" >&2; exit 1; }
    done
  fi
  echo "    OK build $name"
}

# A fatal helper (exit 1) during an upgrade build must not leave the half-recorded pin.
UPGRADE_LOCK="" UPGRADE_BACKUP=""
restore_upgrade_pin() {
  [[ -n "$UPGRADE_BACKUP" && -f "$UPGRADE_BACKUP" ]] || return 0
  cp -p "$UPGRADE_BACKUP" "$UPGRADE_LOCK" && rm -f "$UPGRADE_BACKUP" \
    && echo "    upgrade stopped: $UPGRADE_LOCK restored" >&2
}

cmd_upgrade() {
  local name="$1" ref="$REF_UPGRADE" src host sha
  echo "==> $name  upgrade --ref $ref"
  if ! pin_is_git "$(lock_path "$name")"; then
    echo "    FAIL: upgrade is git-only; for file pins edit [[source]] url/sha256 then fetch-deps ro" >&2
    return 1
  fi
  src="$(src_path "$name")"
  BRANCH_OVERRIDE="upgrade/${ref//\//-}-$(ve_branch)"
  BASE_REF=""
  # materialize ref
  ensure_writable_tree "$src"
  if host="$(local_repo_for "$name")"; then
    rm -rf "$src"
    git -C "$host" worktree add -b "$BRANCH_OVERRIDE" "$src" "$ref" 2>/dev/null \
      || { git clone "$host" "$src"; git -C "$src" checkout -B "$BRANCH_OVERRIDE" "$ref"; }
  else
    local url
    url="$(yaml_get "$(lock_path "$name")" git_https)"
    rm -rf "$src"
    git clone "$url" "$src"
    git -C "$src" checkout -B "$BRANCH_OVERRIDE" "$ref"
  fi
  sha="$(git -C "$src" rev-parse HEAD)"
  write_status "$name" "rw" "$BRANCH_OVERRIDE" "$sha" "upgrade_ref: $ref"
  if ! apply_patches "$name" "$src" "$(lock_path "$name")"; then
    echo "    FAIL upgrade $name: patch did not apply at $sha; not building, lock unchanged" >&2
    return 1
  fi
  # The new commit builds new bytes: record their sha256 (never check them against the old
  # pin). The pin is restored if anything below fails.
  local lock backup repro
  lock="$(lock_path "$name")"
  backup="$(mktemp "$lock.before-upgrade.XXXXXX")"
  cp -p "$lock" "$backup"
  UPGRADE_LOCK="$lock" UPGRADE_BACKUP="$backup"
  trap restore_upgrade_pin EXIT
  if ! cmd_build "$name" record; then
    cp -p "$backup" "$lock"; rm -f "$backup"
    echo "    FAIL upgrade $name: build failed at $sha; lock unchanged" >&2
    return 1
  fi
  repro="$(pin_get_opt "$lock" reproducible)" || exit 1
  if [[ "$repro" == "true" ]]; then
    echo "    reproducible = true: second build must give the recorded bytes"
    if ! cmd_build "$name" verify; then
      cp -p "$backup" "$lock"; rm -f "$backup"
      echo "    FAIL upgrade $name: second build differs from the first (not reproducible); lock unchanged" >&2
      return 1
    fi
  fi
  rm -f "$backup"
  UPGRADE_BACKUP=""
  trap - EXIT
  write_lock_sha "$(lock_path "$name")" "$sha" "$(git -C "$src" describe --tags --long --always HEAD 2>/dev/null || echo "$sha")"
  echo "    upgraded pin to $sha — review artifact/ and commit on VE"
  echo "    OK upgrade $name"
}

# --- main ---
echo "fetch-deps: cmd=$CMD GIT_HOME=$GIT_HOME allow_ssh=$ALLOW_SSH ve_branch=$(ve_branch)"

case "$CMD" in
  status)
    for n in "${NAMES[@]}"; do cmd_status "$n"; done
    ;;
  ro)
    for n in "${NAMES[@]}"; do cmd_ro "$n" || FAILURES=$((FAILURES+1)); done
    ;;
  rw)
    for n in "${NAMES[@]}"; do cmd_rw "$n" || FAILURES=$((FAILURES+1)); done
    ;;
  refresh)
    for n in "${NAMES[@]}"; do cmd_refresh "$n" || FAILURES=$((FAILURES+1)); done
    ;;
  build)
    if [[ "$RECORD" -eq 1 ]]; then _bm=record; else _bm=verify; fi
    for n in "${NAMES[@]}"; do cmd_build "$n" "$_bm" || FAILURES=$((FAILURES+1)); done
    ;;
  upgrade)
    cmd_upgrade "${NAMES[0]}" || FAILURES=$((FAILURES+1))
    ;;
  *)
    echo "unknown command $CMD" >&2
    exit 2
    ;;
esac

echo "fetch-deps done (failures=$FAILURES)."
exit "$FAILURES"
