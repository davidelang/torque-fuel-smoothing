#!/bin/bash
# fix-perms: Unified recovery script for permissions.
#
# Usage:
#   sudo ./fix-perms                 # from orchestration root: all worktrees + sandbox
#   sudo ./fix-perms --all           # same
#   sudo ./fix-perms /path/to/agent-N   # specific worktree only (from anywhere)
#
# Run from inside a worktree with no arg: fixes only current worktree (skips sandbox).
#
# This is a recovery tool for when things went badly wrong.
# Not for daily use (setup_agent.sh handles creation).
#
# It only sets ownership, groups and modes. It never writes a tracked file (the
# append-to-engineering-log wrapper and ENGINEERING_LOG.md come from git; a missing one is
# an error, restore it with git checkout) and never touches sudoers (passwordless sudo to the
# ai-* users lives in David's global sudoers, not in any project). Unknown arguments are an
# error. Every chown/chmod/chattr/setfacl/git step runs under set -e with its errors shown:
# nothing is swallowed, so the first failure stops the run with its message. Steps that may
# not apply are guarded by an explicit check (file exists, ACL present, group membership).
# Must run as root (sudo).

set -euo pipefail

if [ "$EUID" -ne 0 ]; then
  echo "ERROR: fix-perms must run as root: sudo $0 $*" >&2
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CURRENT_DIR="$(pwd)"

VERBOSE=false
DO_ALL=false
TARGET_SPECIFIC=""
SUDO_USER=${SUDO_USER:-}
SUDO_USER_VAL=${SUDO_USER:-}

# Orchestration root is project.config orch_root (via ve-resolve-orch).
# Do NOT treat "update-rules.sh exists" as orch — every full worktree has that file.
if [ -f "$SCRIPT_DIR/ve-resolve-orch" ]; then
  # shellcheck source=/dev/null
  . "$SCRIPT_DIR/ve-resolve-orch"
elif [ -f "$CURRENT_DIR/ve-resolve-orch" ]; then
  # shellcheck source=/dev/null
  . "$CURRENT_DIR/ve-resolve-orch"
else
  echo "ERROR: ve-resolve-orch missing; cannot locate orch_root." >&2
  echo "  Run ./update-rules.sh from the orchestration root." >&2
  exit 1
fi
if ! ve_resolve_orch "$SCRIPT_DIR"; then
  if ! ve_resolve_orch "$CURRENT_DIR"; then
    exit 1
  fi
fi
AT_ORCHESTRATION=false
if [ "$(cd "$SCRIPT_DIR" && pwd)" = "$ORCH_ROOT" ]; then
  AT_ORCHESTRATION=true
fi

TARGET_SPECIFIC=""

# Parse args and flags
FORWARD_ARGS=""
for arg in "$@"; do
  case "$arg" in
    --all)
      DO_ALL=true
      ;;
    --quiet)
      FORWARD_ARGS="$FORWARD_ARGS $arg"
      ;;
    --verbose)
      VERBOSE=true
      FORWARD_ARGS="$FORWARD_ARGS $arg"
      ;;
    -*)
      echo "ERROR: fix-perms: unknown option $arg (usage: fix-perms [--all] [--quiet] [--verbose] [WORKTREE])" >&2
      exit 2
      ;;
    *)
      if [ -n "$TARGET_SPECIFIC" ]; then
        echo "ERROR: fix-perms: one WORKTREE only (got $TARGET_SPECIFIC and $arg)" >&2
        exit 2
      fi
      if [ ! -d "$arg" ]; then
        echo "ERROR: fix-perms: $arg is not a directory" >&2
        exit 2
      fi
      TARGET_SPECIFIC="$arg"
      ;;
  esac
done

if ! $VERBOSE; then
  # Default: no output if everything works (Unix style).
  # Errors/warnings still go to stderr.
  exec 1>/dev/null
fi

# Load KEY=VALUE from project.config. Keep equals — do not split on '='.
_CFG="$SCRIPT_DIR/project.config"
if [ ! -f "$_CFG" ]; then
  echo "ERROR: missing $_CFG (required keys; no layout/user defaults)." >&2
  exit 1
fi
while IFS= read -r line || [[ -n "$line" ]]; do
  line="${line%%#*}"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  [[ -z "$line" ]] && continue
  [[ "$line" =~ ^[a-zA-Z_][a-zA-Z0-9_]*= ]] || continue
  # shellcheck disable=SC2163
  export "$line"
done <"$_CFG"

_cfg_nonempty() {
  local n="$1" v="$2"
  if [ -z "$v" ] || [[ "$v" == @@* ]]; then
    echo "ERROR: $_CFG missing or unsmudged $n" >&2
    exit 1
  fi
}

CODE_GROUP=${code_group:-}
SHARED_GROUP=${shared_group:-}
SANDBOX_GROUP=${sandbox_group:-}
PRIMARY_USER=${primary_user:-}
PLANNING_USER=${planning_user:-}
CODER_USER=${coder_user:-}
ORCHESTRATOR_USER=${orchestrator_user:-}
_cfg_nonempty primary_user "$PRIMARY_USER"
_cfg_nonempty planning_user "$PLANNING_USER"
_cfg_nonempty coder_user "$CODER_USER"
_cfg_nonempty orchestrator_user "$ORCHESTRATOR_USER"
_cfg_nonempty code_group "$CODE_GROUP"
_cfg_nonempty sandbox_group "$SANDBOX_GROUP"
_cfg_nonempty shared_group "$SHARED_GROUP"

SANDBOX=${sandbox_dir:-}
_cfg_nonempty sandbox_dir "$SANDBOX"

_sandbox_under() {
  local root="$1"
  case "$SANDBOX" in
    /*) printf '%s\n' "$SANDBOX" ;;
    *) printf '%s\n' "$root/$SANDBOX" ;;
  esac
}

if $VERBOSE; then
  echo "  config: $_CFG"
  echo "  sandbox=$SANDBOX  sandbox_group=$SANDBOX_GROUP  primary_user=$PRIMARY_USER"
fi

# --- Helper functions (integrated from set-*-perms and fix-eng-log) ---

git_config_as_primary() {
  # Never run git config as root: it leaves .git/config root-owned and breaks
  # non-root users when supplementary group membership is not active in the shell.
  local repo_path="$1"
  shift
  if [ "$(id -un)" = "$PRIMARY_USER" ]; then
    git -C "$repo_path" "$@"
  else
    sudo -u "$PRIMARY_USER" git -C "$repo_path" "$@"
  fi
}

# Remove extended ACL entries only where a file has them (getfacl -s lists only such files),
# so a filesystem or file without ACLs needs no setfacl call at all.
strip_acl() {
  local f="$1"
  if [ -n "$(getfacl -s -p -- "$f")" ]; then
    setfacl -b -- "$f"
  fi
}

# True when user $1 is in group $2.
in_group() {
  id -nG "$1" | tr ' ' '\n' | grep -qx -- "$2"
}

ensure_shared_build_homes() {
  # Shared artifact/keystore homes live only at orch. Never mkdir $WT/.gradle-shared.
  local target_root="${ORCH_ROOT:-}"
  if [ -z "$target_root" ] || [ ! -d "$target_root" ]; then
    echo "ERROR: orch_root not resolved; cannot create shared build homes." >&2
    echo "  Run ./update-rules.sh from the orchestration root." >&2
    return 1
  fi
  GRADLE_SHARED="$target_root/.gradle-shared"
  mkdir -p "$GRADLE_SHARED"
  chown -R "$PRIMARY_USER:$SHARED_GROUP" "$GRADLE_SHARED"
  find "$GRADLE_SHARED" -type d -exec chmod 2770 {} +
  chmod -R ug+rwX,o-rwx "$GRADLE_SHARED"

  ANDROID_SHARED="$target_root/.android-shared"
  mkdir -p "$ANDROID_SHARED/cache"
  local ks="/home/$PRIMARY_USER/.android/debug.keystore"
  if [ ! -f "$ANDROID_SHARED/debug.keystore" ] && [ -f "$ks" ]; then
    cp "$ks" "$ANDROID_SHARED/"
    if [ -f "$ks.lock" ]; then
      cp "$ks.lock" "$ANDROID_SHARED/"
    fi
  fi
  chown -R "$PRIMARY_USER:$SHARED_GROUP" "$ANDROID_SHARED"
  find "$ANDROID_SHARED" -type d -exec chmod 2770 {} +
  chmod -R ug+rwX,o-rwx "$ANDROID_SHARED"
}

ensure_groups() {
  if $VERBOSE; then
    echo "Ensuring group memberships for $SHARED_GROUP ..."
  fi
  local u
  for u in "$PRIMARY_USER" "$PLANNING_USER" "$CODER_USER" "$ORCHESTRATOR_USER"; do
    if ! id "$u" >/dev/null; then
      echo "ERROR: user $u (project.config) does not exist" >&2
      exit 1
    fi
    if ! in_group "$u" "$SHARED_GROUP"; then
      usermod -aG "$SHARED_GROUP" "$u"
      if $VERBOSE; then echo "  + $u -> $SHARED_GROUP"; fi
    fi
  done
  # The planner never builds: it must not be in the code group.
  if in_group "$PLANNING_USER" "$CODE_GROUP"; then
    gpasswd -d "$PLANNING_USER" "$CODE_GROUP"
  fi
  # The primary user needs sandbox access too (for reading/interacting with plans)
  if ! in_group "$PRIMARY_USER" "$SANDBOX_GROUP"; then
    usermod -aG "$SANDBOX_GROUP" "$PRIMARY_USER"
  fi
  # Clean up rogue build caches from planner (should never build)
  if [ -d "/home/$PLANNING_USER/.gradle" ]; then
    echo "WARNING: $PLANNING_USER has ~/.gradle (should never build). Removing."
    rm -rf "/home/$PLANNING_USER/.gradle"
  fi
}

# Git hooks must remain executable. Blanket "chmod 660 all .git files" (group
# sharing for multi-user) strips +x and causes: "hook was ignored because it's
# not set as executable". Restore after every such pass. Skip *.sample.
ensure_git_hooks_executable() {
  local hooks_dir
  for hooks_dir in "$@"; do
    [ -d "$hooks_dir" ] || continue
    if $VERBOSE; then echo "  Ensuring git hooks executable under $hooks_dir"; fi
    # Active hooks only (not the stock *.sample templates)
    find "$hooks_dir" -maxdepth 1 -type f ! -name '*.sample' -exec chmod 775 {} +
    find "$hooks_dir" -mindepth 1 -maxdepth 1 -exec chown ":$SHARED_GROUP" {} +
  done
}

# Absolute common git directory for a worktree/repo root (fails if it is not a git tree).
# Multi-user DAC model: this store must stay SHARED_GROUP (ai-shared), never CODE_GROUP.
resolve_common_gitdir() {
  local base="$1" g
  g=$(git -C "$base" rev-parse --git-common-dir)
  case "$g" in
    /*) printf '%s\n' "$g" ;;
    *) printf '%s\n' "$base/$g" ;;
  esac
}

# Repair common/core .git store only (objects/refs/HEAD/config/hooks/worktrees).
# Never use CODE_GROUP here. Never chmod 660 on the top directory before descend.
repair_common_gitdir() {
  local gdir="$1" hd
  [ -d "$gdir" ] || { echo "ERROR: common git dir $gdir is not a directory" >&2; exit 1; }
  if $VERBOSE; then echo "  Repairing common git dir under $SHARED_GROUP: $gdir"; fi
  # Ensure top dir is searchable before recursive ops (legacy bug: chmod 660 stripped +x).
  chown ":$SHARED_GROUP" "$gdir"
  chmod 2770 "$gdir"
  chown -R ":$SHARED_GROUP" "$gdir"
  find "$gdir" -type d -exec chmod 2770 {} +
  find "$gdir" -type f -exec chmod 660 {} +
  if [ -d "$gdir/worktrees" ]; then
    while read -r hd; do
      ensure_git_hooks_executable "$hd"
    done < <(find "$gdir/worktrees" -type d -name hooks)
  fi
  ensure_git_hooks_executable "$gdir/hooks"
  if [ -f "$gdir/config" ]; then
    chown "$PRIMARY_USER:$SHARED_GROUP" "$gdir/config"
    chmod 660 "$gdir/config"
  fi
}

# chown worktree tree to CODE_GROUP without ever assigning CODE_GROUP to common .git.
chown_worktree_code_group() {
  local wt="$1"
  local spec="$2" # "user:group" or ":group"
  # Top-level entries except .git (directory = common store; file = gitdir pointer)
  find "$wt" -mindepth 1 -maxdepth 1 ! -name '.git' -exec chown -R "$spec" {} +
}

# Worktree scripts humans/agents run by path (./deploy, ./build_app, …).
# After update-rules `cp` (non-preserving): file is often 664 owned by the sync user
# (e.g. ai-orchestrator). dlang then needs group+x or o+x — and g+s alone is not enough.
ensure_worktree_scripts_executable() {
  local wt="$1"
  local f
  # setgid + rwx for owner/group so primary and ai-code can run; other r-x for stale sessions
  local scripts=(
    build_app deploy setup_agent.sh remove_worktree.sh
    get-builds-tag.sh update-rules.sh ve-resolve-orch install-merge-drivers.sh merge-branch-into-master.sh
    generate_pr.sh cleanup_pr.sh
    filter-apply-config filter-clean-config setup-project
    set-worktree-perms set-sandbox-perms
    run-grok run-grok-master run-grok-planner run-grok-coder run-grok-orchestrator
    run-antigravity run-gemini
    agent-landlock todo-append todo-close env
    landlock-smoke-matrix landlock-write-probe
  )
  for f in "${scripts[@]}"; do
    if [ -f "$wt/$f" ]; then
      chown "$PRIMARY_USER:$CODE_GROUP" "$wt/$f"
      chmod 2775 "$wt/$f"
    fi
  done
  # Shell helpers under git-merge-drivers/
  if [ -d "$wt/git-merge-drivers" ]; then
    find "$wt/git-merge-drivers" -type f -exec chown "$PRIMARY_USER:$CODE_GROUP" {} +
    find "$wt/git-merge-drivers" -type f -exec chmod 775 {} +
  fi
  # Named *.sh at worktree root
  find "$wt" -maxdepth 1 -type f -name '*.sh' -exec chown "$PRIMARY_USER:$CODE_GROUP" {} +
  find "$wt" -maxdepth 1 -type f -name '*.sh' -exec chmod 2775 {} +
  # Tracked 100755 (agent-landlock is Python, not *.sh). Planner is not in ai-code.
  ve_ensure_tracked_exec_other_x "$wt"
}

# The tracked wrapper and log must exist before anything is changed; fix-perms never writes them.
require_log_files() {
  local wt="$1" f
  for f in append-to-engineering-log ENGINEERING_LOG.md; do
    if [ ! -f "$wt/$f" ]; then
      echo "ERROR: $wt/$f is missing (tracked file; restore it: git -C $wt checkout -- $f). fix-perms never writes it." >&2
      exit 1
    fi
  done
}

fix_worktree() {
  local wt="$1"
  [ -d "$wt" ] || { echo "ERROR: worktree $wt is not a directory" >&2; exit 1; }
  require_log_files "$wt"
  if $VERBOSE; then echo "  Applying to worktree: $wt"; fi

  # The log is append-only (chattr +a), which also refuses chown/chmod: lift it for this run;
  # fix_log_wrapper sets it again at the end.
  chattr -a "$wt/ENGINEERING_LOG.md"

  # chown worktree to code group — NEVER assign CODE_GROUP to common .git store
  # (chown -R on main worktree used to poison objects/refs/HEAD → planner lockout).
  if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
    chown_worktree_code_group "$wt" "$SUDO_USER:$CODE_GROUP"
  else
    chown_worktree_code_group "$wt" ":$CODE_GROUP"
  fi

  # Re-apply sandbox if present
  _wt_sb="$(_sandbox_under "$wt")"
  if [ -d "$_wt_sb" ]; then
    chown -R ":$SANDBOX_GROUP" "$_wt_sb"
    find "$_wt_sb" -type d -exec chmod u+rwx,g+rwxs,o+rx {} +
  fi

  git_config_as_primary "$wt" config core.sharedRepository group

  # Broad Unix perms on worktree only — prune .git so we never chmod common store here
  find "$wt" -name .git -prune -o -type f -exec chmod u+rw,g+rw,o+r {} +
  find "$wt" -name .git -prune -o -type d -exec chmod u+rwx,g+rwxs,o+rx {} +

  # Planner writes via ai-shared group rw (664), not other-write. 666 is a bug.
  local f
  for f in TODO.md project-facts.md; do
    if [ -f "$wt/$f" ]; then
      chown ":$SHARED_GROUP" "$wt/$f"
      chmod 664 "$wt/$f"
    fi
  done

  # .git handling (linked worktree file vs main common dir).
  # NEVER chmod 660 a .git *directory* (strips search bit → recursive heal cannot descend).
  WT_GITDIR=""
  if [ -f "$wt/.git" ]; then
    # Pointer file only
    chown ":$SHARED_GROUP" "$wt/.git"
    chmod 660 "$wt/.git"
    WT_GITDIR=$(sed -n 's/^gitdir: //p' "$wt/.git" | head -1)
    if [ -z "$WT_GITDIR" ] || [ ! -d "$WT_GITDIR" ]; then
      echo "ERROR: $wt/.git names no existing gitdir ($WT_GITDIR)" >&2
      exit 1
    fi
    # Per-worktree admin under common .git/worktrees/<name> only (not objects/refs)
    chown -R ":$SHARED_GROUP" "$WT_GITDIR"
    find "$WT_GITDIR" -type d -exec chmod 2770 {} +
    find "$WT_GITDIR" -type f -exec chmod 660 {} +
    ensure_git_hooks_executable "$WT_GITDIR/hooks"
  elif [ -d "$wt/.git" ]; then
    # Main worktree: repair common store with SHARED_GROUP only
    repair_common_gitdir "$wt/.git"
  fi
  # Hook +x on common store (shared by all worktrees)
  local common
  common=$(resolve_common_gitdir "$wt")
  ensure_git_hooks_executable "$common/hooks"

  # build run-as if needed
  if [ -f "$wt/run-as-primary.c" ] && [ ! -x "$wt/run-as-primary" ]; then
    if $VERBOSE; then echo "  Compiling run-as-primary in $wt ..."; fi
    (cd "$wt" && gcc -O2 -Wall -o run-as-primary run-as-primary.c)
  fi
  if [ -f "$wt/run-as-primary" ]; then
    chown "$PRIMARY_USER:$CODE_GROUP" "$wt/run-as-primary"
    chmod 4755 "$wt/run-as-primary"
  fi

  # ve-refresh-shell: setuid root per worktree (binary not in git; .c is tracked).
  if [ -x "$SCRIPT_DIR/install-ve-refresh-shell.sh" ]; then
    if $VERBOSE; then echo "  install-ve-refresh-shell for $wt"; fi
    "$SCRIPT_DIR/install-ve-refresh-shell.sh" "$wt"
  else
    if [ -f "$wt/ve-refresh-shell.c" ]; then
      if $VERBOSE; then echo "  Compiling ve-refresh-shell in $wt ..."; fi
      (cd "$wt" && gcc -O2 -Wall -o ve-refresh-shell ve-refresh-shell.c)
    fi
    if [ -f "$wt/ve-refresh-shell" ]; then
      chown root:root "$wt/ve-refresh-shell"
      chmod 4755 "$wt/ve-refresh-shell"
    fi
  fi

  # Critical agent/human scripts: must be executable by primary + ai-code after any
  # update-rules cp (often creates 664 owned by whoever ran sync) and after the
  # broad "chmod u+rw,g+rw,o+r" pass (does not strip x, but never *adds* it).
  ensure_worktree_scripts_executable "$wt"

  # gradlew executable only by ai-code group (prevents planner)
  if [ -f "$wt/gradlew" ]; then
    chown "$PRIMARY_USER:$CODE_GROUP" "$wt/gradlew"
    chmod 2750 "$wt/gradlew"
  fi

  # Build config must stay group-readable (Gradle wrapper opens as deploying user)
  if [ -f "$wt/gradle.properties" ]; then
    chown "$PRIMARY_USER:$CODE_GROUP" "$wt/gradle.properties"
    chmod 664 "$wt/gradle.properties"
  fi

  # .gradle etc (basic)
  if [ -d "$wt/.gradle" ]; then
    find "$wt/.gradle" -type d -exec chmod 2770 {} +
    find "$wt/.gradle" -type f -exec chmod u+rw,g+rw,o-rwx {} +
  fi

  # app/build (gradle, cxx/CMake logs, etc.) - aggressively fix to prevent permission thrashing
  if [ -d "$wt/app/build" ]; then
    if $VERBOSE; then echo "    Fixing app/build for $PRIMARY_USER:$CODE_GROUP"; fi
    chown -R "$PRIMARY_USER:$CODE_GROUP" "$wt/app/build"
    find "$wt/app/build" -type d -exec chmod 2770 {} +
    find "$wt/app/build" -type f -exec chmod 660 {} +
    # Also clean bad cxx state if present
    rm -rf "$wt/app/build/intermediates/cxx"
  fi
}

fix_sandbox() {
  local sb
  sb="$(_sandbox_under "$SCRIPT_DIR")"
  if [ ! -d "$sb" ]; then
    echo "ERROR: sandbox is not a directory: $sb (from $_CFG sandbox_dir=$SANDBOX)" >&2
    exit 1
  fi
  if $VERBOSE; then echo "  Applying to sandbox: $sb (group=$SANDBOX_GROUP)"; fi
  chown -R ":$SANDBOX_GROUP" "$sb"
  chmod -R g+rwX "$sb"
  find "$sb" -type d -exec chmod u+rwx,g+rwxs,o+rx {} +
  # NOTE: Do NOT chown to ai-shared here. The sandbox group is ai-sandbox.
  # ai-shared is for AI engine configs (.gemini/, .grok/), not for sandbox files.
}

fix_log_wrapper() {
  # Permissions only: both files are tracked and come from git, never from this script.
  local wt="$1"
  require_log_files "$wt"

  WRAPPER="$wt/append-to-engineering-log"
  chown root:"$SHARED_GROUP" "$WRAPPER"
  strip_acl "$WRAPPER"
  chmod 2755 "$WRAPPER"
  if $VERBOSE; then
    echo "    wrapper: root:$SHARED_GROUP 2755 (content from git, not touched)"
  fi

  LOG="$wt/ENGINEERING_LOG.md"
  chattr -a "$LOG"
  chown root:"$SHARED_GROUP" "$LOG"
  chmod 660 "$LOG"
  strip_acl "$LOG"
  chattr +a "$LOG"
  if $VERBOSE; then
    echo "    log: root:$SHARED_GROUP 660 + chattr +a (pure Unix, no ACLs)"
  fi
}

# --- Main dispatch ---

ensure_groups

if [ -n "$TARGET_SPECIFIC" ]; then
  fix_worktree "$TARGET_SPECIFIC"
  fix_log_wrapper "$TARGET_SPECIFIC"
elif $DO_ALL || $AT_ORCHESTRATION; then
  ensure_shared_build_homes
  mapfile -t WORKTREES < <(git -C "$SCRIPT_DIR" worktree list --porcelain | awk '/^worktree / {print $2}')
  [ "${#WORKTREES[@]}" -gt 0 ] || { echo "ERROR: git worktree list found no worktrees in $SCRIPT_DIR" >&2; exit 1; }
  for wt in "${WORKTREES[@]}"; do
    fix_worktree "$wt"
    fix_log_wrapper "$wt"
  done
  fix_sandbox

  # Common/core .git: SHARED_GROUP only (resolved via --git-common-dir, so a run from a
  # linked worktree, where SCRIPT_DIR/.git is a file, still repairs the real store).
  COMMON_GDIR=$(resolve_common_gitdir "$SCRIPT_DIR")
  if $VERBOSE; then echo "  Fixing common git dir under $SHARED_GROUP: $COMMON_GDIR"; fi
  repair_common_gitdir "$COMMON_GDIR"
  git_config_as_primary "$SCRIPT_DIR" config core.sharedRepository group
else
  fix_worktree "$CURRENT_DIR"
  fix_log_wrapper "$CURRENT_DIR"
  # Even single-worktree recovery: heal common store (never CODE_GROUP)
  repair_common_gitdir "$(resolve_common_gitdir "$CURRENT_DIR")"
fi

if $VERBOSE; then
  echo
  echo "Recovery complete. Suggested verification:"
  echo "  ls -l ENGINEERING_LOG.md append-to-engineering-log run-as-primary"
  echo "  getfacl -s ENGINEERING_LOG.md append-to-engineering-log"
  echo "  lsattr ENGINEERING_LOG.md"
  echo "  ./append-to-engineering-log '## test entry'"
  echo
  echo "Re-run from orchestration root after major breakage."
fi
