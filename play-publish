#!/usr/bin/env python3
"""play-publish: upload the recorded Play bundle to Internal testing, then promote it to alpha.

Called by ./deploy --play (which selects the bundle and checks it against HEAD). Standard
library plus the openssl binary (RS256 signing of the service-account JWT); nothing else.

  play-publish --aab FILE --version-code N --aapt2 PATH --key SA.json
               [--notes-file FILE | --notes-base REV] [--dry-run]

  play-publish --max-version-code --key SA.json
               (--package ID | --aab FILE --aapt2 PATH --work-dir DIR)

Every failure prints one ERROR line and exits 1. --dry-run finalizes the notes first, then
opens a short-lived edit to read the tracks and check the notes base, then deletes the edit
(no upload, no commit).

No service-account token and no Play API call happens until the release notes are final, so
sitting in the editor cannot expire the ~1h OAuth access token or an open Play edit.

Notes base (must be an ancestor of HEAD), chosen without contacting Play:
  --notes-file FILE  uses FILE; no base commit is needed
  --notes-base REV   git log REV..HEAD
  otherwise          the local moving tag play (master) or <branch>/play (any other branch),
                     the commit last successfully uploaded by deploy --play

If that tag is missing, this is an error (nothing uploaded, Play not contacted). Seed a
lightweight tag on the commit last uploaded to Play, and do not push it:

  git tag play <commit>            # master
  git tag <branch>/play <commit>   # any other branch

The commit is the @hash in the highest Play release name (for example
"36 (v0.9.10 @1bd75c80b0f4)"), or pass --notes-base <commit> this once; a successful
upload creates the tag. Never guesses a branch or HEAD. Not an annotated tag: git describe
would then pick play as versionName.

After a successful Play edit commit, the tag is force-moved to this bundle's build commit
(git tag -f, never pushed), the same way deploy moves deployed / <branch>/deployed after
a successful device install.

--max-version-code prints Play's highest versionCode across every track and every uploaded
bundle (0 if there are none) as the line "max-version-code N" and exits. Used by
build_app --play. It needs --key and either --package or a readable --aab (to read the
applicationId). No upload.

Release names look like "25 (v0.9.3 @a36abf76ad08)": readable versionName plus the stamped
build commit (not a blind HEAD read at upload time). Bundle versionName is unchanged.
"""
import argparse, base64, json, os, re, shlex, subprocess, sys, tempfile, time, urllib.error, urllib.parse, urllib.request, zipfile

API = "https://androidpublisher.googleapis.com/androidpublisher/v3/applications/"
UPLOAD = "https://androidpublisher.googleapis.com/upload/androidpublisher/v3/applications/"
SCOPE = "https://www.googleapis.com/auth/androidpublisher"
NOTES_LIMIT = 500
HASH_RX = re.compile(r"-g([0-9a-f]{7,40})(?![0-9A-Za-z])")  # legacy describe inside "15 (v0.9.2-38-gb2c2ca61)"
PROV_RX = re.compile(r"@([0-9a-f]{7,40})(?![0-9A-Za-z])")  # stamped build commit: "25 (v0.9.3 @a36abf76ad08)"
NAME_RX = re.compile(r"^\d+ \((.+)\)$")  # Play release name written by format_release_name / older uploads
COMMIT_RX = re.compile(r"^[0-9a-f]{7,40}$")


def format_release_name(vc, vname, commit):
    """Play release name: readable versionName plus explicit stamped build commit."""
    if not COMMIT_RX.fullmatch(commit):
        die("build commit %r is not a hex git object name" % (commit,))
    vname = (vname or "").strip()
    if (not vname) or ("(" in vname) or (")" in vname) or ("\n" in vname):
        die("versionName %r is empty or not safe to put in a Play release name" % (vname,))
    return "%d (%s @%s)" % (vc, vname, commit[:12])


def git_commit(rev):
    """Full commit sha for rev, or None if missing."""
    p = subprocess.run(["git", "rev-parse", "--verify", "--quiet", rev + "^{commit}"],
                       capture_output=True, text=True)
    return p.stdout.strip() if p.returncode == 0 and p.stdout.strip() else None


def require_ancestor(base, label):
    if subprocess.run(["git", "merge-base", "--is-ancestor", base, "HEAD"]).returncode:
        die("%s (%s) is not an ancestor of HEAD" % (label, base[:12]))


def resolve_exact_tag(label):
    """If refs/tags/<label> exists, return its peeled commit; else None. Tags only, never branches."""
    if not label or label.startswith("-") or ".." in label or " " in label or "\n" in label:
        return None
    # Exact tag ref only (refuse branches / bare rev-parse ambiguity).
    p = subprocess.run(["git", "show-ref", "--tags", "--verify", "--quiet", "refs/tags/" + label])
    if p.returncode:
        return None
    return git_commit("refs/tags/" + label)


def notes_base_from_release_name(name):
    """Return (kind, value) for a Play release name, or (None, reason) if unusable.
    kind is 'provenance', 'describe-hash', or 'tag'; value is the hash/tag label."""
    name = (name or "").strip()
    m = PROV_RX.search(name)
    if m:
        return "provenance", m.group(1)
    m = HASH_RX.search(name)
    if m:
        return "describe-hash", m.group(1)
    m = NAME_RX.match(name)
    if not m:
        return None, "name %r is not 'versionCode (label)'" % (name,)
    label = m.group(1).strip()
    if PROV_RX.search(label) or "@" in label:
        return None, "name %r has a malformed @provenance" % (name,)
    # Bare exact-tag legacy names such as "24 (v0.9.3)".
    return "tag", label

def die(msg):
    print("ERROR: " + msg, file=sys.stderr)
    sys.exit(1)

def run(cmd, **kw):
    p = subprocess.run(cmd, capture_output=True, text=True, **kw)
    if p.returncode:
        die("%s failed: %s" % (" ".join(cmd), p.stderr.strip()))
    return p.stdout

def b64(b):
    return base64.urlsafe_b64encode(b).rstrip(b"=").decode()

def token(key_path):
    try:
        sa = json.load(open(key_path))
    except (OSError, ValueError) as e:
        die("cannot read service-account JSON %s: %s" % (key_path, e))
    for k in ("client_email", "private_key", "token_uri"):
        if not sa.get(k):
            die("service-account JSON %s has no '%s'" % (key_path, k))
    now = int(time.time())
    head = b64(json.dumps({"alg": "RS256", "typ": "JWT"}).encode())
    claim = b64(json.dumps({"iss": sa["client_email"], "scope": SCOPE, "aud": sa["token_uri"],
                            "iat": now, "exp": now + 3600}).encode())
    signing = (head + "." + claim).encode()
    # The private key goes to openssl through a pipe, never onto disk.
    rfd, wfd = os.pipe()
    try:
        os.write(wfd, sa["private_key"].encode())
        os.close(wfd)
        p = subprocess.run(["openssl", "dgst", "-sha256", "-sign", "/dev/fd/%d" % rfd], input=signing,
                           capture_output=True, pass_fds=(rfd,))
    finally:
        os.close(rfd)
    if p.returncode:
        die("openssl could not sign the JWT: %s" % p.stderr.decode().strip())
    jwt = head + "." + claim + "." + b64(p.stdout)
    body = urllib.parse.urlencode({"grant_type": "urn:ietf:params:oauth:grant-type:jwt-bearer",
                                   "assertion": jwt}).encode()
    r = http("POST", sa["token_uri"], body=body, ctype="application/x-www-form-urlencoded", auth=None)
    if not r.get("access_token"):
        die("token endpoint returned no access_token")
    return r["access_token"], sa["client_email"]

TOKEN = None
WORK_DIR = None  # set from --work-dir; scratch files never go to /tmp

def http(method, url, body=None, ctype="application/json", auth=True, length=None, timeout=120):
    h = {}
    if auth:
        h["Authorization"] = "Bearer " + TOKEN
    if body is not None:
        h["Content-Type"] = ctype
        if length is not None:
            h["Content-Length"] = str(length)
    req = urllib.request.Request(url, data=body, method=method, headers=h)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            data = r.read()
    except urllib.error.HTTPError as e:
        die("%s %s -> HTTP %d: %s" % (method, url.split("?")[0], e.code, e.read().decode(errors="replace").strip()[:2000]))
    except urllib.error.URLError as e:
        die("%s %s failed: %s" % (method, url.split("?")[0], e.reason))
    if not data:
        return {}
    return json.loads(data)

def badging(aab, aapt2):
    """applicationId, versionCode, versionName from the bundle's base manifest (proto) via aapt2."""
    with tempfile.TemporaryDirectory(prefix="play-badging-", dir=WORK_DIR) as d:
        apk = os.path.join(d, "base.apk")
        try:
            z = zipfile.ZipFile(aab)
            with zipfile.ZipFile(apk, "w") as o:
                o.writestr("AndroidManifest.xml", z.read("base/manifest/AndroidManifest.xml"))
                o.writestr("resources.pb", z.read("base/resources.pb"))
        except (OSError, KeyError, zipfile.BadZipFile) as e:
            die("cannot read the base manifest of %s: %s" % (aab, e))
        out = run([aapt2, "dump", "badging", apk])
    m = re.search(r"^package: name='([^']+)' versionCode='([0-9]+)' versionName='([^']*)'", out, re.M)
    if not m:
        die("%s dump badging printed no package line for %s" % (aapt2, aab))
    return m.group(1), int(m.group(2)), m.group(3)

def read_state(pkg, edit):
    tracks = http("GET", API + pkg + "/edits/" + edit + "/tracks").get("tracks", [])
    bundles = http("GET", API + pkg + "/edits/" + edit + "/bundles").get("bundles", [])
    return tracks, bundles

def releases(tracks):
    for t in tracks:
        for r in t.get("releases", []):
            for vc in r.get("versionCodes", []):
                yield t["track"], int(vc), r.get("name", "")


def max_version_code(tracks, bundles):
    """Highest versionCode on any track or uploaded bundle. 0 if Play has none."""
    codes = []
    for tr in tracks:
        for r in tr.get("releases", []):
            for vc in r.get("versionCodes", []):
                try:
                    n = int(vc)
                except (TypeError, ValueError):
                    die("Play track %s has a non-integer versionCode: %r" % (tr.get("track"), vc))
                if n < 0:
                    die("Play track %s has a negative versionCode: %d" % (tr.get("track"), n))
                codes.append(n)
    for b in bundles:
        raw = b.get("versionCode", None)
        if raw is None:
            die("Play bundle listing is missing versionCode")
        try:
            n = int(raw)
        except (TypeError, ValueError):
            die("Play bundle listing has a non-integer versionCode: %r" % (raw,))
        if n < 0:
            die("Play bundle listing has a negative versionCode: %d" % n)
        codes.append(n)
    return max(codes) if codes else 0


def play_tag_name():
    """Moving Play-upload tag: play on master, <branch>/play on any other branch.

    Mirrors deploy's deployed / <branch>/deployed. Detached HEAD is refused: there is no
    branch to name the tag.
    """
    branch = run(["git", "rev-parse", "--abbrev-ref", "HEAD"]).strip()
    if not branch or branch == "HEAD":
        die("the play tag is play on master and <branch>/play on any other branch; this checkout is detached")
    return "play" if branch == "master" else "%s/play" % branch


def play_tag_commit(name):
    """Peeled commit of refs/tags/<name>, or None if the tag does not exist. Tags only."""
    return git_commit("refs/tags/" + name)


def move_play_tag(commit):
    """Force-move the local play tag to commit. Lightweight, never pushed."""
    full = git_commit(commit)
    if not full:
        die("cannot move the play tag: %s is not a commit" % commit)
    name = play_tag_name()
    run(["git", "tag", "-f", name, full])
    got = play_tag_commit(name)
    if got != full:
        die("after git tag -f %s, the tag is %s, not %s" % (name, got, full))
    print("Updated local '%s' tag to %s (not pushed)" % (name, full[:12]))
    return name


def local_notes_base(notes_file, notes_base_arg):
    """Notes base with no Play auth. Returns (commit or None, source).

    source is 'notes-file', 'notes-base', or 'play-tag'.
    """
    if notes_file:
        print("Release notes from --notes-file %s (no base commit needed)" % notes_file)
        return None, "notes-file"
    if notes_base_arg:
        base = git_commit(notes_base_arg)
        if not base:
            die("--notes-base %s is not a commit in this repository" % notes_base_arg)
        require_ancestor(base, "--notes-base %s" % notes_base_arg)
        print("Notes from --notes-base %s (%s)..HEAD" % (notes_base_arg, base[:12]))
        return base, "notes-base"
    name = play_tag_name()
    base = play_tag_commit(name)
    if not base:
        die("no local '%s' tag to start the notes after. Seed a lightweight tag on the commit last "
            "uploaded to Play (the @hash in the highest Play release name), and do not push it:  "
            "git tag %s <commit>    Or pass --notes-base <commit> or --notes-file FILE this once; "
            "a successful ./deploy --play creates the tag. Play is not queried before the notes "
            "editor; nothing uploaded" % (name, name))
    require_ancestor(base, "tag %s" % name)
    print("Notes from %s..HEAD (local '%s' tag)" % (base[:12], name))
    return base, "play-tag"


def get_notes(base, notes_file):
    if notes_file:
        try:
            text = open(notes_file).read()
        except OSError as e:
            die("cannot read --notes-file %s: %s" % (notes_file, e))
        text = text.strip()
        if not text:
            die("release notes in %s are empty; nothing uploaded" % notes_file)
        if len(text) > NOTES_LIMIT:
            die("release notes in %s are %d characters; Play's en-US limit is %d" % (notes_file, len(text), NOTES_LIMIT))
        return text
    rx = exclude_patterns()
    subjects = run(["git", "log", "--no-merges", "--format=%s", base + "..HEAD"]).splitlines()
    kept = [s for s in subjects if not any(r.search(s) for r in rx)]
    print("Release notes: %d commits since %s, %d left out by the exclude patterns" % (len(subjects), base, len(subjects) - len(kept)))
    env_editor = os.environ.get("EDITOR")
    if env_editor:
        editor = shlex.split(env_editor)
    else:
        # Unset or empty EDITOR means vi, with a status line showing the live character count.
        editor = ["vi", "-c", r"set laststatus=2 statusline=%%f\ \ %%{wordcount().chars}/%d\ chars" % NOTES_LIMIT]
    fd, path = tempfile.mkstemp(prefix="play-notes-", suffix=".txt", dir=WORK_DIR)
    with os.fdopen(fd, "w") as f:
        f.write("".join("- %s\n" % s for s in kept))
    try:
        while True:
            if subprocess.run(editor + [path]).returncode:
                die("editor '%s' exited non-zero; nothing uploaded" % " ".join(editor))
            text = open(path).read().strip()
            if not text:
                die("release notes are empty; nothing uploaded")
            if len(text) <= NOTES_LIMIT:
                return text
            print("Release notes are %d characters; Play's en-US limit is %d (%d over)." % (len(text), NOTES_LIMIT, len(text) - NOTES_LIMIT))
            try:
                input("Press Enter to edit them again (Ctrl-C to stop; nothing uploaded yet): ")
            except EOFError:
                die("release notes are over %d characters and there is no terminal to re-edit; nothing uploaded" % NOTES_LIMIT)
    finally:
        os.unlink(path)

def exclude_patterns():
    """Regexes (one per line, # comments) for commit subjects left out of generated notes:
    play-notes-exclude next to this script (shared, published with the build type), then
    play-notes-exclude.local in the current directory (the project's own, optional)."""
    out = []
    for f in (os.path.join(os.path.dirname(os.path.abspath(__file__)), "play-notes-exclude"),
              "play-notes-exclude.local"):
        if not os.path.exists(f):
            if f.endswith(".local"):
                continue
            die("%s missing (ships with the android-gradle build type)" % f)
        for n, line in enumerate(open(f), 1):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            try:
                out.append(re.compile(line))
            except re.error as e:
                die("%s line %d: bad pattern %r: %s" % (f, n, line, e))
    return out

def track_release(pkg, edit, track, vc, name, notes):
    body = {"track": track, "releases": [{"name": name, "versionCodes": [str(vc)], "status": "completed",
                                          "releaseNotes": [{"language": "en-US", "text": notes}]}]}
    http("PUT", API + pkg + "/edits/" + edit + "/tracks/" + track, body=json.dumps(body).encode())

def verify(pkg, track, vc):
    edit = http("POST", API + pkg + "/edits", body=b"{}")["id"]
    t = http("GET", API + pkg + "/edits/" + edit + "/tracks/" + track)
    http("DELETE", API + pkg + "/edits/" + edit)
    st = [r.get("status") for r in t.get("releases", []) if str(vc) in r.get("versionCodes", [])]
    if not st:
        die("after commit, the %s track does not list versionCode %d" % (track, vc))
    print("verified: %s track has versionCode %d (status %s)" % (track, vc, ",".join(st)))

def main_max_version_code():
    """Query Play for the highest versionCode. No upload. stdout is one 'max-version-code N' line."""
    global TOKEN, WORK_DIR
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(line_buffering=True)
    ap = argparse.ArgumentParser(
        prog="play-publish",
        description="Print Play's highest versionCode (all tracks and bundles) and exit. "
        "Used by ./build_app --play. No upload.",
        epilog="Details: the docstring at the top of play-publish.")
    ap.add_argument("--max-version-code", action="store_true", required=True,
                    help="print Play's highest versionCode and exit")
    ap.add_argument("--key", required=True, metavar="SA.json", help="service-account key file")
    ap.add_argument("--package", metavar="ID", help="applicationId (or give --aab to read it)")
    ap.add_argument("--aab", metavar="FILE", help="bundle to read the applicationId from")
    ap.add_argument("--aapt2", metavar="PATH", help="aapt2 binary, required with --aab")
    ap.add_argument("--work-dir", metavar="DIR", help="scratch dir for aapt2 (required with --aab; never /tmp)")
    a = ap.parse_args()
    if not a.package and not a.aab:
        die("--max-version-code needs --package or --aab (to read the applicationId); nothing queried")
    pkg = a.package
    if a.aab:
        if not a.aapt2:
            die("--aab needs --aapt2")
        if not a.work_dir:
            die("--aab needs --work-dir (scratch for the manifest copy; never /tmp)")
        if not (os.path.isdir(a.work_dir) and os.access(a.work_dir, os.W_OK)):
            die("--work-dir %s is missing or not writable" % a.work_dir)
        WORK_DIR = a.work_dir
        aab_pkg, _vc, _vn = badging(a.aab, a.aapt2)
        if pkg and pkg != aab_pkg:
            die("--package %s does not match applicationId %s from %s" % (pkg, aab_pkg, a.aab))
        pkg = aab_pkg
    elif a.aapt2 or a.work_dir:
        die("--aapt2 and --work-dir are only used with --aab")
    TOKEN, who = token(a.key)
    print("Service account: %s" % who, file=sys.stderr)
    edit = http("POST", API + pkg + "/edits", body=b"{}")["id"]
    query_err = False
    try:
        tracks, bundles = read_state(pkg, edit)
        n = max_version_code(tracks, bundles)
    except SystemExit:
        query_err = True
        raise
    finally:
        # Always drop the short-lived query edit. http() already printed a DELETE
        # failure; don't let that SystemExit hide the original query error.
        try:
            http("DELETE", API + pkg + "/edits/" + edit)
        except SystemExit:
            if not query_err:
                raise
    print("max-version-code %d" % n)
    return 0


def main():
    if "--max-version-code" in sys.argv:
        return main_max_version_code()
    global TOKEN
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(line_buffering=True)
    ap = argparse.ArgumentParser(
        prog="play-publish",
        description="Upload the recorded Play bundle to Internal testing, then promote it to alpha. "
        "Called by ./deploy --play. Notes are finalized before any Play auth.",
        epilog="Details: the docstring at the top of play-publish.")
    ap.add_argument("--aab", required=True, metavar="FILE", help="the bundle to upload")
    ap.add_argument("--version-code", required=True, type=int, metavar="N", help="versionCode the build recorded")
    ap.add_argument("--build-commit", required=True, metavar="SHA",
                    help="full commit recorded in play.json for this bundle (stamped build; used in the Play release name)")
    ap.add_argument("--aapt2", required=True, metavar="PATH", help="aapt2 binary, to read the bundle manifest")
    ap.add_argument("--key", required=True, metavar="SA.json", help="service-account key file")
    nb = ap.add_mutually_exclusive_group()
    nb.add_argument("--notes-file", metavar="FILE", help="release notes (default: computed from the commits)")
    nb.add_argument("--notes-base", metavar="REV",
                    help="compute the notes from REV..HEAD instead of the local play tag")
    ap.add_argument("--dry-run", action="store_true", help="finalize notes, read Play, delete the edit (no upload)")
    ap.add_argument("--work-dir", required=True, metavar="DIR", help="scratch dir for the notes file and manifest copy (never /tmp)")
    a = ap.parse_args()
    global WORK_DIR
    if not (os.path.isdir(a.work_dir) and os.access(a.work_dir, os.W_OK)):
        die("--work-dir %s is missing or not writable" % a.work_dir)
    WORK_DIR = a.work_dir
    pkg, vc, vname = badging(a.aab, a.aapt2)
    if vc != a.version_code:
        die("%s has versionCode %d but build_app recorded %d" % (a.aab, vc, a.version_code))
    build_commit = git_commit(a.build_commit)
    if not build_commit:
        die("--build-commit %s is not a commit in this repository" % a.build_commit)
    if not COMMIT_RX.fullmatch(a.build_commit) and build_commit != a.build_commit:
        # Allow a unique abbreviation only when it peels to one commit; store the full object name.
        pass
    head = git_commit("HEAD")
    if not head:
        die("HEAD is not a commit")
    if build_commit != head:
        die("--build-commit %s is not HEAD %s (play.json stamp out of date?)" % (build_commit[:12], head[:12]))
    release_name = format_release_name(vc, vname, build_commit)
    print("Bundle: %s  versionCode %d  versionName %s" % (pkg, vc, vname))
    print("Release name will be: %s (stamped build %s)" % (release_name, build_commit[:12]))

    # Notes first: no token(), no Play HTTP. The OAuth access token lasts ~1h (service-account
    # JWT exp is now+3600, and Google's token response is typically 3600s); an open Play edit
    # lasts up to 24h. Either can fail if they are obtained before a long editor session.
    base, _source = local_notes_base(a.notes_file, a.notes_base)
    notes = get_notes(base, a.notes_file)
    print("Release notes (%d/%d chars):\n%s" % (len(notes), NOTES_LIMIT, notes))

    TOKEN, who = token(a.key)
    print("Service account: %s" % who)
    edit = http("POST", API + pkg + "/edits", body=b"{}")["id"]
    try:
        tracks, bundles = read_state(pkg, edit)
        rel = list(releases(tracks))
        for track, code, _ in rel:
            if code == vc:
                die("Play already has versionCode %d on the %s track; run ./build_app --play for a new one" % (vc, track))
        for b in bundles:
            if int(b.get("versionCode", -1)) == vc:
                die("Play already has a bundle with versionCode %d (uploaded before); run ./build_app --play" % vc)
        top = max(rel, key=lambda x: x[1]) if rel else None
        if top:
            print("Play now: highest versionCode %d on %s ('%s')" % (top[1], top[0], top[2]))
        else:
            print("Play now: no release on any track")
        for t in tracks:
            for r in t.get("releases", []):
                print("  %-10s %-10s %s %s" % (t["track"], r.get("status", ""), ",".join(r.get("versionCodes", [])), r.get("name", "")))
        if a.dry_run:
            http("DELETE", API + pkg + "/edits/" + edit)
            edit = None
            print("DRY RUN: edit deleted; nothing uploaded or committed.")
            return 0
        size = os.path.getsize(a.aab)
        print("Uploading %s (%d MB)..." % (a.aab, size // 1048576))
        with open(a.aab, "rb") as f:
            up = http("POST", UPLOAD + pkg + "/edits/" + edit + "/bundles?uploadType=media", body=f,
                      ctype="application/octet-stream", length=size, timeout=3600)
        if int(up.get("versionCode", -1)) != vc:
            die("upload returned versionCode %s, expected %d" % (up.get("versionCode"), vc))
        # One edit, one commit for both tracks: Play logs it as one submission (two commits
        # left an empty "Canceled" submission for the internal-only commit).
        track_release(pkg, edit, "internal", vc, release_name, notes)
        track_release(pkg, edit, "alpha", vc, release_name, notes)
        http("POST", API + pkg + "/edits/" + edit + ":commit?changesNotSentForReview=false")
        edit = None
        print("committed: internal and alpha <- versionCode %d (one commit, sent for review)" % vc)
        # Play already has the release; move the local tag even if verify later fails.
        move_play_tag(build_commit)
    finally:
        if edit:
            # http() already printed the DELETE error; swallowing SystemExit here keeps the
            # original upload/commit error as the exit (a second die() would hide it).
            try:
                http("DELETE", API + pkg + "/edits/" + edit)
            except SystemExit:
                pass
    verify(pkg, "internal", vc)
    verify(pkg, "alpha", vc)
    print("==================================================================")
    print("Play release done: %s versionCode %d (%s)" % (pkg, vc, release_name))
    print("  internal: completed   alpha (closed testing): completed, submitted for review")
    print("==================================================================")
    return 0

if __name__ == "__main__":
    sys.exit(main())
