#!/bin/bash
# run-antigravity — primary Antigravity launcher (orchestrator user by default).
# Machine paths via project.config + manage-configs smudge (@@ tokens).

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR" || exit 1

# Config: project.config next to this script is the one source; missing values fail.
_cfg="$SCRIPT_DIR/project.config"
[ -f "$_cfg" ] || { echo "ERROR: $_cfg missing" >&2; exit 1; }
while IFS= read -r _line || [ -n "$_line" ]; do
  _line="${_line%%#*}"
  _line="${_line#"${_line%%[![:space:]]*}"}"
  [[ "$_line" =~ ^[a-zA-Z_][a-zA-Z0-9_]*= ]] || continue
  export "$_line"
done < "$_cfg"
need_cfg() { local v; v=$(sed -n "s/^$1=//p" "$_cfg" | tr -d '\r' | tail -1); [[ -n "$v" && "$v" != *@@* ]] || { echo "ERROR: $1 has no value in $_cfg" >&2; exit 1; }; printf '%s' "$v"; }
SANDBOX_REL=$(need_cfg sandbox_dir) || exit 1
SANDBOX_DIR="$SCRIPT_DIR/$SANDBOX_REL"
[ -d "$SANDBOX_DIR" ] || { echo "ERROR: sandbox_dir=$SANDBOX_REL is not a directory under $SCRIPT_DIR" >&2; exit 1; }
ORCHESTRATOR_USER=$(need_cfg orchestrator_user) || exit 1
ANTIGRAVITY_BIN=$(need_cfg antigravity_bin) || exit 1
ANTIGRAVITY_BIN="${ANTIGRAVITY_BIN//\$HOME/$HOME}"

umask 002

echo "Launching Antigravity agent in $(pwd)..."
echo "Antigravity binary: $ANTIGRAVITY_BIN"
echo "Sandbox path: $SANDBOX_DIR"
echo "Running as: $ORCHESTRATOR_USER (via sudo -u)"
echo "Tip: Ctrl+M or /multiline for multi-line input."

EXTRA_ARGS=()
FOUND_DD=0
for arg in "$@"; do
  if [ "$FOUND_DD" -eq 1 ]; then
    EXTRA_ARGS+=("$arg")
  elif [ "$arg" = "--" ]; then
    FOUND_DD=1
  fi
done

ROLE_KEY=orchestrator
AGENT_OOM_FUNCS_ONLY=1
# shellcheck source=/dev/null
source "$SCRIPT_DIR/.grok/lib/grok-launch-common.sh" || exit 1
mem_max="$(agent_memory_max ANTIGRAVITY_MEMORY_MAX 4G)"
start_role_process "$mem_max" sudo -u "$ORCHESTRATOR_USER" -- \
  bash -c "$(role_exec_bash)" bash \
  "$ANTIGRAVITY_BIN" \
    -i "$(cat "$SCRIPT_DIR/roles/orchestrator.md" 2>/dev/null || cat "roles/orchestrator.md")

Law: AGENTS.md (auto-loaded as GEMINI.md). Confirm pwd once, then wait for a directive." \
    --add-dir "$SANDBOX_DIR" \
    "${EXTRA_ARGS[@]}"
