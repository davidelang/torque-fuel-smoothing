# landlock.config.example: reference twin of landlock.config (same grants).
# git_home, orch_root and sandbox_dir come from project.config only.

# Live writes: worktree .gradle-home (GRADLE_USER_HOME), .gradle (project),
# .android-shared. Do not set GRADLE_USER_HOME to $orch_root/.gradle-shared.

[profile.android]
path=.android-shared
path=env:HOME/.android

[profile.gradle]
path=env:HOME/.gradle
path=.gradle
path=.gradle-home
