# roles.config: per-role launch settings, read by .grok/lib/grok-launch-common.sh
# and the run-antigravity* launchers. One line per role: <role> key=value ...
#   model   model id (blank = tool default)
#   effort  reasoning effort (low|medium|high|xhigh)
#   context context window. grok has no CLI flag for it. The launcher prints the
#           in-session command `/context-window <size>` to run once.
#           TODO-VERIFY: confirm 512k is offered for the chosen model (G04 shows 500k).
#   retry_effort effort used when a child is re-run after a failure
#   cursor_model       cursor-agent model for run-cursor* (blank = cursor default)
#   cursor_retry_model cursor-agent model when a child is re-run after a failure
#           Cursor encodes effort in the id (grok-4.7-medium, grok-4.7-high; -fast
#           variants exist; no 500k variant). Parameterized overrides such as
#           'model[effort=high]' are also accepted. Ids: `cursor-agent --list-models`.
# Local overrides: project.config keys <role>_model / <role>_effort win.
orchestrator model=grok-4.7 effort=high   context=512k cursor_model=grok-4.7-high
planner      model=grok-4.7 effort=high   context=512k cursor_model=grok-4.7-high
coder        model=grok-4.7 effort=medium context=256k cursor_model=grok-4.7-medium
master       model=grok-4.7 effort=medium context=256k cursor_model=grok-4.7-medium
executor     model=grok-4.7 effort=high   context=256k retry_effort=xhigh cursor_model=composer-2.5 cursor_retry_model=grok-4.7-xhigh
reviewer     model=grok-4.7 effort=high   context=256k cursor_model=grok-4.7-high
tester       model=grok-4.7 effort=high   context=256k cursor_model=grok-4.7-high
primary      model=       effort=         context=
