#!/usr/bin/env python3
"""Capture manual screenshots by running script-android-app.

One serial is one copy. Two serials are two copies at the same time: this
process assigns phone and tablet, then starts both. One copy failing does
not stop the other. The walk, the JPEGs, and the notes are still the driver's.

  ./capture-manual-screenshots --check
  ./capture-manual-screenshots --serial SERIAL [--form phone|tablet] [--locales all|TAG] [--shots GROUP,FILE] [--replace]
  ./capture-manual-screenshots --serial SERIAL --serial SERIAL [--locales all|TAG] [--shots GROUP,FILE] [--replace]
"""
from __future__ import annotations

import argparse
import importlib.util
import subprocess
import sys
from pathlib import Path

TOOL = Path(__file__).with_name("script-android-app")


def _driver():
    spec = importlib.util.spec_from_file_location("script_android_app", TOOL)
    if spec is None or spec.loader is None:
        print(f"ERROR: cannot load {TOOL}", file=sys.stderr)
        raise SystemExit(1)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def _cmd(root: str, config: str, extra: list[str]) -> list[str]:
    return [sys.executable, str(TOOL), "--root", root, "--config", config, *extra]


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", default="manual-capture.yaml")
    parser.add_argument("--root", default=".")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--form", choices=["phone", "tablet"])
    parser.add_argument("--serial", action="append", dest="serials")
    parser.add_argument("--locales", default=None)
    parser.add_argument("--shots", default=None)
    parser.add_argument("--replace", action="store_true")
    args = parser.parse_args(argv)
    if args.check:
        return subprocess.call(_cmd(args.root, args.config, ["--check"]))
    serials = list(args.serials or [])
    if len(serials) not in (1, 2) or len(set(serials)) != len(serials):
        print("ERROR: pass one or two distinct --serial values", file=sys.stderr)
        return 1
    if len(serials) == 2 and args.form:
        print("ERROR: two --serial values do not take --form", file=sys.stderr)
        return 1
    extra: list[str] = []
    if args.shots:
        extra.extend(["--shots", args.shots])
    if args.replace:
        extra.append("--replace")
    if len(serials) == 1:
        one = ["--serial", serials[0], *extra]
        if args.form:
            one.extend(["--form", args.form])
        if args.locales is not None:
            one.extend(["--locales", args.locales])
        return subprocess.call(_cmd(args.root, args.config, one))
    if args.locales is not None:
        extra.extend(["--locales", args.locales])
    else:
        extra.extend(["--locales", "all"])
    root = Path(args.root).resolve()
    config = Path(args.config)
    if not config.is_absolute():
        config = root / config
    driver = _driver()
    try:
        app = driver.App(root, driver._load_yaml(config))
    except SystemExit as exc:
        print(exc, file=sys.stderr)
        return 1
    devices = subprocess.run(["adb", "devices"], capture_output=True, text=True).stdout
    for serial in serials:
        if serial not in devices:
            print(f"ERROR: {serial} not in adb devices", file=sys.stderr)
            return 1
    assigned = driver._assign(app, serials, None)
    if assigned is None:
        return 1
    procs = []
    for serial, form in assigned:
        procs.append(
            subprocess.Popen(_cmd(args.root, args.config, ["--serial", serial, "--form", form, *extra]))
        )
    failed = False
    for proc in procs:
        if proc.wait() != 0:
            failed = True
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
