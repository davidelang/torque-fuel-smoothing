#!/usr/bin/env python3
"""Capture manual screenshots from a per-app config.

The walk is data: manual-capture.yaml names string ids and the order of
primitives. This file is the driver. A hook exists for a gesture this list
cannot say. On a later audit, every hook is either a missing primitive, a
walk that should have been steps, or a real one-app exception. David runs a
capture. --check validates the config and does not touch a device.

  ./capture-manual-screenshots --check
  ./capture-manual-screenshots --serial SERIAL [--form phone|tablet] [--locales all|TAG] [--shots GROUP,FILE] [--replace]
  ./capture-manual-screenshots --serial SERIAL --serial SERIAL [--locales all|TAG] [--shots GROUP,FILE] [--replace]

One serial and no --form classifies the device by physical diagonal
(phone_max_inches). Two serials assign the larger diagonal to tablet. A gap
under gap_inches exits before any shot. Without --replace, a selected JPEG of
at least 1000 bytes is kept, and a locale whose selected shots are all that
size is not opened.
"""
from __future__ import annotations

import argparse
import importlib.util
import math
import re
import subprocess
import sys
import threading
import time
import xml.etree.ElementTree as ET
from dataclasses import dataclass
