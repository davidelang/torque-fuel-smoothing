# project.config.example
# Committed template. Copy to project.config (gitignored) and fill real values.
# Used by clean/smudge filters (manage-configs) and setup-project.

@@SANDBOX_PATH@@_path=@@SANDBOX_PATH@@
planning_user=@@PLANNING_USER@@
coder_user=@@CODER_USER@@
orchestrator_user=@@ORCHESTRATOR_USER@@
code_group=@@CODE_GROUP@@
@@SANDBOX_PATH@@_group=@@SANDBOX_GROUP@@
shared_group=@@SHARED_GROUP@@

# Example paths (will be @@ substituted in scripts via manage-configs filter)
# Bin paths may use $HOME/… (expanded at runtime by launchers).
grok_bin_default=@@GROK_BIN_DEFAULT@@
antigravity_bin=@@ANTIGRAVITY_BIN@@
gemini_bin_default=@@GEMINI_BIN_DEFAULT@@
primary_user=@@PRIMARY_USER@@

# Absolute directory holding first-party / pin host clones (remotetable, extractmail, …).
# MUST be absolute on this machine (e.g. /home/you/git), NOT ~/git:
#   - @@CODER_USER@@ / @@PLANNING_USER@@ have different $HOME; ~/git is not shared.
#   - Landlock and open() need a concrete path.
# Checked-in templates use @@GIT_HOME@@; local project.config has the real path.
# landlock.config (tracked) is smudged from the same git_home= / @@SANDBOX_PATH@@_path=.
git_home=@@GIT_HOME@@

# Special @@SANDBOX_PATH@@ paths (for setup-project to create)
@@SANDBOX_PATH@@_special_paths=plans,historical-plans,implementation-failure-logs,PRs,research

# Prefer @@SANDBOX_PATH@@_dir for launchers/generate_pr (generic hosts).
# VehicleExpenses default: dev-ai-interaction
# Library hosts default: @@SANDBOX_PATH@@
# Legacy alias still accepted: @@SANDBOX_PATH@@_path
# @@SANDBOX_PATH@@_dir=dev-ai-interaction
# @@SANDBOX_PATH@@_dir=@@SANDBOX_PATH@@

# Optional build gate for master-merge on non-Android hosts:
# build_command=./build

# landlock.config is smudged separately (landlock.config.example); it may
# reference @@GIT_HOME@@ for host .git allow paths.

# Users/groups creation (for reference in setup-project, emitted only)
# groupadd @@CODE_GROUP@@
# groupadd @@SANDBOX_GROUP@@
# groupadd @@SHARED_GROUP@@
# useradd -g @@SANDBOX_GROUP@@ @@PLANNING_USER@@
# useradd -g @@CODE_GROUP@@ @@CODE_GROUP@@r
# useradd -g @@CODE_GROUP@@ -G @@SHARED_GROUP@@ @@ORCHESTRATOR_USER@@
# usermod -aG @@CODE_GROUP@@ @@ORCHESTRATOR_USER@@

# Notes for filters: use @@VAR@@ in source scripts for substitution.
