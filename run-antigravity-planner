#!/bin/bash
# run-antigravity-planner — Antigravity launcher for the planner role.
# Same rules as run-grok-planner: law AGENTS.md (auto-loaded as GEMINI.md) + roles/planner.md.
# Runs as planning_user. Args after `--` go to antigravity.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Config: project.config next to this script is the one source; missing values fail.
_cfg="$SCRIPT_DIR/project.config"
[ -f "$_cfg" ] || { echo "ERROR: $_cfg missing" >&2; exit 1; }
while IFS= read -r _line || [ -n "$_line" ]; do
  _line="${_line%%#*}"
  _line="${_line#"${_line%%[![:space:]]*}"}"
  [[ "$_line" =~ ^[a-zA-Z_][a-zA-Z0-9_]*= ]] || continue
  export "$_line"
done < "$_cfg"
need_cfg() { local v; v=$(sed -n "s/^$1=//p" "$_cfg" | tr -d '\r' | tail -1); [[ -n "$v" && "$v" != *@@* ]] || { echo "ERROR: $1 has no value in $_cfg" >&2; exit 1; }; printf '%s' "$v"; }
SANDBOX_REL=$(need_cfg sandbox_dir) || exit 1
SANDBOX_DIR="$SCRIPT_DIR/$SANDBOX_REL"
[ -d "$SANDBOX_DIR" ] || { echo "ERROR: sandbox_dir=$SANDBOX_REL is not a directory under $SCRIPT_DIR" >&2; exit 1; }
PLANNING_USER=$(need_cfg planning_user) || exit 1
ANTIGRAVITY_BIN=$(need_cfg antigravity_bin) || exit 1
ANTIGRAVITY_BIN="${ANTIGRAVITY_BIN//\$HOME/$HOME}"

# Ensure all files created during this session are group-writable (multi-user env)
umask 007

# === Model selection for Planning Agent ===
DEFAULT_PLANNER_MODEL="Gemini 3.5 Flash (High)"
PLANNER_MODEL="${ANTIGRAVITY_PLANNER_MODEL:-$DEFAULT_PLANNER_MODEL}"


echo "Launching dedicated Planning Agent in $(pwd)..."
echo "Antigravity binary: $ANTIGRAVITY_BIN"
echo "Sandbox path: $SANDBOX_DIR"
echo "Forcing planning model: $PLANNER_MODEL"
echo "Tip: For easier multi-line plans and prompts, focus the input and press Ctrl+M (or type /multiline or /ml) to enable multiline input mode (Enter inserts newline; Shift+Enter or Alt+Enter sends)."

# Support -- to pass raw params to antigravity.
EXTRA_ARGS=()
FOUND_DD=0
for arg in "$@"; do
  if [ "$FOUND_DD" -eq 1 ]; then
    EXTRA_ARGS+=("$arg")
  elif [ "$arg" = "--" ]; then
    FOUND_DD=1
  fi
done

# Role card + law, as for run-grok-planner.
PLANNING_PROMPT="$(cat "$SCRIPT_DIR/roles/planner.md" 2>/dev/null || cat "roles/planner.md")

Law: AGENTS.md (auto-loaded as GEMINI.md). Confirm pwd once, then wait for a directive."

ROLE_KEY=planner
AGENT_OOM_FUNCS_ONLY=1
# shellcheck source=/dev/null
source "$SCRIPT_DIR/.grok/lib/grok-launch-common.sh" || exit 1
mem_max="$(agent_memory_max ANTIGRAVITY_MEMORY_MAX 4G)"
start_role_process "$mem_max" sudo -u "$PLANNING_USER" -- \
  bash -c "$(role_exec_bash)" bash \
  "$ANTIGRAVITY_BIN" \
    -i "$PLANNING_PROMPT" \
    --model "$PLANNER_MODEL" \
    --add-dir "$SANDBOX_DIR" \
    "${EXTRA_ARGS[@]}"
