# --- third_party consumer (managed by apply-third-party-gitignore.sh) ---
# third_party: ignore checkouts/local state; track tool + pin contract under each lib dir
third_party/*
!third_party/fetch-deps
!third_party/get-artifacts
!third_party/libpin-bwrap
!third_party/libpin-landlock
!third_party/libpin-sandbox
!third_party/README.md
!third_party/*/
third_party/*/src/
third_party/*/status.local
third_party/*/*.local
# --- end third_party consumer ---
