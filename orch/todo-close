#!/bin/bash
# todo-close — mark exactly one open "- [ ]" TODO.md item done ([x]).
# Usage: todo-close 'exact text'   Fixed-string match on the open item's text (incl. continuations).
# Exactly one open item must match; otherwise nothing changes and it exits 1 listing the matches.
set -euo pipefail
if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  echo "Usage: ./orch/todo-close 'exact text of one open - [ ] item'"
  exit 0
fi
umask 007
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TODOFILE="$SCRIPT_DIR/TODO.md"
[ $# -ge 1 ] && [ -n "$*" ] || { echo "Usage: $(basename "$0") 'exact text of one open - [ ] item'" >&2; exit 2; }
[ -r "$TODOFILE" ] && [ -w "$TODOFILE" ] || { echo "ERROR: $TODOFILE missing or not writable by $(id -un)" >&2; exit 2; }
export PAT="$*"
# Line numbers of open items whose text (first line + continuations) contains PAT.
matches=$(awk '
  function flush() { if (start && index(text, ENVIRON["PAT"]) > 0) print start; start = 0; text = "" }
  /^[ \t]+[^ \t]/ && start { text = text "\n" $0; next }
  /^[-*] \[ \] /          { flush(); start = NR; text = $0; next }
                          { flush() }
  END { flush() }' "$TODOFILE")
n=$(awk 'NF{c++} END{print c+0}' <<< "$matches")
if [ "$n" -ne 1 ]; then
  if [ "$n" -eq 0 ]; then
    echo "ERROR: no open '- [ ]' item contains: $PAT" >&2
    echo "Run ./orch/todo-open to list open items. [future] items have no checkbox and cannot be closed here." >&2
  else
    echo "ERROR: $n open items contain: $PAT — quote more of one:" >&2
    for l in $matches; do awk -v l="$l" 'NR == l { print "L" NR ": " $0 }' "$TODOFILE" >&2; done
  fi
  exit 1
fi
# Temp stays in work-history/ (the directory the planner can write). Not /tmp:
# a rewrite uses cat onto the target, and /tmp is a tmpfs we do not leave files on.
if [ -d "$SCRIPT_DIR/work-history" ]; then
  tmp=$(mktemp "$SCRIPT_DIR/work-history/.TODO.md.XXXXXX")
else
  tmp=$(mktemp "$SCRIPT_DIR/.TODO.md.XXXXXX")
fi
trap 'rm -f "$tmp"' EXIT
awk -v l="$matches" 'NR == l { sub(/\[ \]/, "[x]") } { print }' "$TODOFILE" > "$tmp"
cat "$tmp" > "$TODOFILE"
echo "Closed L$matches: $(awk -v l="$matches" 'NR == l' "$TODOFILE")"
