#!/bin/bash
# ve-resolve-orch — resolve the absolute orchestration root.
#
# Source from a worktree helper (does not set -e; returns 1 on failure):
#   . "$(dirname "$0")/ve-resolve-orch"
#   ve_resolve_orch WORKTREE              # sets ORCH_ROOT (WORKTREE or $VE_RESOLVE_ORCH_WT is required)
#
# Exec:
#   ./orch/ve-resolve-orch WORKTREE-DIR        # prints absolute path; exit 1 if missing
#
# Order: $ORCH_ROOT if it is a directory; else orch_root= from that tree's
# project.config (absolute, existing directory, not @@TOKEN@@). Never walk to
# ../.gradle-shared. Fail loud — run ./update-rules.sh from the orchestration root.

ve_resolve_orch_worktree() {
  if [ -n "${1:-}" ]; then
    (cd "$1" && pwd)
    return
  fi
  if [ -n "${VE_RESOLVE_ORCH_WT:-}" ]; then
    (cd "$VE_RESOLVE_ORCH_WT" && pwd)
    return
  fi
  # No guessing from this file's location or the current directory: the caller names the tree.
  echo "ERROR: ve-resolve-orch: no worktree given (pass it as the argument or set VE_RESOLVE_ORCH_WT)" >&2
  return 1
}

ve_read_orch_root_from_config() {
  local cfg="$1"
  local val=""
  [ -f "$cfg" ] || return 1
  val=$(sed -n 's/^orch_root=//p' "$cfg" | tr -d '\r' | head -1)
  [ -n "$val" ] || return 1
  case "$val" in
    @@*) return 1 ;;
    /*) ;;
    *) return 1 ;;
  esac
  [ -d "$val" ] || return 1
  (cd "$val" && pwd)
}

# Sets ORCH_ROOT. Arg: worktree directory (required unless VE_RESOLVE_ORCH_WT is set).
ve_resolve_orch() {
  local wt
  wt="$(ve_resolve_orch_worktree "${1:-}")" || return 1
  if [ -n "${ORCH_ROOT:-}" ] && [ -d "${ORCH_ROOT}" ]; then
    ORCH_ROOT="$(cd "$ORCH_ROOT" && pwd)"
    return 0
  fi
  ORCH_ROOT="$(ve_read_orch_root_from_config "$wt/project.config")" || {
    echo "ERROR: orch_root unset or invalid in $wt/project.config." >&2
    echo "  Run ./update-rules.sh from the orchestration root to stamp orch_root=." >&2
    return 1
  }
  return 0
}

ve_upsert_project_config_key() {
  local file="$1" key="$2" val="$3"
  local tmp
  mkdir -p "$(dirname "$file")"
  if [ ! -f "$file" ]; then
    printf '%s=%s\n' "$key" "$val" > "$file"
    return 0
  fi
  if grep -q "^${key}=" "$file"; then
    tmp="${file}.tmp.$$"
    sed "s|^${key}=.*|${key}=${val}|" "$file" > "$tmp"
    mv "$tmp" "$file"
  else
    printf '%s=%s\n' "$key" "$val" >> "$file"
  fi
}

# Seed/refresh WT project.config: always set orch_root; copy missing keys from orch.
ve_seed_worktree_project_config() {
  local wt="$1"
  local orch="$2"
  local orch_cfg="${3:-$orch/project.config}"
  local pc="$wt/project.config"
  local k v
  if [ ! -f "$orch_cfg" ]; then
    echo "ERROR: $orch_cfg missing; cannot seed $pc" >&2
    return 1
  fi
  [ -f "$pc" ] || cp "$orch_cfg" "$pc"
  ve_upsert_project_config_key "$pc" orch_root "$orch"
  {
    while IFS='=' read -r k v || [ -n "${k:-}" ]; do
      k="${k%%#*}"
      k="${k#"${k%%[![:space:]]*}"}"
      [[ "$k" =~ ^[a-z_]+$ ]] || continue
      [ -n "${v:-}" ] || continue
      if ! grep -q "^${k}=" "$pc"; then
        printf '%s=%s\n' "$k" "$v" >> "$pc"
      fi
    done < "$orch_cfg"
  }
}

# chmod MODE PATH only when PATH's mode differs (perm-model.tsv worktree-build-homes: 2770
# dirs). A chmod that is needed and fails is an error naming the owner.
ve_set_mode() {
  local mode="$1" p="$2" cur
  cur=$(stat -c %a "$p") || return 1
  [ "$cur" = "$mode" ] && return 0
  chmod "0$mode" "$p" || {
    echo "ERROR: cannot chmod $mode $p (owner $(stat -c %U "$p"), mode $cur, running as $(id -un))" >&2
    return 1
  }
}

# After ve_resolve_orch: worktree Gradle/Android homes. Writes stay under $wt.
# orch is read/seed only. Does not create daemon/ (launchers run as dlang).
ve_setup_worktree_build_homes() {
  local wt src dest
  wt="$(ve_resolve_orch_worktree "${1:-}")" || return 1
  if [ -z "${ORCH_ROOT:-}" ] || [ ! -d "${ORCH_ROOT}" ]; then
    echo "ERROR: ve_setup_worktree_build_homes: ORCH_ROOT unset; call ve_resolve_orch first." >&2
    return 1
  fi

  mkdir -p -m 2770 "$wt/.gradle-home" || {
    echo "ERROR: cannot create $wt/.gradle-home" >&2
    return 1
  }
  ve_set_mode 2770 "$wt/.gradle-home" || return 1

  mkdir -p -m 2770 "$wt/.android-shared" || {
    echo "ERROR: cannot create $wt/.android-shared" >&2
    return 1
  }
  ve_set_mode 2770 "$wt/.android-shared" || return 1

  dest="$wt/.android-shared/debug.keystore"
  src="$ORCH_ROOT/.android-shared/debug.keystore"
  if [ ! -f "$dest" ]; then
    if [ -f "$src" ]; then
      cp "$src" "$dest" || {
        echo "ERROR: cannot copy debug.keystore from $src to $dest" >&2
        return 1
      }
      ve_set_mode 660 "$dest" || return 1
    else
      echo "ERROR: no debug.keystore at $dest and none at $src" >&2
      echo "  Copy a canonical debug.keystore to $src" >&2
      return 1
    fi
  fi

  export GRADLE_USER_HOME="$wt/.gradle-home"
  export ANDROID_USER_HOME="$wt/.android-shared"
  return 0
}

# Remove $GRADLE_USER_HOME/daemon so the builder owns the next mkdir.
# Gradle hardcodes chmod 700 on that tree. Do not chmod it here.
ve_reset_gradle_daemon_dir() {
  local home="${GRADLE_USER_HOME:-}"
  if [ -z "$home" ]; then
    echo "ERROR: ve_reset_gradle_daemon_dir: GRADLE_USER_HOME unset" >&2
    return 1
  fi
  case "$home" in
    */.gradle-home) ;;
    *)
      echo "ERROR: GRADLE_USER_HOME is not a worktree .gradle-home: $home" >&2
      return 1
      ;;
  esac
  if [ -e "$home/daemon" ]; then
    rm -rf "$home/daemon" || {
      echo "ERROR: cannot remove $home/daemon (do not chmod it)." >&2
      echo "  Remove as the owner, or fix group write on $home." >&2
      return 1
    }
  fi
  return 0
}

# AGP Maven aapt2 (com.android.tools.build:aapt2 classifier linux) is stored
# unix 0644 in the jar. After extract, Gradle's transform cache drops +x, so
# ProcessBuilder gets EACCES ("AAPT2 Daemon startup failed"). Point AGP at
# the SDK build-tools binary instead (android.aapt2FromMavenOverride = file).
# Android SDK root: sdk.dir from the worktree's local.properties, else $ANDROID_HOME. Neither set
# is an error naming both. Prints the directory.
ve_android_sdk_dir() {
  local wt props sdk=""
  wt="$(ve_resolve_orch_worktree "${1:-}")" || return 1
  props="$wt/local.properties"
  if [ -f "$props" ]; then
    sdk=$(sed -n 's/^sdk\.dir=//p' "$props" | tr -d '\r' | head -1)
  fi
  if [ -n "$sdk" ]; then
    printf '%s\n' "$sdk"
    return 0
  fi
  if [ -n "${ANDROID_HOME:-}" ]; then
    printf '%s\n' "$ANDROID_HOME"
    return 0
  fi
  echo "ERROR: no Android SDK: sdk.dir is not set in $props and ANDROID_HOME is not set." >&2
  echo "  Set one of them to the Android SDK root (must contain build-tools/*/aapt2)." >&2
  return 1
}

ve_aapt2_from_sdk() {
  local sdk ver aapt
  sdk=$(ve_android_sdk_dir "${1:-}") || return 1
  if [ ! -d "$sdk/build-tools" ]; then
    echo "ERROR: no build-tools directory under the Android SDK $sdk" >&2
    return 1
  fi
  while IFS= read -r ver; do
    [ -n "$ver" ] || continue
    aapt="$sdk/build-tools/$ver/aapt2"
    if [ -f "$aapt" ] && [ -x "$aapt" ]; then
      printf '%s\n' "$aapt"
      return 0
    fi
  done < <(find "$sdk/build-tools" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort -V -r)
  echo "ERROR: no executable aapt2 under $sdk/build-tools/*/aapt2" >&2
  echo "  Install Android SDK build-tools, or ensure aapt2 is a regular executable file." >&2
  return 1
}

# Incremental app/build is same-uid only. If intermediates/generated/kspCaches
# are owned by someone else, Gradle chmod on leftover dest dirs fails.
# Wipe those trees (group write, no sticky). Do not chmod/chown them.
ve_wipe_foreign_app_build_outputs() {
  local me d owner need=0
  me=$(id -un)
  for d in app/build/intermediates app/build/generated app/build/kspCaches; do
    if [ -e "$d" ]; then
      owner=$(stat -c %U "$d") || return 1
      if [ "$owner" != "$me" ]; then
        need=1
        break
      fi
    fi
  done
  if [ "$need" -eq 0 ]; then
    return 0
  fi
  echo "Wiping foreign app/build outputs (not owned by $me)..."
  rm -rf app/build/intermediates app/build/generated app/build/kspCaches || {
    echo "ERROR: cannot remove foreign app/build outputs (do not chmod them)." >&2
    return 1
  }
  for d in app/build/intermediates app/build/generated app/build/kspCaches; do
    if [ -e "$d" ]; then
      echo "ERROR: still present after wipe: $d" >&2
      ls -ld "$d" >&2
      echo "  Remove as the owner. Do not chmod." >&2
      return 1
    fi
  done
  return 0
}

# Restore other-execute on tracked 100755 helpers.
# umask 007 + git checkout writes 770; o+r-only passes leave 774.
# ai-planner is not in ai-code, so 774 dlang:ai-code is Permission denied.
# Always chmod a+x (umask-proof). Never chmod +x under umask 007.
# Taken from orchestration:ve-resolve-orch (union with ve_aapt2_from_sdk).
# Callers on orch: update-rules.sh / setup_agent.sh — not build_app/deploy.
# Only files missing an x bit are chmodded; one this user cannot chmod is an error that
# names its owner (instead of a later "Permission denied" when someone runs it).
ve_add_other_x() {
  local f="$1" cur
  cur=$(stat -c %a "$f") || return 1
  [ $(( 0$cur & 0111 )) -eq $(( 0111 )) ] && return 0
  chmod a+x "$f" || {
    echo "ERROR: cannot chmod a+x $f (owner $(stat -c %U "$f"), mode $cur, running as $(id -un))" >&2
    return 1
  }
}

ve_ensure_tracked_exec_other_x() {
  local wt="${1:-}"
  local p mode _hash _stage files
  if [ -z "$wt" ] || [ ! -d "$wt" ]; then
    echo "ERROR: ve_ensure_tracked_exec_other_x: not a directory: '$wt'" >&2
    return 1
  fi
  for p in orch/agent-landlock orch/todo-append orch/todo-close orch/env \
           orch/landlock-smoke-matrix orch/landlock-write-probe; do
    if [ -f "$wt/$p" ]; then
      ve_add_other_x "$wt/$p" || return 1
    fi
  done
  files=$(git -C "$wt" ls-files -s) || {
    echo "ERROR: ve_ensure_tracked_exec_other_x: $wt is not a git worktree" >&2
    return 1
  }
  while read -r mode _hash _stage p; do
    [ "$mode" = "100755" ] || continue
    [ -n "$p" ] || continue
    if [ -f "$wt/$p" ]; then
      ve_add_other_x "$wt/$p" || return 1
    fi
  done <<< "$files"
  return 0
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  set -euo pipefail
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    echo "Usage: ./orch/ve-resolve-orch [WORKTREE]"
    echo "Print orch_root. With no argument, VE_RESOLVE_ORCH_WT must be set."
    exit 0
  fi
  ve_resolve_orch "${1:-}" || exit 1   # no argument and no VE_RESOLVE_ORCH_WT = error
  printf '%s\n' "$ORCH_ROOT"
fi
