#!/usr/bin/env python3
"""agent-landlock — mutation-only Landlock for run-grok* / session agents.

Applies a Landlock domain that handles only filesystem *mutation* (write,
create, remove, truncate, refer). Read and execute stay unhandled → unrestricted.

Usage:
  agent-landlock --status
  agent-landlock --role ROLE --worktree DIR [--dump-grants]
  agent-landlock --role ROLE --worktree DIR -- command…

Roles: primary | planner | coder | master | orchestrator

Env:
  AGENT_LANDLOCK_DISABLE=1   skip restriction (exec bare)
  AGENT_LANDLOCK_DEBUG=1     stderr grant list
  AGENT_LANDLOCK_STRICT=1    exit non-zero if ABI missing / apply fails (default: warn + bare exec)
  GIT_HOME                   host clone root override (else project.config / landlock.config)

Design: dev-ai-interaction/research/agent-landlock-session-design-20260803.md
Spirit of ABI helpers: third_party/libpin-landlock (pin-inner; this is session-outer).
"""
from __future__ import annotations

import argparse
import ctypes
import ctypes.util
import os
import sys
from pathlib import Path
from typing import Dict, Iterable, List, Optional, Sequence, Set, Tuple

# linux/landlock.h
LANDLOCK_CREATE_RULESET_VERSION = 1 << 0
LANDLOCK_RULE_PATH_BENEATH = 1

LANDLOCK_ACCESS_FS_EXECUTE = 1 << 0
LANDLOCK_ACCESS_FS_WRITE_FILE = 1 << 1
LANDLOCK_ACCESS_FS_READ_FILE = 1 << 2
LANDLOCK_ACCESS_FS_READ_DIR = 1 << 3
LANDLOCK_ACCESS_FS_REMOVE_DIR = 1 << 4
LANDLOCK_ACCESS_FS_REMOVE_FILE = 1 << 5
LANDLOCK_ACCESS_FS_MAKE_CHAR = 1 << 6
LANDLOCK_ACCESS_FS_MAKE_DIR = 1 << 7
LANDLOCK_ACCESS_FS_MAKE_REG = 1 << 8
LANDLOCK_ACCESS_FS_MAKE_SOCK = 1 << 9
LANDLOCK_ACCESS_FS_MAKE_FIFO = 1 << 10
LANDLOCK_ACCESS_FS_MAKE_BLOCK = 1 << 11
LANDLOCK_ACCESS_FS_MAKE_SYM = 1 << 12
LANDLOCK_ACCESS_FS_REFER = 1 << 13
LANDLOCK_ACCESS_FS_TRUNCATE = 1 << 14
LANDLOCK_ACCESS_FS_IOCTL_DEV = 1 << 15

HANDLED_FS = (
    LANDLOCK_ACCESS_FS_WRITE_FILE
    | LANDLOCK_ACCESS_FS_REMOVE_DIR
    | LANDLOCK_ACCESS_FS_REMOVE_FILE
    | LANDLOCK_ACCESS_FS_MAKE_CHAR
    | LANDLOCK_ACCESS_FS_MAKE_DIR
    | LANDLOCK_ACCESS_FS_MAKE_REG
    | LANDLOCK_ACCESS_FS_MAKE_SOCK
    | LANDLOCK_ACCESS_FS_MAKE_FIFO
    | LANDLOCK_ACCESS_FS_MAKE_BLOCK
    | LANDLOCK_ACCESS_FS_MAKE_SYM
    | LANDLOCK_ACCESS_FS_REFER
    | LANDLOCK_ACCESS_FS_TRUNCATE
)

ALLOWED_BENEATH = HANDLED_FS
FILE_ACCESS = LANDLOCK_ACCESS_FS_WRITE_FILE | LANDLOCK_ACCESS_FS_TRUNCATE

PR_SET_NO_NEW_PRIVS = 38
O_PATH = 0o10000000
O_CLOEXEC = 0o2000000
O_DIRECTORY = 0o200000

_SYS = {
    "x86_64": (444, 445, 446),
    "amd64": (444, 445, 446),
    "aarch64": (444, 445, 446),
    "arm64": (444, 445, 446),
}

ROLES = ("primary", "planner", "coder", "master", "orchestrator")


class LandlockRulesetAttr(ctypes.Structure):
    _fields_ = [("handled_access_fs", ctypes.c_uint64)]


class LandlockPathBeneathAttr(ctypes.Structure):
    _fields_ = [
        ("allowed_access", ctypes.c_uint64),
        ("parent_fd", ctypes.c_int32),
    ]


def _debug(msg: str) -> None:
    if os.environ.get("AGENT_LANDLOCK_DEBUG", "0") in ("1", "true", "yes"):
        print(f"agent-landlock: {msg}", file=sys.stderr)


def _warn(msg: str) -> None:
    print(f"agent-landlock: WARN {msg}", file=sys.stderr)


def _machine_syscalls() -> Optional[Tuple[int, int, int]]:
    import platform

    mach = platform.machine().lower()
    if mach in _SYS:
        return _SYS[mach]
    return (444, 445, 446)


def _libc():
    return ctypes.CDLL(ctypes.util.find_library("c") or "libc.so.6", use_errno=True)


def landlock_abi_version() -> Optional[int]:
    if sys.platform != "linux":
        return None
    nrs = _machine_syscalls()
    if not nrs:
        return None
    libc = _libc()
    create_nr, _, _ = nrs
    ver = libc.syscall(
        create_nr, None, ctypes.c_size_t(0), LANDLOCK_CREATE_RULESET_VERSION
    )
    if ver < 0:
        return None
    return int(ver)


def _prctl_no_new_privs(libc) -> None:
    r = libc.prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0)
    if r != 0:
        e = ctypes.get_errno()
        raise OSError(e, f"prctl(NO_NEW_PRIVS) failed: {os.strerror(e)}")


def _open_path_fd(path: str, directory: bool) -> int:
    if directory:
        p = Path(path).resolve()
        if not p.exists():
            p.mkdir(parents=True, exist_ok=True)
        flags = O_PATH | O_CLOEXEC | O_DIRECTORY
        return os.open(str(p), flags)
    if not os.path.exists(path):
        raise FileNotFoundError(path)
    flags = O_PATH | O_CLOEXEC
    return os.open(path, flags)


def _add_path_rule(
    libc, add_nr: int, ruleset_fd: int, path: str, directory: bool
) -> None:
    parent_fd = _open_path_fd(path, directory=directory)
    try:
        access = ALLOWED_BENEATH if directory else FILE_ACCESS
        pb = LandlockPathBeneathAttr(access, parent_fd)
        r = libc.syscall(
            add_nr,
            ctypes.c_int(ruleset_fd),
            ctypes.c_uint(LANDLOCK_RULE_PATH_BENEATH),
            ctypes.byref(pb),
            ctypes.c_uint32(0),
        )
        if r != 0:
            e = ctypes.get_errno()
            raise OSError(e, f"landlock_add_rule({path}): {os.strerror(e)}")
        _debug(f"allow mutation under {path} (dir={directory})")
    finally:
        os.close(parent_fd)


def apply_landlock(dir_paths: Sequence[str], file_paths: Sequence[str] = ()) -> None:
    nrs = _machine_syscalls()
    if not nrs:
        raise OSError("unsupported architecture for landlock syscalls")
    create_nr, add_nr, restrict_nr = nrs
    libc = _libc()

    attr = LandlockRulesetAttr(HANDLED_FS)
    ruleset_fd = libc.syscall(
        create_nr,
        ctypes.byref(attr),
        ctypes.c_size_t(ctypes.sizeof(attr)),
        ctypes.c_uint32(0),
    )
    if ruleset_fd < 0:
        e = ctypes.get_errno()
        raise OSError(e, f"landlock_create_ruleset: {os.strerror(e)}")

    try:
        dirs: List[str] = list(dir_paths)
        for t in (
            os.environ.get("TMPDIR"),
            os.environ.get("TEMP"),
            os.environ.get("TMP"),
            "/tmp",
            "/var/tmp",
        ):
            if t and os.path.isdir(t):
                dirs.append(t)

        files = list(file_paths) + [
            "/dev/null",
            "/dev/zero",
            "/dev/full",
            "/dev/urandom",
            "/dev/random",
            "/dev/tty",
        ]

        seen_dirs: Set[str] = set()
        n_ok = 0
        for raw in dirs:
            if not raw:
                continue
            try:
                resolved = str(Path(raw).resolve())
            except Exception:
                resolved = raw
            if resolved in seen_dirs:
                continue
            seen_dirs.add(resolved)
            try:
                _add_path_rule(libc, add_nr, ruleset_fd, resolved, directory=True)
                n_ok += 1
            except OSError as exc:
                _debug(f"skip dir {resolved}: {exc}")

        seen_files: Set[str] = set()
        for fp in files:
            if not fp or fp in seen_files:
                continue
            seen_files.add(fp)
            try:
                _add_path_rule(libc, add_nr, ruleset_fd, fp, directory=False)
                n_ok += 1
            except OSError as exc:
                _debug(f"skip file {fp}: {exc}")

        if n_ok == 0:
            raise OSError("no landlock paths could be opened")

        _prctl_no_new_privs(libc)
        r = libc.syscall(restrict_nr, ctypes.c_int(ruleset_fd), ctypes.c_uint32(0))
        if r != 0:
            e = ctypes.get_errno()
            raise OSError(e, f"landlock_restrict_self: {os.strerror(e)}")
        _debug(f"restricted (rules≈{n_ok})")
    finally:
        os.close(ruleset_fd)


def _parse_kv_file(path: Path) -> Dict[str, str]:
    out: Dict[str, str] = {}
    if not path.is_file():
        return out
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = line.split("#", 1)[0].strip()
        if not line or "=" not in line:
            continue
        k, v = line.split("=", 1)
        k, v = k.strip(), v.strip()
        if k and not k.startswith("["):
            out[k] = v
    return out


def _expand_path(p: str) -> str:
    if not p:
        return p
    home = os.environ.get("HOME", "")
    p = p.replace("$HOME", home)
    if p.startswith("~"):
        p = os.path.expanduser(p)
    return p


def _load_profile_paths(landlock_cfg: Path, worktree: Path) -> List[str]:
    """Parse profile path lines from landlock.config.

    Supported:
      [profile.android]
      path=.android-shared
      path=env:HOME/.android
      profile.android.path=...
    """
    paths: List[str] = []
    if not landlock_cfg.is_file():
        return paths
    section = ""
    for raw in landlock_cfg.read_text(encoding="utf-8", errors="replace").splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip()
            continue
        val = ""
        if line.startswith("profile.") and ".path=" in line:
            val = line.split("=", 1)[1].strip()
        elif section.startswith("profile.") and (
            line.startswith("path=") or "=" not in line
        ):
            val = line.split("=", 1)[1].strip() if line.startswith("path=") else line
        elif "_paths=" in line:
            _, csv = line.split("=", 1)
            for part in csv.split(","):
                part = part.strip()
                if part:
                    r = _resolve_grant_token(part, worktree)
                    if r:
                        paths.append(r)
            continue
        if val:
            r = _resolve_grant_token(val, worktree)
            if r:
                paths.append(r)
    return paths


def _resolve_grant_token(tok: str, worktree: Path) -> str:
    tok = tok.strip()
    if not tok or tok.startswith("@@"):
        return ""
    if tok.startswith("env:HOME/"):
        return _expand_path("$HOME/" + tok[len("env:HOME/") :])
    if tok.startswith("env:"):
        # env:VAR or env:VAR/rest
        rest = tok[4:]
        if "/" in rest:
            var, sub = rest.split("/", 1)
            base = os.environ.get(var, "")
            return str(Path(base) / sub) if base else ""
        return os.environ.get(rest, "")
    if tok.startswith("/"):
        return tok
    return str((worktree / tok).resolve())


def _sandbox_paths(worktree: Path, project: Dict[str, str], landlock: Dict[str, str]) -> List[str]:
    rel = (
        project.get("sandbox_dir")
        or project.get("sandbox_path")
        or landlock.get("sandbox_path")
        or ""
    )
    if not rel or rel.startswith("@@"):
        if (worktree / "dev-ai-interaction").exists():
            rel = "dev-ai-interaction"
        elif (worktree / "sandbox").exists():
            rel = "sandbox"
        else:
            rel = "dev-ai-interaction"
    paths: List[str] = []
    if rel.startswith("/"):
        paths.append(rel)
    else:
        linked = worktree / rel
        paths.append(str(linked.resolve()) if linked.exists() else str(linked))
        # also grant unresolved symlink path if different
        try:
            real = str(linked.resolve())
            if real != str(linked) and linked.is_symlink():
                paths.append(str(linked))  # path as named
                paths.append(real)
        except Exception:
            pass
    return paths


def _git_common_dir(worktree: Path) -> Optional[str]:
    import subprocess

    try:
        r = subprocess.run(
            ["git", "-C", str(worktree), "rev-parse", "--git-common-dir"],
            capture_output=True,
            text=True,
            check=False,
        )
        if r.returncode != 0:
            return None
        p = r.stdout.strip()
        if not p:
            return None
        gp = Path(p)
        if not gp.is_absolute():
            gp = (worktree / gp).resolve()
        return str(gp)
    except Exception:
        return None


def _libpin_host_gits(worktree: Path, git_home: str) -> List[str]:
    out: List[str] = []
    tp = worktree / "third_party"
    if not tp.is_dir() or not git_home:
        return out
    for child in tp.iterdir():
        if not child.is_dir():
            continue
        if not (child / "libpin.toml").is_file():
            continue
        host_git = Path(git_home) / child.name / ".git"
        if host_git.exists():
            out.append(str(host_git.resolve()))
    return out


def resolve_grants(
    role: str, worktree: Path
) -> Tuple[List[str], List[str], Dict[str, str]]:
    """Return (dir_paths, file_paths, meta)."""
    worktree = worktree.resolve()
    project = _parse_kv_file(worktree / "project.config")
    landlock = _parse_kv_file(worktree / "landlock.config")
    landlock_path = worktree / "landlock.config"

    git_home = os.environ.get("GIT_HOME") or project.get("git_home") or landlock.get(
        "git_home", ""
    )
    git_home = _expand_path(git_home)
    if git_home.startswith("@@"):
        git_home = ""

    orch_root = os.environ.get("ORCH_ROOT") or project.get("orch_root") or ""
    orch_root = _expand_path(orch_root)
    if orch_root.startswith("@@") or not orch_root:
        orch_root = ""
    elif not os.path.isdir(orch_root):
        orch_root = ""

    meta = {
        "role": role,
        "worktree": str(worktree),
        "git_home": git_home,
        "orch_root": orch_root,
        "abi": str(landlock_abi_version() or "unavailable"),
    }

    dirs: List[str] = []
    files: List[str] = []
    sandbox = _sandbox_paths(worktree, project, landlock)
    profiles = _load_profile_paths(landlock_path, worktree)

    # Grok (and similar CLIs) always need to mutate their session/config home.
    # Without this, "trust this directory" / session creation fails with EACCES
    # under Landlock even when the worktree grant is correct.
    home = os.environ.get("HOME") or ""
    if home:
        dirs.append(str(Path(home) / ".grok"))
        # Optional caches some CLIs use
        for sub in (".cache/grok", ".local/share/grok"):
            cand = Path(home) / sub
            if cand.is_dir():
                dirs.append(str(cand.resolve()))
    xdg_rt = os.environ.get("XDG_RUNTIME_DIR") or ""
    if xdg_rt and os.path.isdir(xdg_rt):
        dirs.append(str(Path(xdg_rt).resolve()))

    if role == "planner":
        dirs.extend(sandbox)
        # Planner may only mutate TODO.md + ENGINEERING_LOG.md at worktree root
        for name in ("TODO.md", "ENGINEERING_LOG.md"):
            fp = worktree / name
            if not fp.exists():
                try:
                    fp.touch()
                except OSError:
                    pass
            if fp.is_file():
                files.append(str(fp.resolve()))
        # Helpers live at worktree root but only write those files; no full root grant.
    elif role in ("coder", "master"):
        dirs.append(str(worktree))
        dirs.extend(sandbox)
        gcd = _git_common_dir(worktree)
        if gcd:
            dirs.append(gcd)
            meta["git_common_dir"] = gcd
        dirs.extend(_libpin_host_gits(worktree, git_home))
        # Only grant profile/build homes that already exist (do not create them).
        dirs.extend([p for p in profiles if os.path.isdir(p)])
        for cand in (
            worktree / ".android-shared",
            worktree.parent / ".android-shared",
        ):
            if cand.is_dir():
                dirs.append(str(cand.resolve()))
        gradle = worktree / ".gradle"
        if gradle.is_dir():
            dirs.append(str(gradle.resolve()))
        if orch_root:
            for name in (".gradle-shared", ".android-shared"):
                cand = Path(orch_root) / name
                if cand.is_dir():
                    dirs.append(str(cand.resolve()))
    elif role == "orchestrator":
        dirs.append(str(worktree))
        dirs.extend(sandbox)
        dirs.extend([p for p in profiles if os.path.isdir(p)])
        if orch_root:
            for name in (".gradle-shared", ".android-shared"):
                cand = Path(orch_root) / name
                if cand.is_dir():
                    dirs.append(str(cand.resolve()))
    elif role == "primary":
        if git_home and os.path.isdir(git_home):
            dirs.append(str(Path(git_home).resolve()))
        else:
            # fallback: worktree + $HOME/git if present
            hg = Path(os.environ.get("HOME", "")) / "git"
            if hg.is_dir():
                dirs.append(str(hg.resolve()))
            dirs.append(str(worktree))
        dirs.extend([p for p in profiles if os.path.isdir(p)])
        for cand in (
            worktree / ".android-shared",
            Path(os.environ.get("HOME", "")) / ".android",
            Path(os.environ.get("HOME", "")) / ".gradle",
        ):
            if cand.is_dir():
                dirs.append(str(cand.resolve()))
    else:
        raise SystemExit(f"agent-landlock: unknown role {role!r}")

    # Dedup preserve order
    def dedup(seq: Iterable[str]) -> List[str]:
        seen: Set[str] = set()
        out: List[str] = []
        for x in seq:
            if not x or x in seen:
                continue
            seen.add(x)
            out.append(x)
        return out

    return dedup(dirs), dedup(files), meta


def main(argv: Optional[Sequence[str]] = None) -> int:
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    ap.add_argument("--status", action="store_true", help="print Landlock ABI status")
    ap.add_argument("--role", choices=ROLES, help="session role profile")
    ap.add_argument(
        "--worktree",
        default=os.environ.get("GROK_PROMPT_ROOT")
        or os.environ.get("AGENT_LANDLOCK_WORKTREE")
        or os.getcwd(),
        help="start worktree root (default: cwd / GROK_PROMPT_ROOT)",
    )
    ap.add_argument(
        "--dump-grants",
        action="store_true",
        help="print resolved dir/file grants and exit 0",
    )
    ap.add_argument(
        "--apply-only",
        action="store_true",
        help="apply Landlock then exec remaining args (or exit 0 if none)",
    )
    ap.add_argument("command", nargs=argparse.REMAINDER, help="command after --")
    args = ap.parse_args(argv)

    ver = landlock_abi_version()
    if args.status:
        if ver is None:
            print("unavailable")
            return 1
        print(f"available abi={ver}")
        return 0

    if not args.role:
        print("agent-landlock: --role required (unless --status)", file=sys.stderr)
        return 2

    worktree = Path(args.worktree).resolve()
    dirs, files, meta = resolve_grants(args.role, worktree)

    if args.dump_grants:
        print(f"role={meta['role']}")
        print(f"worktree={meta['worktree']}")
        print(f"abi={meta['abi']}")
        print(f"git_home={meta.get('git_home', '')}")
        print(f"orch_root={meta.get('orch_root', '')}")
        for d in dirs:
            print(f"dir:{d}")
        for f in files:
            print(f"file:{f}")
        return 0

    cmd = list(args.command)
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]

    if os.environ.get("AGENT_LANDLOCK_DISABLE", "0") in ("1", "true", "yes"):
        _warn("AGENT_LANDLOCK_DISABLE=1 — exec bare")
        if not cmd:
            return 0
        os.execvp(cmd[0], cmd)

    strict = os.environ.get("AGENT_LANDLOCK_STRICT", "0") in ("1", "true", "yes")

    if ver is None:
        _warn("Landlock ABI unavailable — continuing without restriction")
        os.environ["AGENT_LANDLOCK"] = "0"
        os.environ["AGENT_LANDLOCK_ABI"] = "unavailable"
        if strict:
            return 3
        if not cmd:
            return 0
        os.execvp(cmd[0], cmd)

    try:
        apply_landlock(dirs, files)
        os.environ["AGENT_LANDLOCK"] = "1"
        os.environ["AGENT_LANDLOCK_ABI"] = str(ver)
        os.environ["AGENT_LANDLOCK_ROLE"] = args.role
    except OSError as exc:
        _warn(f"{exc} — continuing without restriction")
        os.environ["AGENT_LANDLOCK"] = "0"
        if strict:
            return 4
        if not cmd:
            return 0
        os.execvp(cmd[0], cmd)

    if not cmd:
        return 0
    os.execvp(cmd[0], cmd)
    return 127


if __name__ == "__main__":
    sys.exit(main())
