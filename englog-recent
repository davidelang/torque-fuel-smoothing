#!/bin/bash
# englog-recent — read ENGINEERING_LOG.md without reading it whole (read-only).
# Usage: englog-recent [-n N] | --since YYYY-MM-DD | --show '<exact header>'
# Exit: 0 ok, 1 nothing found / no such header, 2 usage, bad log, or ambiguous header.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
LOG="$ROOT/ENGINEERING_LOG.md"
[ -r "$LOG" ] || { echo "ERROR: $LOG missing or unreadable" >&2; exit 2; }
usage() { echo "Usage: $(basename "$0") [-n N] | --since YYYY-MM-DD | --show '<exact header>'" >&2; exit 2; }
HDR='^## \[?[0-9]{4}-[0-9]{2}-[0-9]{2}\]? - '
mode=last N=20 ARG=""
case "${1:-}" in
  "") ;;
  -n) [ $# -eq 2 ] && [[ "$2" =~ ^[1-9][0-9]*$ ]] || usage; N=$2 ;;
  --since) [ $# -eq 2 ] && [[ "$2" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || usage; mode=since ARG=$2 ;;
  --show) [ $# -eq 2 ] && [ -n "$2" ] || usage; mode=show ARG=$2; [[ "$ARG" == "## "* ]] || ARG="## $ARG" ;;
  *) usage ;;
esac
case $mode in
  last)
    out=$(grep -nE "$HDR" "$LOG" | tail -n "$N" | sed 's/^\([0-9]*\):/L\1: /') ;;
  since)
    out=$(SINCE="$ARG" HDR="$HDR" awk '
      $0 ~ ENVIRON["HDR"] { d = $0; sub(/^## \[?/, "", d); d = substr(d, 1, 10); if (d >= ENVIRON["SINCE"]) print "L" NR ": " $0 }' "$LOG") ;;
  show)
    lines=$(SHOW="$ARG" awk '$0 == ENVIRON["SHOW"] { print NR }' "$LOG")
    count=$(awk 'NF{c++} END{print c+0}' <<< "$lines")
    if [ "$count" -eq 0 ]; then echo "ERROR: no such header: $ARG" >&2; exit 1; fi
    if [ "$count" -gt 1 ]; then echo "ERROR: $count headers match; quote a unique one:" >&2; printf 'L%s\n' $lines >&2; exit 2; fi
    awk -v s="$lines" 'NR == s { p = 1; print; next } p && /^## / { exit } p' "$LOG"
    exit 0 ;;
esac
[ -n "$out" ] || { echo "No log headers found ($mode ${ARG:-$N})" >&2; exit 1; }
printf '%s\n' "$out"
