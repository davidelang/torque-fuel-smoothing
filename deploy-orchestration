#!/usr/bin/env python3
"""deploy-orchestration: publish the shared rule set (rules.manifest) to every host.

Run it from any host. Default mode is a REPORT of what would happen; nothing is written.
  ./deploy-orchestration                  report for all hosts under git_home
  ./deploy-orchestration --apply          write + commit (canonical first, then every host
                                          root, then each host's worktrees)
  ./deploy-orchestration --apply --push   also push each changed branch (separate step)
  ./deploy-orchestration --repos a,b      limit hosts (names under git_home or paths)
  ./deploy-orchestration --host-only      only this host: root -> its worktrees (update-rules.sh)
  ./deploy-orchestration --list law       print manifest paths of a class (files agents care about)
  ./deploy-orchestration --check          manifest consistency check (source host)
  ./deploy-orchestration --override WT    in worktree/root WT, the source wins over ahead/diverged
                                          rule files (repeatable; dirty files are still skipped)

Rules:
- Content comes from committed (clean) blobs, never the working tree, so the clean/smudge
  config (project.config) keeps user/host specifics. Managed files are re-smudged after commit.
- The source host must have no uncommitted changes in manifest paths.
- A worktree that is dirty in any manifest path, or ahead/diverged for one, is skipped whole
  (unless named with --override).
- rules.manifest.local lists files local to the PROJECT (build_app, deploy, .gitignore, ...).
  The project root's version is published into every worktree of that project. A file is
  skipped (only that file, reported) when the worktree has its own modification: it differs
  from the root AND is dirty or has a commit on the worktree branch touching it since the
  merge-base with the root branch.
- Class purge deletes the path everywhere it is tracked.
- No write access to a target gives a read-only report for it, not a failure.
- Commits use `git commit --only` on exactly the copied paths; other changes are untouched.
- Never forces, resets, or rewrites history.
"""
import argparse, fnmatch, os, re, subprocess, sys, datetime

CANON_NAME = "orchestration-example"
MSG = "rules: sync from {src}@{sha}"

def git(repo, *a, check=True, inp=None, binary=False):
    p = subprocess.run(["git", "-c", "safe.directory=*", "-C", repo] + list(a),
                       input=inp, capture_output=True)
    if check and p.returncode != 0:
        raise RuntimeError("git %s (in %s): %s" % (" ".join(a), repo, p.stderr.decode(errors="replace").strip()))
    return p.stdout if binary else p.stdout.decode(errors="replace")

def toplevel(path):
    return git(path, "rev-parse", "--show-toplevel").strip()

def read_conf(root, key):
    for name in ("project.config",):
        f = os.path.join(root, name)
        if os.path.isfile(f):
            for line in open(f, errors="replace"):
                if line.startswith(key + "="):
                    return line.split("=", 1)[1].strip()
    return ""

def glob_match(pat, path):
    rx = re.escape(pat).replace(r"\*\*/", "(?:.*/)?").replace(r"\*\*", ".*").replace(r"\*", "[^/]*").replace(r"\?", "[^/]")
    return re.fullmatch(rx, path) is not None

def parse_manifest(text):
    out = []
    for line in text.splitlines():
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        cls, _, pat = line.partition(" ")
        out.append((cls.strip(), pat.strip()))
    return out

def tree(repo, rev="HEAD"):
    """path -> (mode, blob) of tracked files at rev."""
    res = {}
    raw = git(repo, "ls-tree", "-r", "-z", rev, binary=True)
    for ent in raw.split(b"\0"):
        if not ent:
            continue
        meta, path = ent.split(b"\t", 1)
        mode, _typ, blob = meta.decode().split()
        res[path.decode()] = (mode, blob)
    return res

_hist = {}
def history(repo, path):
    k = (repo, path)
    if k not in _hist:
        out = git(repo, "log", "--format=", "--raw", "--no-abbrev", "--", path, check=False)
        s = set()
        for line in out.splitlines():
            parts = line.split()
            if len(parts) >= 5 and line.startswith(":"):
                s.add(parts[2]); s.add(parts[3])
        _hist[k] = s
    return _hist[k]

def entries_for(src, man, src_tree, classes):
    """Expand manifest globs against the source tree -> {path: cls}."""
    sel = {}
    for cls, pat in man:
        if cls not in classes:
            continue
        hits = [p for p in src_tree if glob_match(pat, p)]
        for p in hits:
            sel.setdefault(p, cls)
    return sel

def is_managed(repo, path):
    out = git(repo, "check-attr", "filter", "--", path, check=False)
    return out.strip().endswith(": manage-configs")

def worktrees(host):
    out = git(host, "worktree", "list", "--porcelain")
    wts, cur = [], {}
    for line in out.splitlines() + [""]:
        if not line:
            if cur:
                wts.append(cur)
            cur = {}
            continue
        k, _, v = line.partition(" ")
        cur[k] = v or True
    res = []
    for w in wts:
        p = w.get("worktree")
        if not p or w.get("bare"):
            continue
        reason = None
        if w.get("prunable"):
            reason = "prunable"
        elif "/grok-worktrees/" in p or re.search(r"/third_party/[^/]+/src(/|$)", p):
            reason = "excluded path"
        elif not os.path.isdir(p):
            reason = "missing"
        res.append((p, reason))
    return res

def writable(wt):
    try:
        gd = git(wt, "rev-parse", "--absolute-git-dir").strip()
        cd = git(wt, "rev-parse", "--path-format=absolute", "--git-common-dir").strip()
    except RuntimeError:
        return False
    return all(os.access(d, os.W_OK) for d in (wt, gd, cd, os.path.join(cd, "objects")))

REFS = []  # canonical + every host root: their HEAD histories hold every published version

def known(src, wt, path, blob):
    """True if blob was a published version: in the source's history or in another
    host root's history (the target's own repo root counts only for its worktrees)."""
    if blob in history(src, path):
        return True
    rw = os.path.realpath(wt)
    for r in REFS:
        if os.path.realpath(r) != rw and blob in history(r, path):
            return True
    return False

def cleaned(wt, path, blob):
    """Blob id after the target's clean filter (fixes copies committed smudged)."""
    if not is_managed(wt, path):
        return blob
    data = git(wt, "cat-file", "blob", blob, binary=True)
    return git(wt, "hash-object", "--path=" + path, "--stdin", inp=data).strip()

TOKEN = re.compile(r"@@[A-Z0-9_]+@@")

def token_equal(repo_a, blob_a, repo_b, blob_b):
    """blob_b equals blob_a except where blob_a has @@TOKEN@@ placeholders, i.e. blob_b
    is a copy of blob_a committed with literal values the clean filter cannot map."""
    a = git(repo_a, "cat-file", "blob", blob_a, binary=True).decode(errors="replace").split("\n")
    b = git(repo_b, "cat-file", "blob", blob_b, binary=True).decode(errors="replace").split("\n")
    if len(a) != len(b):
        return False
    for x, y in zip(a, b):
        if x == y:
            continue
        if not TOKEN.search(x):
            return False
        rx = ".*".join(re.escape(part) for part in TOKEN.split(x))
        if not re.fullmatch(rx, y):
            return False
    return True

def known_smudged(src, wt, path, blob):
    for r in [src] + REFS:
        try:
            k = git(r, "rev-parse", "HEAD:" + path, check=False).strip()
        except Exception:
            k = ""
        if k and len(k) == 40 and token_equal(r, k, wt, blob):
            return True
    return False

class Report:
    def __init__(self):
        self.rows, self.fail, self.warn = [], [], []
    def row(self, host, wt, status, detail=""):
        self.rows.append((host, wt, status, detail))
    def print(self):
        print("\n==== SUMMARY ====")
        for f in self.fail:
            print("FAIL: " + f)
        for w in self.warn:
            print("WARN: " + w)
        if not self.fail and not self.warn:
            print("no failures or warnings")
        for host, wt, st, d in self.rows:
            print("%-28s %-34s %-12s %s" % (host, wt, st, d))

def local_seeded(host):
    p = os.path.join(host, "rules.manifest.local")
    if not os.path.lexists(p):
        return False
    return any(re.match(r"(# )?local ", l) for l in open(p, errors="replace"))

OVERRIDE = set()
PURGE = []

def own_modification(src, wt, path):
    """Worktree branch committed this path since its merge-base with the root branch."""
    try:
        base = git(wt, "merge-base", "HEAD", git(src, "rev-parse", "HEAD").strip()).strip()
    except RuntimeError:
        return True
    return bool(git(wt, "log", "--format=%H", "-1", base + "..HEAD", "--", path, check=False).strip())

def plan_target(src, src_tree, sel, retired_pats, wt, rep, label, purge_pats=()):
    """Decide actions for one worktree. Returns (actions, skip_reason)."""
    try:
        t_tree = tree(wt)
    except RuntimeError as e:
        return None, "no HEAD (%s)" % e
    status = git(wt, "status", "--porcelain", "-z", "--untracked-files=no", binary=True).split(b"\0")
    dirty = set()
    for e in status:
        if len(e) > 3:
            dirty.add(e[3:].decode(errors="replace"))
    acts = []
    for p, cls in sorted(sel.items()):
        mode, blob = src_tree[p]
        cur = t_tree.get(p)
        if cur and cur[1] == blob:
            continue
        if cls == "local":
            if p in dirty:
                rep.warn.append("%s: skipped file %s (dirty, own modification)" % (label, p)); continue
            if cur is None:
                if os.path.lexists(os.path.join(wt, p)):
                    rep.warn.append("%s: skipped file %s (untracked file in the way)" % (label, p)); continue
                acts.append(("add", p, mode, blob)); continue
            if own_modification(src, wt, p):
                rep.warn.append("%s: skipped file %s (own commit since merge-base)" % (label, p)); continue
            acts.append(("update", p, mode, blob)); continue
        if p in dirty:
            if cls == "local":
                rep.warn.append("%s: left local %s (dirty)" % (label, p)); continue
            return None, "dirty: " + p
        if cur is None:
            if cls == "opt":
                continue
            if os.path.lexists(os.path.join(wt, p)):
                return None, "untracked file in the way: " + p
            acts.append(("add", p, mode, blob))
            continue
        if cls == "replace" or os.path.realpath(wt) in OVERRIDE:
            acts.append(("update", p, mode, blob)); continue
        cb = cleaned(wt, p, cur[1])
        if cb == blob:
            acts.append(("update", p, mode, blob)); continue
        if known(src, wt, p, cur[1]) or (cb != cur[1] and known(src, wt, p, cb)) or known_smudged(src, wt, p, cur[1]):
            acts.append(("update", p, mode, blob))
        elif cls == "local":
            rep.warn.append("%s: left local %s (%s)" % (label, p, "ahead" if blob in history(wt, p) else "diverged"))
        elif blob in history(wt, p):
            return None, "ahead of source: " + p
        else:
            return None, "diverged: " + p
    for p in sorted(t_tree):
        if any(glob_match(pat, p) for pat in purge_pats) and p not in sel:
            if p in dirty:
                return None, "dirty: " + p
            acts.append(("delete", p, None, None)); continue
        if any(glob_match(pat, p) for pat in retired_pats) and p not in sel:
            if p in dirty:
                return None, "dirty: " + p
            if known(src, wt, p, t_tree[p][1]):
                acts.append(("delete", p, None, None))
            else:
                rep.warn.append("%s: kept retired %s (local-only version)" % (label, p))
    return acts, None

def apply_target(src, wt, acts, msg):
    paths = []
    for kind, p, mode, blob in acts:
        fp = os.path.join(wt, p)
        if kind == "delete":
            git(wt, "rm", "-q", "--", p)
            paths.append(p)
            continue
        os.makedirs(os.path.dirname(fp) or wt, exist_ok=True)
        data = git(src, "cat-file", "blob", blob, binary=True)
        if os.path.lexists(fp):
            os.remove(fp)
        if mode == "120000":
            os.symlink(data.decode(), fp)
        else:
            with open(fp, "wb") as f:
                f.write(data)
            os.chmod(fp, 0o775 if mode == "100755" else 0o664)
        paths.append(p)
    adds = [p for k, p, _, _ in acts if k != "delete"]
    if adds:
        git(wt, "add", "-f", "--", *adds)
    git(wt, "commit", "-q", "--only", "-m", msg, "--", *paths)
    for p in adds:
        fp = os.path.join(wt, p)
        if is_managed(wt, p) and not os.path.islink(fp):
            os.remove(fp)
            git(wt, "checkout", "--", p)
    left = git(wt, "status", "--porcelain", "--", *paths, check=False).strip()
    return git(wt, "rev-parse", "--short", "HEAD").strip(), left

def sync(src, wt, sel, src_tree, retired, rep, host_label, wt_label, apply, msg):
    if not writable(wt):
        acts, why = plan_target(src, src_tree, sel, retired, wt, rep, wt_label, PURGE)
        rep.row(host_label, wt_label, "REPORT-ONLY", "no write access; " + (why or "%d change(s) pending" % len(acts)))
        return False
    acts, why = plan_target(src, src_tree, sel, retired, wt, rep, wt_label, PURGE)
    if why:
        rep.row(host_label, wt_label, "SKIPPED", why)
        rep.warn.append("%s %s skipped: %s" % (host_label, wt_label, why))
        return False
    if not acts:
        rep.row(host_label, wt_label, "up-to-date")
        return False
    desc = "%d change(s): %s" % (len(acts), ", ".join("%s %s" % (k[0], p) for k, p, _, _ in acts[:6]) + (" ..." if len(acts) > 6 else ""))
    if not apply:
        rep.row(host_label, wt_label, "WOULD-COMMIT", desc)
        return False
    try:
        sha, left = apply_target(src, wt, acts, msg)
    except Exception as e:
        rep.fail.append("%s %s: %s" % (host_label, wt_label, e))
        rep.row(host_label, wt_label, "FAILED", str(e)[:120])
        return False
    rep.row(host_label, wt_label, "COMMITTED", "%s %s" % (sha, desc))
    if left:
        rep.warn.append("%s %s: paths still differ after commit: %s" % (host_label, wt_label, left.replace("\n", "; ")))
    return True

def legacy_local_list(host):
    """Host-specific infra from the host's old update-rules.sh FILES/STAMP lists."""
    txt = ""
    for c in git(host, "log", "--format=%H", "--", "update-rules.sh", check=False).split():
        t = git(host, "show", c + ":update-rules.sh", check=False)
        if re.search(r"^FILES=\(", t, re.M):
            txt = t
            break
    out = []
    for m in re.finditer(r"^(?:FILES|STAMP_FILES)=\((.*?)^\)", txt, re.S | re.M):
        for line in m.group(1).splitlines():
            line = line.split("#", 1)[0].strip().strip('"').strip("'")
            if line:
                out.append(line)
    return out

def discover(git_home):
    hosts = []
    for name in sorted(os.listdir(git_home)):
        d = os.path.join(git_home, name)
        if os.path.isdir(os.path.join(d, ".git")) and os.path.isfile(os.path.join(d, "AGENTS.md")) \
           and os.path.isfile(os.path.join(d, "update-rules.sh")):
            hosts.append(d)
    return hosts

def check(src):
    t = tree(src)
    man = parse_manifest(git(src, "show", "HEAD:rules.manifest"))
    problems = []
    for cls, pat in man:
        if cls not in ("law", "shared", "opt", "replace", "retired", "purge"):
            problems.append("bad class: %s %s" % (cls, pat))
        hits = [p for p in t if glob_match(pat, p)]
        if cls in ("law", "shared", "replace") and not hits and "*" not in pat:
            problems.append("missing in source: %s" % pat)
        if cls in ("retired", "purge") and hits:
            problems.append("retired but still tracked: %s" % ", ".join(hits))
    sel = entries_for(src, man, t, ("law", "shared", "opt", "replace"))
    for p in t:
        if (p.startswith((".grok/", "roles/", "docs/rules/", "probes/")) or p in ("roles.config",)) and p not in sel:
            problems.append("rule-ish file not in manifest: %s" % p)
    roles = [l.split()[0] for l in git(src, "show", "HEAD:roles.config").splitlines() if l.strip() and not l.startswith("#")]
    for r in roles:
        if "roles/%s.md" % r not in t:
            problems.append("roles.config role without card: %s" % r)
    for f in [p for p in t if re.fullmatch(r"run-grok(-[a-z]+)?", p)]:
        m = re.search(r"^ROLE_KEY=(\w+)", git(src, "show", "HEAD:" + f), re.M)
        if m and "roles/%s.md" % m.group(1) not in t:
            problems.append("%s uses ROLE_KEY=%s without a card" % (f, m.group(1)))
    hj = git(src, "show", "HEAD:.grok/hooks/rules-hooks.json")
    for m in re.finditer(r"\.grok/hooks/([\w.-]+)", hj):
        if ".grok/hooks/" + m.group(1) not in t:
            problems.append("hook json references missing %s" % m.group(1))
    for p in problems:
        print("CHECK: " + p)
    print("check: %d problem(s), %d manifest paths" % (len(problems), len(sel)))
    return 1 if problems else 0

def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--apply", action="store_true")
    ap.add_argument("--push", action="store_true")
    ap.add_argument("--repos", default="")
    ap.add_argument("--host-only", action="store_true")
    ap.add_argument("--list", metavar="CLASS")
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--override", action="append", default=[], metavar="WT")
    ap.add_argument("--dry-run", action="store_true", help="same as the default report")
    a = ap.parse_args()
    src = toplevel(os.path.dirname(os.path.realpath(__file__)))
    if a.check:
        return check(src)
    if a.list:
        t = tree(src)
        for p in sorted(entries_for(src, parse_manifest(git(src, "show", "HEAD:rules.manifest")), t, (a.list,))):
            print(p)
        return 0
    apply = a.apply and not a.dry_run
    rep = Report()
    print("deploy-orchestration %s  source=%s  user=%s  %s" % ("APPLY" if apply else "REPORT (use --apply to write)",
          src, os.environ.get("USER", "?"), datetime.datetime.now().strftime("%F %H:%M")))
    git_home = read_conf(src, "git_home") or os.path.dirname(src)
    if "@@" in git_home or not os.path.isdir(git_home):
        git_home = os.path.dirname(src)
    canon = os.path.join(git_home, CANON_NAME)

    # The source host must be committed in manifest paths.
    st = git(src, "status", "--porcelain", "--untracked-files=no").splitlines()
    src_man = parse_manifest(git(src, "show", "HEAD:rules.manifest"))
    src_tree = tree(src)
    sel_src = entries_for(src, src_man, src_tree, ("law", "shared", "opt", "replace"))
    dirty_src = [l[3:] for l in st if l[3:] in sel_src or l[3:] == "rules.manifest"]
    if dirty_src:
        print("FAIL: source %s has uncommitted manifest paths: %s" % (src, ", ".join(dirty_src)))
        return 2

    if a.host_only:
        hosts = [src]
    else:
        hosts = discover(git_home)
        if a.repos:
            want = [r if os.path.isabs(r) else os.path.join(git_home, r) for r in a.repos.split(",") if r]
            want = [os.path.realpath(w) for w in want]
            hosts = [h for h in hosts if os.path.realpath(h) in want]
        # canonical first
        hosts.sort(key=lambda h: 0 if os.path.realpath(h) == os.path.realpath(canon) else 1)
        if os.path.isdir(canon) and os.path.realpath(src) != os.path.realpath(canon) \
           and os.path.realpath(canon) not in [os.path.realpath(h) for h in hosts]:
            hosts.insert(0, canon)

    REFS[:] = [canon] + discover(git_home) if os.path.isdir(canon) else discover(git_home)
    retired = [p for c, p in src_man if c == "retired"]
    PURGE[:] = [p for c, p in src_man if c == "purge"]
    OVERRIDE.update(os.path.realpath(o) for o in a.override)
    pushed = []
    first_src = src
    for host in hosts:
        hl = os.path.basename(host)
        # Stage 1: shared set from the publishing source (canonical once updated) -> host root.
        if os.path.realpath(host) != os.path.realpath(first_src):
            upstream = first_src
            u_tree = tree(upstream)
            sel = entries_for(upstream, src_man, u_tree, ("law", "shared", "opt", "replace"))
            msg = MSG.format(src=os.path.basename(upstream), sha=git(upstream, "rev-parse", "--short", "HEAD").strip())
            changed = sync(upstream, host, sel, u_tree, retired, rep, hl, "(root)", apply, msg)
            if changed:
                pushed.append(host)
            # Seed the host-local manifest from its legacy update-rules.sh on first publish.
            if apply and not local_seeded(host) and writable(host):
                loc = list(dict.fromkeys(p for p in legacy_local_list(host) if p not in sel and not any(glob_match(r, p) for r in retired)))
                try:
                    txt = "# rules.manifest.local: files local to this project (not to one worktree).\n" \
                          "# Files local to this PROJECT: the root's version is published into every worktree;\n" \
                          "# a worktree's own modification of a file skips just that file. Seeded from the legacy\n" \
                          "# update-rules.sh FILES lists. Format: local <path>\n" + \
                          "".join("local %s\n" % p for p in loc)
                    with open(os.path.join(host, "rules.manifest.local"), "w") as f:
                        f.write(txt)
                    git(host, "add", "-f", "--", "rules.manifest.local")
                    git(host, "commit", "-q", "--only", "-m", "rules: seed rules.manifest.local from legacy update-rules.sh", "--", "rules.manifest.local")
                    rep.row(hl, "(root)", "COMMITTED", "seeded rules.manifest.local (%d paths)" % len(loc))
                except Exception as e:
                    rep.fail.append("%s: seeding rules.manifest.local: %s" % (hl, e))
            elif not apply and not local_seeded(host):
                n = len([p for p in legacy_local_list(host) if p not in sel])
                rep.row(hl, "(root)", "WOULD-SEED", "rules.manifest.local from legacy update-rules.sh (%d paths)" % n)
            if os.path.realpath(host) == os.path.realpath(canon) and apply:
                first_src = canon  # later hosts take from the canonical copy
        # Stage 2: host root -> its worktrees (shared set + host-local set).
        h_tree = tree(host)
        man = src_man if os.path.realpath(host) == os.path.realpath(src) else parse_manifest(
            git(host, "show", "HEAD:rules.manifest", check=False) or "\n".join("%s %s" % e for e in src_man))
        man = man + [("local", p) for c, p in (parse_manifest(git(host, "show", "HEAD:rules.manifest.local", check=False)))]
        sel = entries_for(host, man, h_tree, ("law", "shared", "opt", "replace", "local"))
        if not apply and os.path.realpath(host) != os.path.realpath(src):
            # Report mode: root has not been updated yet, so preview worktrees against the upstream set.
            u_tree = tree(first_src)
            sel_u = entries_for(first_src, src_man, u_tree, ("law", "shared", "opt", "replace"))
            for wt, why in worktrees(host):
                if os.path.realpath(wt) == os.path.realpath(host):
                    continue
                wl = os.path.relpath(wt, host) if wt.startswith(host + "/") else wt
                if why:
                    rep.row(hl, wl, "SKIPPED", why); continue
                acts, w2 = plan_target(first_src, u_tree, sel_u, retired, wt, rep, wl, PURGE)
                rep.row(hl, wl, "SKIPPED" if w2 else ("WOULD-COMMIT" if acts else "up-to-date"),
                        w2 or ("%d change(s) after root" % len(acts) if acts else ""))
            continue
        msg = MSG.format(src=hl + " root", sha=git(host, "rev-parse", "--short", "HEAD").strip())
        for wt, why in worktrees(host):
            if os.path.realpath(wt) == os.path.realpath(host):
                continue
            wl = os.path.relpath(wt, host) if wt.startswith(host + "/") else wt
            if why:
                rep.row(hl, wl, "SKIPPED", why)
                continue
            if sync(host, wt, sel, h_tree, retired, rep, hl, wl, apply, msg):
                pushed.append(wt)
    if a.push and apply:
        for r in pushed:
            p = subprocess.run(["git", "-C", r, "push"], capture_output=True, text=True)
            if p.returncode:
                rep.fail.append("push %s: %s" % (r, p.stderr.strip()[:200]))
            else:
                rep.row(os.path.basename(r), "", "PUSHED")
    rep.print()
    return 1 if rep.fail else 0

if __name__ == "__main__":
    sys.exit(main())
