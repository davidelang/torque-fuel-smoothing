def _flow_res(root: Path, config: dict) -> Path:
    rel = str(config.get("strings_res") or "app/src/main/res")
    return root / rel


def _layout_ids(res: Path) -> set[str]:
    found: set[str] = set()
    if not res.is_dir():
        return found
    for path in res.rglob("*.xml"):
        parts = path.relative_to(res).parts
        if not parts or "layout" not in parts[0]:
            continue
        text = path.read_text(encoding="utf-8", errors="replace")
        found.update(re.findall(r"@\+id/([A-Za-z0-9_]+)", text))
        found.update(re.findall(r"@id/([A-Za-z0-9_]+)", text))
    return found


def _string_ids(res: Path) -> set[str]:
    found: set[str] = set()
    if not res.is_dir():
        return found
    for path in res.glob("values*/strings.xml"):
        found.update(_parse_strings(path))
    return found


def _load_regress_config(root: Path) -> tuple[dict, list[str]]:
    path = root / "regress" / "config.json"
    if not path.is_file():
        return {}, []
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        return {}, [f"{path}: {exc}"]
    if not isinstance(data, dict):
        return {}, [f"{path} is not an object"]
    return data, []


def _parse_cli_vars(items: list[str] | None) -> tuple[dict[str, str], list[str]]:
    values: dict[str, str] = {}
    errors: list[str] = []
    for item in items or []:
        if "=" not in item:
            errors.append(f"--var {item!r} is not k=v")
            continue
        key, value = item.split("=", 1)
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
            errors.append(f"--var name {key!r} is not an identifier")
            continue
        values[key] = value
    return values, errors


def _var_names(value: object, found: set[str]) -> None:
    if isinstance(value, str):
        found.update(_VAR.findall(value))
    elif isinstance(value, dict):
        for item in value.values():
            _var_names(item, found)
    elif isinstance(value, list):
        for item in value:
            _var_names(item, found)


def _selector_errors(sel: object, where: str, ids: set[str], strings: set[str], have_layouts: bool, have_strings: bool) -> list[str]:
    errors: list[str] = []
    if not isinstance(sel, dict):
        return [f"{where} selector is not an object"]
    keys = [key for key in ("res_id", "string", "text", "desc") if key in sel]
    if len(keys) != 1:
        errors.append(f"{where} selector needs exactly one of res_id, string, text, desc")
        return errors
    key = keys[0]
    if key == "res_id":
        name = sel["res_id"]
        if not isinstance(name, str) or not name:
            errors.append(f"{where} res_id is empty")
        elif "${" not in name:
            bare = name.split("/")[-1]
            if have_layouts and bare not in ids:
                errors.append(f"{where} res_id {bare!r} is not in a layout")
            if not have_layouts:
                errors.append(f"{where} res_id {bare!r} but this app has no layouts")
    elif key == "string":
        name = sel["string"]
        if not isinstance(name, str) or not name:
            errors.append(f"{where} string id is empty")
        elif "${" not in name and name not in strings:
            if have_strings:
                errors.append(f"{where} string id {name!r} is not in strings.xml")
            else:
                errors.append(f"{where} string id {name!r} but this app has no strings.xml")
    elif key == "text":
        if not isinstance(sel["text"], str):
            errors.append(f"{where} text is not a string")
        if "contains" in sel and not isinstance(sel["contains"], bool):
            errors.append(f"{where} contains is not true or false")
    else:
        desc = sel["desc"]
        if isinstance(desc, str):
            if desc not in strings and "${" not in desc:
                if have_strings:
                    errors.append(f"{where} desc string id {desc!r} is not in strings.xml")
                else:
                    errors.append(f"{where} desc string id {desc!r} but this app has no strings.xml")
        elif isinstance(desc, dict):
            if not isinstance(desc.get("literal"), str):
                errors.append(f"{where} desc.literal is not a string")
        else:
            errors.append(f"{where} desc is not a string id or a literal")
    if "contains" in sel and key != "text":
        errors.append(f"{where} contains is only for text")
    if "index" in sel and (not isinstance(sel["index"], int) or isinstance(sel["index"], bool) or sel["index"] < 0):
        errors.append(f"{where} index is not a non-negative integer")
    if "within" in sel:
        errors.extend(_selector_errors(sel["within"], f"{where} within", ids, strings, have_layouts, have_strings))
    return errors


def _check_flow(path: Path, config: dict, cli: dict[str, str], ids: set[str], strings: set[str], have_layouts: bool, have_strings: bool) -> list[str]:
    errors: list[str] = []
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        return [f"{path}: {exc}"]
    if not isinstance(data, dict):
        return [f"{path} is not an object"]
    if data.get("schema") != "capture-flow/1":
        errors.append(f"{path} schema is not capture-flow/1")
    name = data.get("name")
    if not isinstance(name, str) or not name:
        errors.append(f"{path} needs a name")
    steps = data.get("steps")
    if not isinstance(steps, list) or not steps:
        errors.append(f"{path} needs steps")
        return errors
    defined = set(_FLOW_BUILTINS)
    defined.update(str(key) for key in config)
    defined.update(str(key) for key in (data.get("vars") or {}) if isinstance(data.get("vars"), dict))
    defined.update(cli)
    header_vars: set[str] = set()
    _var_names(data.get("package"), header_vars)
    _var_names(data.get("description"), header_vars)
    _var_names(data.get("vars"), header_vars)
    for var in sorted(header_vars):
        if var not in defined:
            errors.append(f"{path} ${{{var}}} is undefined")
    defaults = data.get("defaults") or {}
    if defaults and not isinstance(defaults, dict):
        errors.append(f"{path} defaults is not an object")
        defaults = {}
    if "on_fail" in defaults:
        errors.append(f"{path} defaults.on_fail is not used; the wrapper judges the report")
    known = set(FLOW_COMMANDS) | {"id", "timeout_s", "optional", "when", "save_as", "scroll"}
    for index, step in enumerate(steps):
        where = f"{path} step {index}"
        if not isinstance(step, dict):
            errors.append(f"{where} is not an object")
            continue
        unknown = [key for key in step if key not in known]
        if unknown:
            errors.append(f"{where} has unknown fields {unknown}")
        commands = [key for key in FLOW_COMMANDS if key in step]
        if len(commands) != 1:
            errors.append(f"{where} needs exactly one command")
            continue
        command = commands[0]
        if "on_fail" in step or "compare" in step:
            errors.append(f"{where} cannot judge a result")
        if command == "save_as" or ("save_as" in step and command != "read_text"):
            errors.append(f"{where} save_as is only for read_text")
        if "scroll" in step and command != "tap":
            errors.append(f"{where} scroll is only for tap")
        if "scroll" in step and step["scroll"] not in ("page", "fling"):
            errors.append(f"{where} scroll is not page or fling")
        if "optional" in step and not isinstance(step["optional"], bool):
            errors.append(f"{where} optional is not true or false")
        if "timeout_s" in step and not isinstance(step["timeout_s"], (int, float)):
            errors.append(f"{where} timeout_s is not a number")
        if "when" in step:
            when = step["when"]
            if not isinstance(when, dict) or not isinstance(when.get("var"), str):
                errors.append(f"{where} when needs var")
            else:
                ops = [op for op in WHEN_OPS if op in when]
                if len(ops) != 1:
                    errors.append(f"{where} when needs one of {', '.join(WHEN_OPS)}")
                defined_here = set(defined)
                _var_names(when, defined_here)
                # var name itself must already be defined; the value may be a literal
                if when["var"] not in defined:
                    errors.append(f"{where} when var {when['var']!r} is undefined")
        body = step[command]
        if command in ("tap", "long_press", "wait_for", "wait_gone", "read_text"):
            errors.extend(_selector_errors(body, where, ids, strings, have_layouts, have_strings))
        elif command == "type":
            if not isinstance(body, dict) or "into" not in body or not isinstance(body.get("text"), str):
                errors.append(f"{where} type needs into and text")
            else:
                errors.extend(_selector_errors(body["into"], f"{where} into", ids, strings, have_layouts, have_strings))
                if "clear" in body and not isinstance(body["clear"], bool):
                    errors.append(f"{where} clear is not true or false")
        elif command == "swipe":
            if body not in ("page", "fling") and not (
                isinstance(body, dict) and isinstance(body.get("from"), list) and isinstance(body.get("to"), list)
            ):
                errors.append(f"{where} swipe is page, fling, or from/to fractions")
        elif command == "wait":
            if not isinstance(body, (int, float)) or isinstance(body, bool) or body < 0 or body > 2:
                errors.append(f"{where} wait is seconds, at most 2")
        elif command == "back":
            if not isinstance(body, int) or isinstance(body, bool) or body < 1:
                errors.append(f"{where} back is a positive integer")
        elif command == "home":
            if body is not True:
                errors.append(f"{where} home is true")
        elif command == "rotate":
            if body not in ROTATIONS:
                errors.append(f"{where} rotate is not a known orientation")
        elif command == "launch":
            if body is not True:
                errors.append(f"{where} launch is true")
            if not config.get("activity"):
                errors.append(f"{where} launch needs activity in regress/config.json")
        elif command == "note":
            if not isinstance(body, str):
                errors.append(f"{where} note is not a string")
        elif command == "screenshot":
            spec = body
            filename = spec if isinstance(spec, str) else spec.get("file") if isinstance(spec, dict) else None
            if not isinstance(filename, str) or not filename or "/" in filename or filename.startswith("."):
                errors.append(f"{where} screenshot file name is not a plain file name")
            if isinstance(spec, dict):
                if "compare" in spec:
                    errors.append(f"{where} screenshot compare is not done by this tool")
                for entry in spec.get("report") or []:
                    if not isinstance(entry, dict) or not isinstance(entry.get("name"), str):
                        errors.append(f"{where} screenshot report entry needs a name")
                        continue
                    errors.extend(_selector_errors(entry.get("selector"), f"{where} report", ids, strings, have_layouts, have_strings))
        used: set[str] = set()
        _var_names(step, used)
        for var in sorted(used):
            if var not in defined:
                errors.append(f"{where} ${{{var}}} is undefined")
        if command == "read_text" and isinstance(step.get("save_as"), str):
            defined.add(step["save_as"])
    return errors


def _subst(value: object, env: dict[str, object]) -> object:
    if isinstance(value, str):
        def repl(match: re.Match[str]) -> str:
            key = match.group(1)
            if key not in env:
                raise DriveStop(f"undefined variable ${{{key}}}")
            return str(env[key])
        return _VAR.sub(repl, value)
    if isinstance(value, dict):
        return {key: _subst(item, env) for key, item in value.items()}
    if isinstance(value, list):
        return [_subst(item, env) for item in value]
    return value


def _strings_for(res: Path, locale: str) -> dict[str, str]:
    merged: dict[str, str] = {}
    tag = locale.replace("_", "-")
    parts = [part for part in tag.split("-") if part]
    order = [res / "values" / "strings.xml"]
    if parts:
        order.append(res / f"values-{parts[0]}" / "strings.xml")
    if len(parts) > 1:
        order.append(res / f"values-{parts[0]}-r{parts[1].upper()}" / "strings.xml")
    for path in order:
        if path.is_file():
            merged.update(_parse_strings(path))
    return merged


def _node_matches(node: ET.Element, sel: dict, strings: dict[str, str]) -> bool:
    if "res_id" in sel:
        rid = node.attrib.get("resource-id") or ""
        want = str(sel["res_id"])
        bare = want.split("/")[-1]
        return rid == want or rid.endswith(f":id/{bare}") or rid.endswith(f"/{bare}")
    if "string" in sel:
        text = strings.get(str(sel["string"]))
        return text is not None and (node.attrib.get("text") or "") == text
    if "text" in sel:
        got = node.attrib.get("text") or ""
        want = str(sel["text"])
        return want in got if sel.get("contains") else got == want
    desc = sel.get("desc")
    got = node.attrib.get("content-desc") or ""
    if isinstance(desc, dict):
        return got == str(desc.get("literal") or "")
    text = strings.get(str(desc))
    return text is not None and got == text


def _find_selector(root: ET.Element, sel: dict, strings: dict[str, str]) -> list[ET.Element]:
    if "within" in sel:
        parents = _find_selector(root, sel["within"], strings)
        if not parents:
            return []
        nodes = list(parents[0].iter())
    else:
        nodes = [node for node in root.iter() if node is not root]
    found = [node for node in nodes if _node_matches(node, sel, strings)]
    index = int(sel.get("index") or 0)
    if index >= len(found):
        return []
    return [found[index]]


def _swipe_kind(serial: str, kind: str) -> None:
    size = _screen_size(serial)
    if size is None:
        raise DriveStop("screen size is unavailable")
    width, height = size
    x = width // 2
    if kind == "fling":
        y1, y2, duration, pause = int(height * 0.82), int(height * 0.18), 70, 0.55
    else:
        y1, y2, duration, pause = int(height * 0.75), int(height * 0.30), 400, 0.6
    if _run(serial, "shell", "input", "swipe", str(x), str(y1), str(x), str(y2), str(duration), check=False).returncode != 0:
        raise DriveStop("swipe failed")
    time.sleep(pause)


def _await_node(serial: str, sel: dict, strings: dict[str, str], timeout: float, poll: float, scroll: str | None, present: bool) -> ET.Element | None:
    deadline = time.monotonic() + timeout
    previous: tuple[str, ...] | None = None
    while True:
        root = _dump(serial)
        found = _find_selector(root, sel, strings)
        if present and found:
            return found[0]
        if not present and not found:
            return None
        if scroll and present and not found:
            labels = _bottom_labels(root)
            if scroll == "fling" and previous is not None and labels == previous:
                return None
            previous = labels
            _swipe_kind(serial, "page" if scroll == "page" else "fling")
        if time.monotonic() >= deadline:
            return found[0] if found and not present else None
        time.sleep(poll)


def _screencap(serial: str, dest: Path) -> None:
    result = subprocess.run(
        ["adb", "-s", serial, "exec-out", "screencap", "-p"],
        check=False,
        capture_output=True,
        timeout=60,
    )
    if result.returncode != 0 or len(result.stdout) < 32:
        raise DriveStop(f"screencap failed for {dest.name}")
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_bytes(result.stdout)


def _flow_main(args: argparse.Namespace) -> int:
    if args.form or args.shots or args.replace or args.locales is not None:
        print(
            "ERROR: a flow run does not take --form, --locales, --shots, or --replace",
            file=sys.stderr,
        )
        return 2
    root = Path(args.root).resolve()
    config, errors = _load_regress_config(root)
    cli, var_errors = _parse_cli_vars(args.variables)
    errors.extend(var_errors)
    res = _flow_res(root, config)
    ids = _layout_ids(res)
    strings = _string_ids(res)
    paths: list[Path] = []
    for raw in args.flows:
        path = Path(raw)
        if not path.is_absolute():
            path = root / path
        paths.append(path)
        errors.extend(_check_flow(path, config, cli, ids, strings, bool(ids), bool(strings)))
    if errors:
        for error in errors:
            print(f"ERROR: {error}", file=sys.stderr)
        return 2
    if args.check:
        print(f"ok {len(paths)} flow(s)", flush=True)
        return 0
    serials = list(args.serials or [])
    if len(serials) != 1:
        print("ERROR: a flow run takes one --serial", file=sys.stderr)
        return 2
    serial = serials[0]
    devices = subprocess.run(["adb", "devices"], capture_output=True, text=True).stdout
    if serial not in devices:
        print(f"ERROR: {serial} not in adb devices", file=sys.stderr)
        return 1
    if args.run_dir:
        run_dir = Path(args.run_dir)
        if not run_dir.is_absolute():
            run_dir = root / run_dir
    else:
        stamp = time.strftime("%Y%m%d-%H%M%S")
        run_dir = _scratch_dir(root) / "regress-runs" / f"{stamp}-{serial}"
    run_dir.mkdir(parents=True, exist_ok=True)
    sdk = _sh(serial, "getprop ro.build.version.sdk", check=False).strip()
    model = _sh(serial, "getprop ro.product.model", check=False).strip()
    locale = _sh(serial, "getprop persist.sys.locale", check=False).strip() or "en"
    string_table = _strings_for(res, locale)
    started = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    run_record: dict[str, object] = {
        "tool": "script-android-app",
        "serial": serial,
        "sdk": sdk,
        "model": model,
        "start": started,
        "end": started,
        "stopped": False,
        "reason": "",
        "flows": [],
    }
    code = 0
    for path in paths:
        data = json.loads(path.read_text(encoding="utf-8"))
        flow_name = str(data["name"])
        safe = re.sub(r"[^A-Za-z0-9_.-]+", "_", flow_name).strip("._") or "flow"
        flow_dir = run_dir / safe
        (flow_dir / "shots").mkdir(parents=True, exist_ok=True)
        (flow_dir / "ui").mkdir(parents=True, exist_ok=True)
        env: dict[str, object] = {}
        for key, value in config.items():
            if key != "schema":
                env[str(key)] = value
        for key, value in (data.get("vars") or {}).items():
            env[str(key)] = value
        env.update(cli)
        env.update({"serial": serial, "sdk": sdk, "model": model, "flow": flow_name, "run_dir": str(run_dir), "flow_dir": str(flow_dir)})
        defaults = data.get("defaults") or {}
        timeout_default = float(defaults.get("timeout_s", 20))
        poll = float(defaults.get("poll_s", 0.5))
        if poll <= 0:
            poll = 0.05
        flow_started = time.monotonic()
        flow_record: dict[str, object] = {
            "name": flow_name,
            "file": str(path),
            "duration_ms": 0,
            "stopped": False,
            "steps": [],
        }
        assert isinstance(run_record["flows"], list)
        run_record["flows"].append(flow_record)
        for index, raw_step in enumerate(data["steps"]):
            step = _subst(raw_step, env)
            assert isinstance(step, dict)
            command = next(key for key in FLOW_COMMANDS if key in step)
            step_id = str(step.get("id") or f"{command}-{index}")
            record: dict[str, object] = {
                "id": step_id,
                "command": command,
                "duration_ms": 0,
                "skipped": False,
                "stopped": False,
                "message": "",
                "values": {},
                "artifacts": [],
            }
            assert isinstance(flow_record["steps"], list)
            flow_record["steps"].append(record)
            step_started = time.monotonic()
            try:
                if "when" in step:
                    when = step["when"]
                    assert isinstance(when, dict)
                    op = next(name for name in WHEN_OPS if name in when)
                    if not _when(env.get(str(when["var"])), op, when[op]):
                        record["skipped"] = True
                        record["message"] = "when"
                        continue
                _drive_step(serial, command, step, env, string_table, config, flow_dir, record, timeout_default, poll)
            except (DriveStop, SystemExit, OSError, subprocess.SubprocessError) as exc:
                record["stopped"] = True
                record["message"] = str(exc)
                flow_record["stopped"] = True
                run_record["stopped"] = True
                run_record["reason"] = str(exc)
                code = 1
                _stop_artifacts(serial, flow_dir, step_id, record)
                break
            finally:
                record["duration_ms"] = int((time.monotonic() - step_started) * 1000)
        flow_record["duration_ms"] = int((time.monotonic() - flow_started) * 1000)
        if code:
            break
    run_record["end"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    _write_flow_report(run_dir, run_record)
    print(f"report {run_dir / 'report.json'}", flush=True)
    return code


def _when(left: object, op: str, right: object) -> bool:
    left_num = _number(left)
    right_num = _number(right)
    if left_num is not None and right_num is not None:
        left_cmp: object = left_num
        right_cmp: object = right_num
    else:
        left_cmp = "" if left is None else str(left)
        right_cmp = "" if right is None else str(right)
    if op == "eq":
        return left_cmp == right_cmp
    if op == "ne":
        return left_cmp != right_cmp
    if op == "gt":
        return left_cmp > right_cmp
    if op == "lt":
        return left_cmp < right_cmp
    if op == "ge":
        return left_cmp >= right_cmp
    return left_cmp <= right_cmp


def _number(value: object) -> float | None:
    if isinstance(value, bool) or value is None:
        return None
    if isinstance(value, (int, float)):
        return float(value)
    try:
        return float(str(value))
    except ValueError:
        return None


def _drive_step(
    serial: str,
    command: str,
    step: dict,
    env: dict[str, object],
    strings: dict[str, str],
    config: dict,
    flow_dir: Path,
    record: dict[str, object],
    timeout_default: float,
    poll: float,
) -> None:
    timeout = float(step.get("timeout_s", timeout_default))
    optional = bool(step.get("optional"))
    if command == "wait":
        time.sleep(float(step["wait"]))
        return
    if command == "note":
        record["message"] = str(step["note"])
        return
    if command == "home":
        _key(serial, "3")
        return
    if command == "back":
        for _ in range(int(step["back"])):
            _key(serial, "4")
        return
    if command == "rotate":
        _sh(serial, "settings put system accelerometer_rotation 0", check=False)
        _sh(serial, f"settings put system user_rotation {ROTATIONS[str(step['rotate'])]}", check=False)
        return
    if command == "launch":
        activity = str(config.get("activity") or "")
        result = _run(serial, "shell", "am", "start", "-n", activity, check=False)
        if result.returncode != 0:
            raise DriveStop(result.stderr.strip() or "am start failed")
        return
    if command == "swipe":
        body = step["swipe"]
        if body in ("page", "fling"):
            _swipe_kind(serial, str(body))
            return
        size = _screen_size(serial)
        if size is None:
            raise DriveStop("screen size is unavailable")
        width, height = size
        x1 = int(float(body["from"][0]) * width)
        y1 = int(float(body["from"][1]) * height)
        x2 = int(float(body["to"][0]) * width)
        y2 = int(float(body["to"][1]) * height)
        ms = str(int(body.get("ms") or 300))
        if _run(serial, "shell", "input", "swipe", str(x1), str(y1), str(x2), str(y2), ms, check=False).returncode != 0:
            raise DriveStop("swipe failed")
        return
    if command == "screenshot":
        spec = step["screenshot"]
        filename = spec if isinstance(spec, str) else str(spec["file"])
        dest = flow_dir / "shots" / filename
        _screencap(serial, dest)
        assert isinstance(record["artifacts"], list)
        record["artifacts"].append(str(dest))
        if isinstance(spec, dict):
            root = _dump(serial)
            values: dict[str, str] = {}
            for entry in spec.get("report") or []:
                found = _find_selector(root, entry["selector"], strings)
                values[str(entry["name"])] = (found[0].attrib.get("text") or "") if found else ""
            record["values"] = values
        return
    if command == "read_text":
        root = _dump(serial)
        found = _find_selector(root, step["read_text"], strings)
        text = (found[0].attrib.get("text") or "") if found else ""
        record["values"] = {"text": text}
        record["message"] = "" if found else "absent"
        if isinstance(step.get("save_as"), str):
            env[str(step["save_as"])] = text
        return
    selector = step[command] if command != "type" else step["type"]["into"]
    scroll = step.get("scroll") if command == "tap" else None
    node = _await_node(serial, selector, strings, timeout, poll, str(scroll) if scroll else None, command != "wait_gone")
    if command == "wait_gone":
        if node is not None and not optional:
            raise DriveStop("still present")
        if node is not None:
            record["message"] = "still present"
        return
    if command == "wait_for":
        if node is None and not optional:
            raise DriveStop("not found")
        if node is None:
            record["message"] = "absent"
        return
    if node is None:
        if optional:
            record["message"] = "absent"
            return
        raise DriveStop("not found")
    center = _center(node)
    if center is None:
        raise DriveStop("node has no bounds")
    if command == "tap":
        _sh(serial, f"input tap {center[0]} {center[1]}")
        return
    if command == "long_press":
        x, y = center
        if _run(serial, "shell", "input", "swipe", str(x), str(y), str(x), str(y), "800", check=False).returncode != 0:
            raise DriveStop("long_press failed")
        return
    text = str(step["type"]["text"])
    _sh(serial, f"input tap {center[0]} {center[1]}")
    if step["type"].get("clear"):
        current = node.attrib.get("text") or ""
        _key(serial, "123")
        for _ in range(min(max(len(current), 1), 300)):
            _key(serial, "67")
    encoded = text.replace("%", "%25").replace(" ", "%s")
    if _run(serial, "shell", "input", "text", encoded, check=False).returncode != 0:
        raise DriveStop("input text failed")


def _key(serial: str, code: str) -> None:
    if _run(serial, "shell", "input", "keyevent", code, check=False).returncode != 0:
        raise DriveStop(f"keyevent {code} failed")


def _stop_artifacts(serial: str, flow_dir: Path, step_id: str, record: dict[str, object]) -> None:
    safe = re.sub(r"[^A-Za-z0-9_.-]+", "_", step_id).strip("._") or "step"
    try:
        dest = flow_dir / "shots" / f"{safe}-stop.png"
        _screencap(serial, dest)
        assert isinstance(record["artifacts"], list)
        record["artifacts"].append(str(dest))
    except (DriveStop, subprocess.SubprocessError, OSError):
        pass
    try:
        xml = _sh(serial, "cat /sdcard/ui.xml", check=False)
        path = flow_dir / "ui" / f"{safe}.xml"
        path.write_text(xml, encoding="utf-8")
        assert isinstance(record["artifacts"], list)
        record["artifacts"].append(str(path))
    except OSError:
        pass


def _write_flow_report(run_dir: Path, run_record: dict[str, object]) -> None:
    path = run_dir / "report.json"
    if path.is_file():
        try:
            existing = json.loads(path.read_text(encoding="utf-8"))
        except json.JSONDecodeError as exc:
            raise SystemExit(f"ERROR: {path} is not valid JSON ({exc})")
        runs = existing.get("runs") if isinstance(existing, dict) else None
        if not isinstance(runs, list):
            raise SystemExit(f"ERROR: {path} has no runs list")
    else:
        runs = []
    runs.append(run_record)
    path.write_text(json.dumps({"runs": runs}, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    lines = []
    flows = run_record["flows"]
    assert isinstance(flows, list)
    for flow in flows:
        lines.append(f"{flow['name']} duration_ms={flow['duration_ms']} stopped={str(flow['stopped']).lower()}")
        for step in flow["steps"]:
            if step["skipped"] or step["stopped"] or step["message"] or step["values"]:
                lines.append(f"  {step['id']} {step['command']} {step['message']}".rstrip())
    text_path = run_dir / "report.txt"
    previous = text_path.read_text(encoding="utf-8") if text_path.is_file() else ""
    text_path.write_text(previous + "\n".join(lines) + "\n", encoding="utf-8")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", default="manual-capture.yaml")
    parser.add_argument("--root", default=".")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--form", choices=["phone", "tablet"])
    parser.add_argument("--serial", action="append", dest="serials")
    parser.add_argument("--locales", default=None)
    parser.add_argument("--shots", default=None)
    parser.add_argument("--replace", action="store_true")
    parser.add_argument("--flow", action="append", dest="flows")
    parser.add_argument("--var", action="append", dest="variables")
    parser.add_argument("--run-dir", default=None)
    args = parser.parse_args(argv)
    if args.flows:
        return _flow_main(args)
    serials = list(args.serials or [])
    if not args.check and len(serials) != 1:
        print(
            "ERROR: pass one --serial. Two devices: ./capture-manual-screenshots",
            file=sys.stderr,
        )
        return 1
    root = Path(args.root).resolve()
    app = App(root, _load_yaml(root / args.config))
    if args.check:
        app.check()
        return 0
    selected = _selected(app, args.shots)
    spec = args.locales if args.locales is not None else "en"
    if spec.strip() == "all":
        locales = app.locales
    else:
        locales = []
        for tag in [part.strip() for part in spec.split(",") if part.strip()]:
            locale = app.by_pref.get(tag)
            if locale is None:
                _die(f"unknown pref tag {tag!r}")
            locales.append(locale)
    for locale in locales:
        app.strings(locale.pref)
    devices = subprocess.run(["adb", "devices"], capture_output=True, text=True).stdout
    for serial in serials:
        if serial not in devices:
            print(f"ERROR: {serial} not in adb devices", file=sys.stderr)
            return 1
    assigned = _assign(app, serials, args.form)
    if assigned is None:
        return 1
    serial, form = assigned[0]
    return 1 if _run_device(app, serial, form, locales, selected, args.replace) else 0


if __name__ == "__main__":
    raise SystemExit(main())
