# rules.manifest: the shared rule set. It is byte-identical on every host and
# published by ./deploy-orchestration (which also lists itself here).
# Format: <class> <path or glob>   (globs match tracked paths; ** spans dirs)
#   law      agents read or follow it (`./deploy-orchestration --list law`); created if missing
#   shared   tooling; created if missing
#   opt      updated only where the target already has it
#   root     tooling for the orchestration root only; never published into worktrees
#   replace  overwritten even if the host changed it (its host specifics moved to rules.manifest.local)
#   retired  removed from targets (kept, with a warning, if the target's copy is not from our history)
#   purge    removed from every target wherever tracked
# Project-specific infra lives in that project root's rules.manifest.local (class local): the
# root's version goes to all its worktrees, except a file a worktree modified itself.

law AGENTS.md
law GEMINI.md
law CLAUDE.md
law GROK.md
law ANTIGRAVITY.md
law AGENT_MANDATES.md
law new_agent_prompt
law standard-plan-compliance-block.md
law roles/*.md
law docs/rules/*.md
law docs/facts/translations.md
law .grok/skills/*/SKILL.md
law .cursor/skills/*/SKILL.md

shared rules.manifest
shared deploy-orchestration
replace update-rules.sh
shared roles.config
shared .grok/config.toml
shared .grok/hooks/rules-hooks.json
shared .grok/hooks/rules-hooks.sh
shared .grok/hooks/cmd-words.py
shared .grok/roles/*.toml
shared .grok/agents/*.md
shared .grok/lib/grok-launch-common.sh
shared run-grok
shared run-grok-coder
shared run-grok-master
shared run-grok-orchestrator
shared run-grok-planner
shared run-cursor
shared run-cursor-coder
shared run-cursor-master
shared run-cursor-orchestrator
shared run-cursor-planner
shared .cursor/lib/*
shared .cursor/hooks.json
shared .cursor/cli.json
shared exec-preflight
shared append-to-engineering-log
shared todo-append
shared todo-close
shared move-work-history.sh
shared get-builds-tag.sh
shared reset-to-builds.sh
shared prepare-pr-rewrite
shared plans-scope
shared todo-open
shared englog-recent
shared install-merge-drivers.sh
shared merge-branch-into-master.sh
shared git-merge-drivers/*
root setup_agent.sh
root remove_worktree.sh
shared fix-perms
shared perm-lib.sh
shared perm-model.tsv
shared perm-engine.py
shared filter-apply-config
shared filter-clean-config
shared verify-smudge
shared hooks/post-checkout
shared MULTI_AGENT_USER_INSTRUCTIONS.md
shared README-multi-agent.md
shared tools/upgrade-scan
shared tools/upgrade-probe
shared tools/upgrade-map.tsv
shared probes/README.md
shared probes/general/*.md
shared probes/protected/*.md
shared probes/protected/COUNT

# Connector pin: docs/rules/channel.md and the /channel skills run artifact/channel-*, so the pin
# travels with them in the same per-tree commit (the library checkout is never needed).
# fetch-deps travels with the pins it reads. get-artifacts and libpin-* are not shared: some trees
# carry their own older get-artifacts history (it would make deploy skip the whole tree).
shared third_party/fetch-deps
shared third_party/agent-coordination-tickets/libpin.toml
shared third_party/agent-coordination-tickets/SOURCE.md
shared third_party/agent-coordination-tickets/artifact/*

opt run-antigravity
opt run-antigravity-master
opt run-antigravity-planner
opt agent-landlock
opt landlock.config
opt landlock.config.example
opt landlock-smoke-matrix
opt landlock-write-probe
opt .gemini/system.md
opt .gemini/system_prompt.md

retired MASTER_AGENT_MANDATE.md
purge new_grok_agent_prompt
purge sync_infrastructure.sh
purge fix-android-sdk-perms
purge sync-debug-keystores
purge set-worktree-perms
purge run-grok-imagine
purge roles/imagine.md
purge .grok/prompts/packs/imagine.pack
purge .grok/prompts/role-imagine.md
retired .grok/prompts/**
retired .grok/hooks/plan-mode-hard-stops.js
retired .grok/hooks/stop-completeness-gate.json
retired .grok/hooks/stop-completeness-gate.sh
