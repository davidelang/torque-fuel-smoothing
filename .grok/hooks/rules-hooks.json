{
  "hooks": {
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "bash \"${GROK_PROMPT_ROOT:-.}/.grok/hooks/rules-hooks.sh\" pretool", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "bash \"${GROK_PROMPT_ROOT:-.}/.grok/hooks/rules-hooks.sh\" stop", "timeout": 10 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "bash \"${GROK_PROMPT_ROOT:-.}/.grok/hooks/rules-hooks.sh\" stop", "timeout": 10 } ] }
    ]
  }
}
